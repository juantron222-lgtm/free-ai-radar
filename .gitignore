# build output
dist/
.vercel/
.astro/

# dependencies
node_modules/

# local data + secrets
.env
.env.*
!.env.example
.data/

# Borrador local de credenciales. Es un cuaderno para pegar claves mientras se
# consiguen, antes de que tengan sitio definitivo en .env.local o en Vercel.
# El patrón cubre cualquier fichero *.local.txt para que un segundo cuaderno
# nazca ya ignorado en lugar de depender de que alguien se acuerde.
*.local.txt

# test artifacts
coverage/
playwright-report/
test-results/

# NOTE: src/data/generated/ IS committed on purpose. It is the deterministic
# output of `npm run data:migrate` and doubles as the local-mode dataset, so
# content changes show up as reviewable diffs in pull requests.

# editor / os
.DS_Store
Thumbs.db
*.log
npm-debug.log*
docs/evidence/*.err
