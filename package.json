{
  "name": "free-ai-radar",
  "version": "2.0.0",
  "description": "Radar independiente de herramientas de IA gratuitas: qué es gratis de verdad, con qué límites y a qué coste real.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "typecheck": "astro check --minimumSeverity error",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,js,mjs,astro,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,js,mjs,astro,json,md,css}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build",
    "data:migrate": "node scripts/migrate-tools.mjs",
    "data:migrate:dry": "node scripts/migrate-tools.mjs --dry-run",
    "links:check": "node scripts/check-links.mjs",
    "icons": "node scripts/generate-icons.js",
    "news:radar": "node scripts/news-radar.mjs",
    "news:radar:dry": "node scripts/news-radar.mjs --dry-run",
    "news:triage": "node scripts/news-triage.mjs",
    "news:triage:dry": "node scripts/news-triage.mjs --dry-run",
    "news:triage:explain": "node scripts/news-triage.mjs --explain=",
    "data:news:validate": "vitest run tests/unit/news.test.ts tests/unit/inbox.test.ts tests/unit/triage.test.ts tests/unit/verification.test.ts tests/unit/drafts.test.ts tests/unit/newsroom.test.ts tests/unit/newsroom-rls.test.ts tests/unit/newsroom-trigger.test.ts",
    "rls:test": "node scripts/rls-harness.mjs",
    "rls:test:broken": "node scripts/rls-harness.mjs --no-hardening",
    "rls:staging": "node scripts/staging-run.mjs --suite",
    "db:migrate:staging": "node scripts/staging-run.mjs --migrate",
    "staging:guard": "node scripts/staging-guard.mjs",
    "staging:guard:connect": "node scripts/staging-guard.mjs --connect",
    "staging:verify": "node scripts/staging-run.mjs --verify",
    "db:reset:staging": "node scripts/staging-run.mjs --reset --migrate",
    "http:staging": "node scripts/http-suite.mjs",
    "autocraw:credential": "node scripts/autocraw-credential.mjs",
    "autocraw:staging": "node scripts/autocraw-suite.mjs",
    "db:sync:staging": "node scripts/staging-run.mjs --sync-catalog",
    "db:check:staging": "node scripts/staging-run.mjs --check-catalog",
    "rc": "node scripts/release-candidate.mjs",
    "data:catalog-sql": "node scripts/emit-catalog-sql.mjs",
    "a11y:contraste": "node scripts/contraste.mjs",
    "news:coverage": "node scripts/news-coverage.mjs",
    "prebuild": "node scripts/newsroom-sync.mjs"
  },
  "dependencies": {
    "@astrojs/vercel": "^11.0.4",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.111.0",
    "@vercel/analytics": "^2.0.1",
    "astro": "^7.1.6",
    "resend": "^4.8.0",
    "sharp": "^0.35.3",
    "stripe": "^17.7.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@electric-sql/pglite": "^0.5.4",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "astro-eslint-parser": "^1.4.0",
    "eslint": "^9.39.5",
    "eslint-plugin-astro": "^1.7.0",
    "globals": "^15.15.0",
    "postgres": "^3.4.9",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
