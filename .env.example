####################################################################
# Free AI Radar — plantilla de variables de entorno
#
# Copia este fichero a `.env` y rellena lo que necesites.
#
#   cp .env.example .env
#
# NADA es obligatorio para arrancar. Sin ninguna variable, el proyecto
# funciona en modo local:
#   · autenticación con el almacén de desarrollo (.data/dev-users.json)
#   · correos registrados en consola en vez de enviados
#   · pagos con un flujo simulado que no cobra nada
#   · datos de usuario en ficheros JSON bajo .data/
#
# `.env` está en .gitignore. NUNCA commitees credenciales reales.
####################################################################


# ─────────────────────────────────────────────────────────────────
# SITIO
# ─────────────────────────────────────────────────────────────────

# Origen canónico. Determina canonicals, sitemap, robots, OG y los
# enlaces de los correos. En local usa http://localhost:4321.
PUBLIC_SITE_URL="https://www.freeairadar.com"


# ─────────────────────────────────────────────────────────────────
# SUPABASE — base de datos y autenticación
#
# Sin estas variables el proyecto usa el modo local de desarrollo.
# En producción son OBLIGATORIAS: sin ellas las cuentas se desactivan.
#
# Dónde: panel de Supabase → Project Settings → API
# ─────────────────────────────────────────────────────────────────

PUBLIC_SUPABASE_URL=""
PUBLIC_SUPABASE_ANON_KEY=""

# Clave de servicio: SALTA las políticas RLS. Sólo servidor.
# Si esta clave se filtra, toda la base queda expuesta.
SUPABASE_SERVICE_ROLE_KEY=""

# ── STAGING ──────────────────────────────────────────────────────
#
# Las tres variables siguientes las exige `scripts/staging-guard.mjs` antes de
# dejar que nada se conecte. Se piden tres porque una sola equivocación no debe
# bastar: quien pegue la cadena que no era, no cambiará además las otras dos.

# Cadena de conexión directa, SÓLO de staging.
#
# La usan `npm run db:migrate:staging` y `npm run rls:staging`. La segunda
# ejecuta la suite adversarial, que intenta escalar privilegios a propósito:
# poner aquí la cadena de producción sería dispararse a uno mismo.
#
# Dónde: panel de Supabase → Project Settings → Database → Connection string
SUPABASE_DB_URL_STAGING=""

# Intención declarada. Debe valer exactamente "staging" o el guardián se niega.
SUPABASE_ENV=""

# IDENTIDAD POSITIVA: la referencia del único proyecto contra el que se permite
# trabajar. Es la que aparece en https://<ref>.supabase.co
#
# El guardián exige que coincida a la vez con la de la cadena de conexión y con
# la de PUBLIC_SUPABASE_URL. Las demás comprobaciones son negativas —«no es
# producción», «no pone prod»— y una comprobación negativa sólo atrapa lo que
# alguien previó. Nombrar el proyecto permitido atrapa todos los demás,
# incluidos los que nadie imaginó.
#
# Debe escribirla una persona. Derivarla de la propia cadena que se quiere
# comprobar haría la comprobación circular y, por tanto, inútil.
SUPABASE_STAGING_REF=""

# Referencias de proyecto que NUNCA deben tocarse, separadas por comas.
# Es la referencia que aparece en https://<ref>.supabase.co
# Sin esto, la comprobación contra producción no puede hacer nada.
SUPABASE_PRODUCTION_REFS=""


# ─────────────────────────────────────────────────────────────────
# STRIPE — suscripciones (MODO TEST)
#
# El código LANZA UN ERROR si detecta una clave sk_live_ fuera de
# producción. Es intencionado.
#
# Dónde: dashboard.stripe.com → Developers → API keys (modo test)
# ─────────────────────────────────────────────────────────────────

# Debe empezar por sk_test_ en cualquier entorno que no sea producción.
STRIPE_SECRET_KEY=""

# Firma de webhook. En local:
#   stripe listen --forward-to localhost:4321/api/billing/webhook
STRIPE_WEBHOOK_SECRET=""

# Identificadores de precio (price_..., NO product_...).
# Los importes que se muestran viven en src/lib/billing/plans.ts.
STRIPE_PRICE_PRO_MONTHLY=""
STRIPE_PRICE_PRO_YEARLY=""


# ─────────────────────────────────────────────────────────────────
# RESEND — correo transaccional y boletín
#
# Sin API key los correos se renderizan y se registran (con el
# destinatario hasheado) pero no se envían.
#
# Dónde: resend.com → API Keys
# ─────────────────────────────────────────────────────────────────

RESEND_API_KEY=""

# Remitente verificado en Resend.
EMAIL_FROM="Free AI Radar <hola@freeairadar.com>"

# Ponlo a 1 para forzar simulación aunque haya API key.
# Recomendado en cualquier entorno que no sea producción.
EMAIL_DRY_RUN="1"


# ─────────────────────────────────────────────────────────────────
# SEGURIDAD
# ─────────────────────────────────────────────────────────────────

# Firma cookies CSRF y tokens del modo local.
# Genera uno con:  openssl rand -base64 48
AUTH_SECRET=""

# Correos que reciben rol de administrador al registrarse.
# Separados por comas. Es el mecanismo de arranque del primer admin;
# después los roles se gestionan en la tabla `profiles`.
ADMIN_EMAILS=""

# Cloudflare Turnstile (anti-abuso en formularios públicos).
# Sin configurar, sólo actúan el honeypot y el rate limiting.
# Dónde: dash.cloudflare.com → Turnstile
PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""


# ─────────────────────────────────────────────────────────────────
# ANALÍTICA Y PUBLICIDAD
#
# Nada de esto se carga sin el consentimiento correspondiente.
# ─────────────────────────────────────────────────────────────────

# Dominio del proveedor de analítica compatible con consentimiento.
PUBLIC_ANALYTICS_DOMAIN=""

# Cliente de AdSense (ca-pub-XXXXXXXXXXXXXXXX).
# Sólo se activa tras aceptar cookies publicitarias.
PUBLIC_ADSENSE_CLIENT=""


# ─────────────────────────────────────────────────────────────────
# PRUEBAS
# ─────────────────────────────────────────────────────────────────

# URL contra la que corre Playwright. Si se define, no arranca el
# servidor de desarrollo por su cuenta.
# E2E_BASE_URL=""
# E2E_PORT="4321"


# ─────────────────────────────────────────────────────────────────
# AMAZON AFILIADOS — sin conectar
#
# Ninguna de estas variables tiene valor todavía, y hay una prueba que
# comprueba que sigue siendo así. Ver docs/amazon-affiliates-staging.md.
#
# AMAZON_DISCLOSURE_TEXT hay que copiarlo LITERAL del panel de Afiliados.
# No lo escribas de memoria: una declaración legal equivocada es peor que
# una ausente, porque aparenta cumplimiento.
# ─────────────────────────────────────────────────────────────────

AMAZON_ASSOCIATE_TAG=""
AMAZON_MARKET=""
AMAZON_DISCLOSURE_TEXT=""

# Creators API, no PA-API 5.0: Amazon ha deprecado la segunda.
AMAZON_CREATORS_CLIENT_ID=""
AMAZON_CREATORS_CLIENT_SECRET=""

# Cuota conocida, para corregirla sin desplegar cuando Amazon la ajuste.
# Los límites iniciales (1 TPS, 8640/día) valen para los primeros 30 días y
# nada después: dependen del rendimiento de la cuenta. Sin este valor se usa
# la cifra inicial, marcada como provisional, que caduca a los 30 días.
# {"maxTps":1,"maxTpd":8640,"recordedAt":"2026-08-08T00:00:00.000Z","source":"...","provisional":true}
AMAZON_QUOTA_JSON=""


# ─────────────────────────────────────────────────────────────────
# AUTOCRAW — credencial de base de datos de staging
#
# NO se pone a mano. La emite `npm run autocraw:credential`, que genera la
# contraseña, la aplica al rol y la escribe en .env.local sin imprimirla.
# `--revoke` devuelve el rol a NOLOGIN.
# ─────────────────────────────────────────────────────────────────

AUTOCRAW_DB_URL_STAGING=""


# ─────────────────────────────────────────────────────────────────
# ENTORNO DE DESPLIEGUE
#
# Qué entorno es este, DECLARADO. No se deduce de la URL, ni de la rama,
# ni del modo de compilación: un Preview de Vercel compila exactamente
# como producción, así que `import.meta.env.PROD` no distingue uno de otra.
#
# Vercel pone VERCEL_ENV automáticamente (production | preview | development).
# DEPLOYMENT_ENV es nuestra y tiene prioridad, para hosts que no sean Vercel.
#
# Valores admitidos: development · preview · staging · production
# Cualquier otro valor, o ninguno, cuenta como "unknown" y falla cerrado.
#
# Una clave live de Stripe SÓLO se acepta con "production". En cualquier
# otro entorno el sistema se niega a arrancarla.
# ─────────────────────────────────────────────────────────────────

DEPLOYMENT_ENV=""
