---
import BaseLayout from '@layouts/BaseLayout.astro';
import { getAllTools, getPopulatedCategories } from '@lib/data/catalog';
import { ROUTES } from '@lib/nav';

const popular = [...getAllTools()]
  .sort((a, b) => b.lastVerifiedAt.localeCompare(a.lastVerifiedAt) || a.name.localeCompare(b.name, 'es'))
  .slice(0, 5);
const categories = getPopulatedCategories().slice(0, 6);
---

<BaseLayout
  title="Página no encontrada"
  description="La página que buscas no existe o ha cambiado de dirección."
  noindex
>
  <div class="page notfound">
    <p class="eyebrow">Error 404</p>
    <h1 class="notfound-title">Aquí no hay nada</h1>
    <p class="notfound-lede">
      Esta dirección no existe o ha cambiado. Si has llegado desde un enlace nuestro,
      <a href={ROUTES.contact}>avísanos</a> y lo arreglamos.
    </p>

    <form action={ROUTES.tools} method="get" class="notfound-search" role="search">
      <label class="sr-only" for="nf-q">Buscar en el catálogo</label>
      <input type="search" id="nf-q" name="q" class="input" placeholder="Buscar una herramienta…" />
      <button type="submit" class="btn btn-primary">Buscar</button>
    </form>

    <div class="notfound-cols">
      <section aria-labelledby="nf-popular">
        <h2 id="nf-popular" class="notfound-h2">Comprobadas hace menos</h2>
        <ul>
          {popular.map((tool) => (
            <li>
              <a href={ROUTES.tool(tool.slug)}>{tool.name}</a>
            </li>
          ))}
        </ul>
      </section>

      <section aria-labelledby="nf-cats">
        <h2 id="nf-cats" class="notfound-h2">Por categoría</h2>
        <ul>
          {categories.map((category) => (
            <li>
              <a href={ROUTES.category(category.slug)}>{category.name}</a>
              <span class="tnum">{category.count}</span>
            </li>
          ))}
        </ul>
      </section>
    </div>

    {/* The widest way out. Search assumes you know what you are looking for
        and the lists above are a selection; someone who wants to browse
        everything should not have to go back to the menu for it. */}
    <p class="notfound-all">
      <a class="btn btn-secondary" href={ROUTES.tools}>Ver el catálogo completo</a>
    </p>
  </div>
</BaseLayout>

<style>
  .notfound-all {
    margin-block-start: var(--space-l);
  }

  .notfound {
    padding-block: var(--space-2xl) var(--space-xl);
    max-width: 46rem;
  }

  .notfound-title {
    font-size: clamp(2rem, 1.6rem + 2vw, 3rem);
    margin-block: 0.35rem var(--space-2xs);
  }

  .notfound-lede {
    margin: 0 0 var(--space-m);
    color: var(--ink-muted);
    font-size: 1.0625rem;
  }

  .notfound-lede a {
    color: var(--signal);
  }

  .notfound-search {
    display: flex;
    gap: var(--space-2xs);
    max-width: 30rem;
    margin-block-end: var(--space-l);
  }

  .notfound-cols {
    display: grid;
    gap: var(--space-m);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
  }

  .notfound-h2 {
    font-size: 0.9375rem;
    margin-block-end: var(--space-2xs);
    padding-block-end: 0.3rem;
    border-block-end: 1px solid var(--line);
  }

  .notfound-cols ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .notfound-cols li {
    display: flex;
    justify-content: space-between;
    gap: var(--space-2xs);
    padding-block: 0.4rem;
    border-block-end: 1px solid var(--line-hairline);
    font-size: 0.9375rem;
  }

  .notfound-cols a {
    color: var(--ink);
    text-decoration: none;
    font-weight: 550;
  }

  .notfound-cols a:hover {
    text-decoration: underline;
  }

  .notfound-cols span {
    color: var(--ink-subtle);
    font-size: 0.8125rem;
  }
</style>
