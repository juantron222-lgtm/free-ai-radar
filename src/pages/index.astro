---
import BaseLayout from '@layouts/BaseLayout.astro';
import ToolCard from '@components/tools/ToolCard.astro';
import CompareTray from '@components/tools/CompareTray.astro';
import NewsletterForm from '@components/marketing/NewsletterForm.astro';
import {
  getAllTools,
  getCatalogStats,
  getCatalogChanges,
  getPopulatedCategories,
  getRecentlyAdded,
} from '@lib/data/catalog';
import { itemListSchema } from '@lib/seo/structured-data';
import { ROUTES } from '@lib/nav';

const stats = getCatalogStats();
const categories = getPopulatedCategories().slice(0, 8);
const topTools = getAllTools().slice(0, 6);
const recent = getRecentlyAdded(4);
const changes = getCatalogChanges(4);

const noCardPicks = getAllTools()
  .filter((t) => t.freePlan.requiresCreditCard === 'no' && t.freePlan.commercialUse === 'yes')
  .slice(0, 4);

const description =
  'Verificamos herramientas de IA una por una: qué es gratis de verdad, con qué límites, si piden tarjeta, si dejan marca de agua y si permiten uso comercial. Sin humo publicitario.';
---

<BaseLayout
  title="Free AI Radar — IA gratis, verificada de verdad"
  description={description}
  schemas={[itemListSchema(topTools, 'Herramientas de IA gratuitas mejor valoradas')]}
>
  <section class="hero">
    <div class="page hero-inner">
      <p class="eyebrow hero-eyebrow">
        <span class="hero-pulse" aria-hidden="true"></span>
        Radar editorial independiente · actualizado el
        <time datetime={stats.lastVerifiedAt}>
          {new Date(`${stats.lastVerifiedAt}T00:00:00Z`).toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' })}
        </time>
      </p>

      <h1 class="hero-title">
        La IA que es <span class="hero-accent">gratis de verdad</span>,<br class="hero-break" />
        separada del humo.
      </h1>

      <p class="hero-lede">
        Probamos cada herramienta y publicamos lo incómodo: el límite real del plan gratuito, si
        te van a pedir la tarjeta, si te dejan marca de agua y si puedes usar el resultado para
        trabajar. Sin puntuaciones compradas.
      </p>

      <form class="hero-search" action={ROUTES.tools} method="get" role="search">
        <label class="sr-only" for="hero-q">¿Qué necesitas hacer?</label>
        <input
          type="search"
          id="hero-q"
          name="q"
          class="input"
          placeholder="Quitar fondo, transcribir audio, generar vídeo…"
          autocomplete="off"
        />
        <button type="submit" class="btn btn-primary">Buscar</button>
      </form>

      <ul class="hero-shortcuts">
        <li><a href={`${ROUTES.tools}?nocard=1`}>Sin pedir tarjeta</a></li>
        <li><a href={`${ROUTES.tools}?comm=1`}>Con uso comercial</a></li>
        <li><a href={`${ROUTES.tools}?oss=1`}>Open source</a></li>
        <li><a href={`${ROUTES.tools}?host=local`}>Funciona en local</a></li>
        <li><a href={`${ROUTES.tools}?nowm=1`}>Sin marca de agua</a></li>
      </ul>

      <dl class="hero-stats">
        <div><dt>Herramientas verificadas</dt><dd class="tnum">{stats.total}</dd></div>
        <div><dt>Sin tarjeta</dt><dd class="tnum">{stats.noCard}</dd></div>
        <div><dt>Uso comercial</dt><dd class="tnum">{stats.commercialUse}</dd></div>
        <div><dt>Open source</dt><dd class="tnum">{stats.openSource}</dd></div>
      </dl>
    </div>
  </section>

  <div class="page home-sections">
    <section aria-labelledby="top-title">
      <header class="section-head">
        <div>
          <p class="eyebrow">Mejor valoradas</p>
          <h2 id="top-title" class="section-title">Las que compensan de verdad</h2>
        </div>
        <a href={ROUTES.tools} class="btn btn-ghost btn-sm">Ver las {stats.total} →</a>
      </header>
      <ul class="grid-cards card-list">
        {topTools.map((tool) => (
          <li><ToolCard tool={tool} /></li>
        ))}
      </ul>
    </section>

    <section aria-labelledby="cat-title">
      <header class="section-head">
        <div>
          <p class="eyebrow">Por tipo de trabajo</p>
          <h2 id="cat-title" class="section-title">Empieza por lo que necesitas hacer</h2>
        </div>
        <a href={ROUTES.categories} class="btn btn-ghost btn-sm">Todas las categorías →</a>
      </header>
      <ul class="category-grid">
        {categories.map((cat) => (
          <li>
            <a href={ROUTES.category(cat.slug)} class="card card-interactive category-card">
              <span class="category-name">{cat.name}</span>
              <span class="category-count tnum">{cat.count}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    {changes.length > 0 && (
      <section aria-labelledby="changes-title" class="changes-section">
        <header class="section-head">
          <div>
            <p class="eyebrow">Registro de cambios</p>
            <h2 id="changes-title" class="section-title">Qué ha cambiado últimamente</h2>
          </div>
          <a href={ROUTES.news} class="btn btn-ghost btn-sm">Historial completo →</a>
        </header>
        <ol class="change-list">
          {changes.map(({ tool, change }) => (
            <li class="change-item">
              <time datetime={change.date} class="change-date tnum">
                {new Date(`${change.date}T00:00:00Z`).toLocaleDateString('es-ES', { day: '2-digit', month: 'short', timeZone: 'UTC' })}
              </time>
              <div>
                <a href={ROUTES.tool(tool.slug)} class="change-tool">{tool.name}</a>
                <p class="change-summary">{change.summary}</p>
              </div>
            </li>
          ))}
        </ol>
      </section>
    )}

    <section aria-labelledby="nocard-title">
      <header class="section-head">
        <div>
          <p class="eyebrow">Colección</p>
          <h2 id="nocard-title" class="section-title">Sin tarjeta y con derecho a monetizar</h2>
        </div>
        <a href={`${ROUTES.tools}?nocard=1&comm=1`} class="btn btn-ghost btn-sm">Ver todas →</a>
      </header>
      <p class="section-lede">
        Las dos condiciones que más veces fallan a la vez. Estas cumplen ambas, verificadas.
      </p>
      <ul class="grid-cards card-list">
        {noCardPicks.map((tool) => (
          <li><ToolCard tool={tool} variant="compact" /></li>
        ))}
      </ul>
    </section>

    <section aria-labelledby="recent-title">
      <header class="section-head">
        <div>
          <p class="eyebrow">Nuevas en el radar</p>
          <h2 id="recent-title" class="section-title">Añadidas recientemente</h2>
        </div>
      </header>
      <ul class="grid-cards card-list">
        {recent.map((tool) => (
          <li><ToolCard tool={tool} variant="compact" /></li>
        ))}
      </ul>
    </section>

    <section class="promise" aria-labelledby="promise-title">
      <h2 id="promise-title" class="section-title">Cómo trabajamos</h2>
      <ul class="promise-list">
        <li>
          <h3>Verificamos, no copiamos</h3>
          <p>
            Cada dato del plan gratuito sale de la página oficial del fabricante, con enlace y
            fecha. Si no lo hemos confirmado, lo decimos: verás «sin verificar», nunca un «no»
            inventado.
          </p>
        </li>
        <li>
          <h3>La puntuación no se vende</h3>
          <p>
            Un patrocinio puede comprar visibilidad claramente etiquetada. No puede comprar ni un
            punto de la puntuación editorial, ni cambiar un veredicto.
            <a href={ROUTES.editorialPolicy}>Política editorial</a>.
          </p>
        </li>
        <li>
          <h3>La fórmula está publicada</h3>
          <p>
            Los cinco componentes, sus pesos y cada penalización están documentados y se muestran
            desglosados en cada ficha. <a href={ROUTES.methodology}>Ver metodología</a>.
          </p>
        </li>
        <li>
          <h3>Puedes corregirnos</h3>
          <p>
            Los planes gratuitos cambian sin avisar. Cada ficha tiene un botón para reportar que
            algo ya no es cierto, y lo revisamos.
          </p>
        </li>
      </ul>
    </section>

    <NewsletterForm />
  </div>

  <CompareTray />
</BaseLayout>

<style>
  .hero {
    border-block-end: 1px solid var(--line);
    background:
      linear-gradient(to bottom, var(--surface-sunken), transparent 70%);
    padding-block: var(--space-xl) var(--space-l);
  }

  .hero-inner {
    max-width: 62rem;
  }

  .hero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin: 0 0 var(--space-s);
  }

  .hero-pulse {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--signal);
    box-shadow: 0 0 0 0 color-mix(in srgb, var(--signal) 60%, transparent);
    animation: pulse 2.6s ease-out infinite;
  }

  @keyframes pulse {
    70% {
      box-shadow: 0 0 0 7px color-mix(in srgb, var(--signal) 0%, transparent);
    }
    100% {
      box-shadow: 0 0 0 0 color-mix(in srgb, var(--signal) 0%, transparent);
    }
  }

  .hero-title {
    font-size: clamp(2.1rem, 1.3rem + 3.8vw, 3.9rem);
    line-height: 1.03;
    letter-spacing: -0.033em;
    margin-block-end: var(--space-s);
  }

  .hero-accent {
    color: var(--signal);
  }

  .hero-break {
    display: none;
  }

  .hero-lede {
    max-width: 46rem;
    font-size: clamp(1rem, 0.95rem + 0.35vw, 1.1875rem);
    color: var(--ink-muted);
    margin-block-end: var(--space-m);
  }

  .hero-search {
    display: flex;
    gap: var(--space-2xs);
    max-width: 34rem;
    margin-block-end: var(--space-s);
  }

  .hero-search .input {
    min-height: 48px;
  }

  .hero-shortcuts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
    margin: 0 0 var(--space-l);
    padding: 0;
  }

  .hero-shortcuts a {
    display: inline-block;
    padding: 0.35rem 0.75rem;
    border-radius: var(--radius-full);
    border: 1px solid var(--line-strong);
    background: var(--surface);
    font-size: 0.8125rem;
    font-weight: 550;
    color: var(--ink-muted);
    text-decoration: none;
    min-height: 34px;
    line-height: 1.6;
  }

  .hero-shortcuts a:hover {
    border-color: var(--signal);
    color: var(--signal);
  }

  .hero-stats {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-s);
    margin: 0;
    padding-block-start: var(--space-s);
    border-block-start: 1px solid var(--line);
  }

  .hero-stats dt {
    font-size: 0.75rem;
    color: var(--ink-subtle);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 600;
  }

  .hero-stats dd {
    margin: 0.1rem 0 0;
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--ink-strong);
  }

  .home-sections {
    display: grid;
    gap: var(--space-2xl);
    padding-block: var(--space-xl);
  }

  .section-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-s);
    margin-block-end: var(--space-s);
    padding-block-end: var(--space-2xs);
    border-block-end: 1px solid var(--line);
  }

  .section-title {
    font-size: clamp(1.35rem, 1.15rem + 0.9vw, 1.85rem);
    margin: 0.15rem 0 0;
  }

  .section-lede {
    margin: calc(-1 * var(--space-3xs)) 0 var(--space-s);
    color: var(--ink-muted);
    font-size: 0.9375rem;
    max-width: 50ch;
  }

  .card-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .card-list > li {
    display: flex;
  }

  .card-list > li > :global(*) {
    width: 100%;
  }

  .category-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 11rem), 1fr));
    gap: var(--space-2xs);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .category-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2xs);
    padding: var(--space-xs) var(--space-s);
    text-decoration: none;
    min-height: 56px;
  }

  .category-name {
    font-weight: 600;
    color: var(--ink-strong);
  }

  .category-count {
    font-size: 0.8125rem;
    color: var(--ink-subtle);
    font-weight: 600;
  }

  .change-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0;
  }

  .change-item {
    display: grid;
    grid-template-columns: 4.5rem 1fr;
    gap: var(--space-s);
    padding-block: var(--space-xs);
    border-block-end: 1px solid var(--line-hairline);
  }

  .change-item:last-child {
    border-block-end: 0;
  }

  .change-date {
    font-size: 0.75rem;
    color: var(--ink-subtle);
    font-weight: 600;
    padding-block-start: 0.15rem;
  }

  .change-tool {
    font-weight: 650;
    color: var(--ink-strong);
    text-decoration: none;
  }

  .change-tool:hover {
    text-decoration: underline;
  }

  .change-summary {
    margin: 0.1rem 0 0;
    font-size: 0.875rem;
    color: var(--ink-muted);
  }

  .promise-list {
    display: grid;
    gap: var(--space-m);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
    list-style: none;
    margin: var(--space-s) 0 0;
    padding: 0;
  }

  .promise-list h3 {
    font-size: 1rem;
    margin-block-end: 0.25rem;
  }

  .promise-list p {
    margin: 0;
    font-size: 0.9375rem;
    color: var(--ink-muted);
  }

  .promise-list a {
    color: var(--signal);
  }

  @media (min-width: 40rem) {
    .hero-stats {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  @media (min-width: 52rem) {
    .hero-break {
      display: inline;
    }
  }
</style>
