---
import BaseLayout from '@layouts/BaseLayout.astro';
import ToolCard from '@components/tools/ToolCard.astro';
import CompareTray from '@components/tools/CompareTray.astro';
import NewsletterForm from '@components/marketing/NewsletterForm.astro';
import {
  getAllTools,
  getCatalogStats,
  getPopulatedCategories,
  getRecentlyAdded,
  getToolsByCategory,
} from '@lib/data/catalog';
import { getLatestNews } from '@lib/data/news';
import { itemListSchema } from '@lib/seo/structured-data';
import { recuentoVerificacion } from '@lib/domain/verification';
import { ROUTES, VERTICALS } from '@lib/nav';

const stats = getCatalogStats();

/*
 * Las cifras que podemos demostrar, y en ese orden.
 *
 * La portada decía «Herramientas verificadas: 94». No era cierto de las 94:
 * nueve no tienen plan gratuito, cinco están sin comprobar contra la fuente y
 * en setenta y nueve queda algún hecho que su fabricante no publica. Ahora las
 * cuatro cifras se distinguen y cada una lleva su nombre exacto.
 */
const recuento = recuentoVerificacion(getAllTools());

/*
 * La rejilla la encabezan las seis verticales, en orden editorial.
 *
 * Antes salían las ocho categorías con más fichas, ordenadas por tamaño, y el
 * resultado contaba mal la historia: «Modelos open-source» aparecía como
 * recomendación principal compitiendo con /modelos, `/audio` no salía porque
 * `musica` y `voz` son pequeñas por separado, y «Agentes IA» llevaba a la
 * página de categoría en vez de a la vertical.
 *
 * El tamaño no es un criterio editorial: las seis secciones son la forma de
 * recorrer el catálogo, y las categorías técnicas siguen a un clic en
 * /categorias.
 */
const SLUGS_VERTICALES: Record<string, readonly string[]> = {
  '/imagen': ['imagen'],
  '/video': ['video'],
  '/audio': ['musica', 'voz'],
  '/modelos': ['modelos'],
  '/agentes': ['agentes'],
  '/codigo': ['codigo'],
};

const verticales = VERTICALS.map((v) => {
  const slugs = SLUGS_VERTICALES[v.href] ?? [];
  const unicas = new Set(slugs.flatMap((s) => getToolsByCategory(s).map((tool) => tool.slug)));
  return { name: v.label, href: v.href, count: unicas.size };
});

/** Las categorías técnicas que quedan, sin repetir lo que ya es vertical. */
const YA_CUBIERTAS = new Set(Object.values(SLUGS_VERTICALES).flat());
const categorias = getPopulatedCategories()
  .filter((c) => !YA_CUBIERTAS.has(c.slug))
  .slice(0, 4);
/*
 * Lo comprobado hace menos, no lo mejor puntuado.
 *
 * Aquí ponía `getAllTools().slice(0, 6)`, y como el catálogo venía ordenado
 * por la nota sobre 100, estas seis eran literalmente el top-6 de una
 * puntuación que ya no publicamos. El criterio de ahora se puede leer en el
 * propio titular: son las últimas que hemos vuelto a comprobar.
 */
const topTools = [...getAllTools()]
  .sort((a, b) => b.lastVerifiedAt.localeCompare(a.lastVerifiedAt) || a.name.localeCompare(b.name, 'es'))
  .slice(0, 6);
const recent = getRecentlyAdded(4);
/*
 * «Qué ha cambiado últimamente», con noticias de verdad recientes.
 *
 * Esto salía de `changelog`, cuya entrada más nueva es del 1 de junio de 2024.
 * En agosto de 2026 la portada presentaba como «últimamente» algo de hace dos
 * años, mientras `/noticias` tenía casi doscientas entradas de este verano.
 *
 * La ventana es explícita y el bloque desaparece si no hay nada dentro: es
 * preferible una portada más corta que una sección que envejece sola.
 */
const VENTANA_DIAS = 60;
const limite = Date.now() - VENTANA_DIAS * 24 * 60 * 60 * 1000;
const changes = getLatestNews(12)
  .filter((item) => new Date(item.publishedAt).getTime() >= limite)
  .slice(0, 4);

const noCardPicks = getAllTools()
  .filter((t) => t.freePlan.requiresCreditCard === 'no' && t.freePlan.commercialUse === 'yes')
  .slice(0, 4);

const description =
  `Revisamos herramientas de IA contra la página oficial de su fabricante: qué es gratis de verdad, con qué límites, si piden tarjeta y si permiten uso comercial. ${recuento.total} revisadas, ${recuento.accesoGratuitoConfirmado} con acceso gratuito confirmado. Lo que no publican, lo decimos.`;
---

<BaseLayout
  title="Free AI Radar — IA gratis, verificada de verdad"
  description={description}
  schemas={[itemListSchema(topTools, 'Herramientas de IA revisadas hace menos')]}
>
  <section class="hero">
    <div class="page hero-inner">
      <p class="eyebrow hero-eyebrow">
        <span class="hero-pulse" aria-hidden="true"></span>
        Radar editorial independiente · actualizado el
        <time datetime={stats.lastVerifiedAt}>
          {new Date(`${stats.lastVerifiedAt}T00:00:00Z`).toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' })}
        </time>
      </p>

      <h1 class="hero-title">
        La IA que es <span class="hero-accent">gratis de verdad</span>,<br class="hero-break" />
        separada del humo.
      </h1>

      <p class="hero-lede">
        Probamos cada herramienta y publicamos lo incómodo: el límite real del plan gratuito, si
        te van a pedir la tarjeta, si te dejan marca de agua y si puedes usar el resultado para
        trabajar. Sin puntuaciones compradas.
      </p>

      <form class="hero-search" action={ROUTES.tools} method="get" role="search">
        <label class="sr-only" for="hero-q">¿Qué necesitas hacer?</label>
        <input
          type="search"
          id="hero-q"
          name="q"
          class="input"
          placeholder="Quitar fondo, transcribir audio, generar vídeo…"
          autocomplete="off"
        />
        <button type="submit" class="btn btn-primary">Buscar</button>
      </form>

      <ul class="hero-shortcuts">
        <li><a href={`${ROUTES.tools}?nocard=1`}>Sin pedir tarjeta</a></li>
        <li><a href={`${ROUTES.tools}?comm=1`}>Con uso comercial</a></li>
        <li><a href={`${ROUTES.tools}?oss=1`}>Open source</a></li>
        <li><a href={`${ROUTES.tools}?host=local`}>Funciona en local</a></li>
        <li><a href={`${ROUTES.tools}?nowm=1`}>Sin marca de agua</a></li>
      </ul>

      <dl class="hero-stats">
        <div><dt>Herramientas revisadas</dt><dd class="tnum">{recuento.total}</dd></div>
        <div><dt>Con acceso gratuito confirmado</dt><dd class="tnum">{recuento.accesoGratuitoConfirmado}</dd></div>
        <div><dt>Ficha completa</dt><dd class="tnum">{recuento.verificada}</dd></div>
        <div><dt>Con algún dato sin publicar</dt><dd class="tnum">{recuento.parcial}</dd></div>
      </dl>
      <p class="hero-stats-note">
        «Ficha completa» significa que el fabricante publica todo lo que
        resumimos. En las demás falta algún dato y lo decimos en la propia
        ficha, en vez de suponerlo. <a href={ROUTES.methodology}>Cómo lo comprobamos</a>.
      </p>
    </div>
  </section>

  <div class="page home-sections">
    <section aria-labelledby="top-title">
      <header class="section-head">
        <div>
          <p class="eyebrow">Comprobadas hace menos</p>
          <h2 id="top-title" class="section-title">Lo último que hemos verificado</h2>
        </div>
        <a href={ROUTES.tools} class="btn btn-ghost btn-sm">Ver las {stats.total} →</a>
      </header>
      <ul class="grid-cards card-list">
        {topTools.map((tool) => (
          <li><ToolCard tool={tool} /></li>
        ))}
      </ul>
    </section>

    <section aria-labelledby="cat-title">
      <header class="section-head">
        <div>
          <p class="eyebrow">Por tipo de trabajo</p>
          <h2 id="cat-title" class="section-title">Empieza por lo que necesitas hacer</h2>
        </div>
        <a href={ROUTES.categories} class="btn btn-ghost btn-sm">Todas las categorías →</a>
      </header>
      <ul class="category-grid">
        {verticales.map((v) => (
          <li>
            <a href={v.href} class="card card-interactive category-card">
              <span class="category-name">{v.name}</span>
              <span class="category-count tnum">{v.count}</span>
            </a>
          </li>
        ))}
      </ul>
      <ul class="category-grid category-grid-rest">
        {categorias.map((cat) => (
          <li>
            <a href={ROUTES.category(cat.slug)} class="card card-interactive category-card">
              <span class="category-name">{cat.name}</span>
              <span class="category-count tnum">{cat.count}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    {changes.length > 0 && (
      <section aria-labelledby="changes-title" class="changes-section">
        <header class="section-head">
          <div>
            <p class="eyebrow">Últimos {VENTANA_DIAS} días</p>
            <h2 id="changes-title" class="section-title">Qué ha cambiado últimamente</h2>
          </div>
          <a href={ROUTES.news} class="btn btn-ghost btn-sm">Historial completo →</a>
        </header>
        <ol class="change-list">
          {changes.map((item) => (
            <li class="change-item">
              <time datetime={item.publishedAt} class="change-date tnum">
                {new Date(item.publishedAt).toLocaleDateString('es-ES', { day: '2-digit', month: 'short', year: 'numeric', timeZone: 'UTC' })}
              </time>
              <div>
                <a href={ROUTES.newsItem(item.slug)} class="change-tool">{item.title}</a>
                <p class="change-summary">{item.summary}</p>
              </div>
            </li>
          ))}
        </ol>
      </section>
    )}

    <section aria-labelledby="nocard-title">
      <header class="section-head">
        <div>
          <p class="eyebrow">Colección</p>
          <h2 id="nocard-title" class="section-title">Sin tarjeta y con derecho a monetizar</h2>
        </div>
        <a href={`${ROUTES.tools}?nocard=1&comm=1`} class="btn btn-ghost btn-sm">Ver todas →</a>
      </header>
      <p class="section-lede">
        Las dos condiciones que más veces fallan a la vez. En estas, las dos están confirmadas por escrito.
      </p>
      <ul class="grid-cards card-list">
        {noCardPicks.map((tool) => (
          <li><ToolCard tool={tool} variant="compact" /></li>
        ))}
      </ul>
    </section>

    <section aria-labelledby="recent-title">
      <header class="section-head">
        <div>
          <p class="eyebrow">Nuevas en el radar</p>
          <h2 id="recent-title" class="section-title">Añadidas recientemente</h2>
        </div>
      </header>
      <ul class="grid-cards card-list">
        {recent.map((tool) => (
          <li><ToolCard tool={tool} variant="compact" /></li>
        ))}
      </ul>
    </section>

    <section class="promise" aria-labelledby="promise-title">
      <h2 id="promise-title" class="section-title">Cómo trabajamos</h2>
      <ul class="promise-list">
        <li>
          <h3>Verificamos, no copiamos</h3>
          <p>
            Cada dato del plan gratuito sale de la página oficial del fabricante, con enlace y
            fecha. Si no lo hemos confirmado, lo decimos: verás «sin verificar», nunca un «no»
            inventado.
          </p>
        </li>
        <li>
          <h3>El veredicto no se vende</h3>
          <p>
            Un patrocinio puede comprar visibilidad claramente etiquetada. No puede comprar un
            cambio de veredicto, un puesto en una lista ni un dato distinto del comprobado.
            <a href={ROUTES.editorialPolicy}>Política editorial</a>.
          </p>
        </li>
        <li>
          <h3>Sin nota y sin ranking</h3>
          <p>
            No publicamos una puntuación única ni ordenamos por calidad: cada ficha dice qué
            hemos comprobado, contra qué página y qué falta.
            <a href={ROUTES.methodology}>Cómo lo comprobamos</a>.
          </p>
        </li>
        <li>
          <h3>Puedes corregirnos</h3>
          <p>
            Los planes gratuitos cambian sin avisar. Cada ficha tiene un botón para reportar que
            algo ya no es cierto, y lo revisamos.
          </p>
        </li>
      </ul>
    </section>

    <NewsletterForm />
  </div>

  <CompareTray />
</BaseLayout>

<style>
  .hero {
    border-block-end: 1px solid var(--line);
    background:
      linear-gradient(to bottom, var(--surface-sunken), transparent 70%);
    padding-block: var(--space-xl) var(--space-l);
  }

  .hero-inner {
    max-width: 62rem;
  }

  .hero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin: 0 0 var(--space-s);
  }

  .hero-pulse {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--signal);
    box-shadow: 0 0 0 0 color-mix(in srgb, var(--signal) 60%, transparent);
    animation: pulse 2.6s ease-out infinite;
  }

  @keyframes pulse {
    70% {
      box-shadow: 0 0 0 7px color-mix(in srgb, var(--signal) 0%, transparent);
    }
    100% {
      box-shadow: 0 0 0 0 color-mix(in srgb, var(--signal) 0%, transparent);
    }
  }

  .hero-title {
    font-size: clamp(2.1rem, 1.3rem + 3.8vw, 3.9rem);
    line-height: 1.03;
    letter-spacing: -0.033em;
    margin-block-end: var(--space-s);
  }

  .hero-accent {
    color: var(--signal);
  }

  .hero-break {
    display: none;
  }

  .hero-lede {
    max-width: 46rem;
    font-size: clamp(1rem, 0.95rem + 0.35vw, 1.1875rem);
    color: var(--ink-muted);
    margin-block-end: var(--space-m);
  }

  .hero-search {
    display: flex;
    gap: var(--space-2xs);
    max-width: 34rem;
    margin-block-end: var(--space-s);
  }

  .hero-search .input {
    min-height: 48px;
  }

  .hero-shortcuts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
    margin: 0 0 var(--space-l);
    padding: 0;
  }

  .hero-shortcuts a {
    display: inline-block;
    padding: 0.35rem 0.75rem;
    border-radius: var(--radius-full);
    border: 1px solid var(--line-strong);
    background: var(--surface);
    font-size: 0.8125rem;
    font-weight: 550;
    color: var(--ink-muted);
    text-decoration: none;
    min-height: 34px;
    line-height: 1.6;
  }

  .hero-shortcuts a:hover {
    border-color: var(--signal);
    color: var(--signal);
  }

  .hero-stats-note {
    margin: var(--space-2xs) 0 0;
    max-width: 52ch;
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--ink-subtle);
  }

  .hero-stats {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-s);
    margin: 0;
    padding-block-start: var(--space-s);
    border-block-start: 1px solid var(--line);
  }

  .hero-stats dt {
    font-size: 0.75rem;
    color: var(--ink-subtle);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 600;
  }

  .hero-stats dd {
    margin: 0.1rem 0 0;
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--ink-strong);
  }

  .home-sections {
    display: grid;
    gap: var(--space-2xl);
    padding-block: var(--space-xl);
  }

  .section-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-s);
    margin-block-end: var(--space-s);
    padding-block-end: var(--space-2xs);
    border-block-end: 1px solid var(--line);
  }

  .section-title {
    font-size: clamp(1.35rem, 1.15rem + 0.9vw, 1.85rem);
    margin: 0.15rem 0 0;
  }

  .section-lede {
    margin: calc(-1 * var(--space-3xs)) 0 var(--space-s);
    color: var(--ink-muted);
    font-size: 0.9375rem;
    max-width: 50ch;
  }

  /* La segunda fila son categorías técnicas: van detrás y algo más apagadas. */
  .category-grid-rest {
    margin-block-start: var(--space-2xs);
    opacity: 0.85;
  }

  .card-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .card-list > li {
    display: flex;
  }

  .card-list > li > :global(*) {
    width: 100%;
  }

  .category-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 11rem), 1fr));
    gap: var(--space-2xs);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .category-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2xs);
    padding: var(--space-xs) var(--space-s);
    text-decoration: none;
    min-height: 56px;
  }

  .category-name {
    font-weight: 600;
    color: var(--ink-strong);
  }

  .category-count {
    font-size: 0.8125rem;
    color: var(--ink-subtle);
    font-weight: 600;
  }

  .change-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0;
  }

  .change-item {
    display: grid;
    grid-template-columns: 4.5rem 1fr;
    gap: var(--space-s);
    padding-block: var(--space-xs);
    border-block-end: 1px solid var(--line-hairline);
  }

  .change-item:last-child {
    border-block-end: 0;
  }

  .change-date {
    font-size: 0.75rem;
    color: var(--ink-subtle);
    font-weight: 600;
    padding-block-start: 0.15rem;
  }

  .change-tool {
    font-weight: 650;
    color: var(--ink-strong);
    text-decoration: none;
  }

  .change-tool:hover {
    text-decoration: underline;
  }

  .change-summary {
    margin: 0.1rem 0 0;
    font-size: 0.875rem;
    color: var(--ink-muted);
  }

  .promise-list {
    display: grid;
    gap: var(--space-m);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
    list-style: none;
    margin: var(--space-s) 0 0;
    padding: 0;
  }

  .promise-list h3 {
    font-size: 1rem;
    margin-block-end: 0.25rem;
  }

  .promise-list p {
    margin: 0;
    font-size: 0.9375rem;
    color: var(--ink-muted);
  }

  .promise-list a {
    color: var(--signal);
  }

  @media (min-width: 40rem) {
    .hero-stats {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  @media (min-width: 52rem) {
    .hero-break {
      display: inline;
    }
  }
</style>
