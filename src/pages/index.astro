---
import BaseLayout from '@layouts/BaseLayout.astro';
import PuertaBuscar from '@components/home/PuertaBuscar.astro';
import PuertaActualidad from '@components/home/PuertaActualidad.astro';
import PuertaComparar from '@components/home/PuertaComparar.astro';
import FranjaConfianza from '@components/home/FranjaConfianza.astro';
import RadarCatalogo from '@components/home/RadarCatalogo.astro';
import CompareTray from '@components/tools/CompareTray.astro';
import NewsletterForm from '@components/marketing/NewsletterForm.astro';
import { getAllTools, getCatalogStats } from '@lib/data/catalog';
import { VERTICALES, carasDe, destacadas } from '@lib/data/home';
import PilaDeLogos from '@components/tools/PilaDeLogos.astro';
import Icono, { type NombreDeIcono } from '@components/home/Icono.astro';
import registroDeLogos from '@/data/logos.json';
import { EJEMPLOS_DE_BUSQUEDA, conteosDeDecision, hrefDeBusqueda, recomendadas } from '@lib/data/portada';
import { getLatestNews } from '@lib/data/news';
import { radarDe } from '@lib/data/radar';
import { itemListSchema } from '@lib/seo/structured-data';
import { recuentoVerificacion } from '@lib/domain/verification';
import { ROUTES, VERTICALS } from '@lib/nav';

/*
 * Tres puertas, no cuatro llamadas compitiendo.
 *
 * La portada anterior ponía a la vez un buscador, seis atajos de intención,
 * seis tarjetas «una por vertical» y ocho enlaces en la cabecera: cuatro listas
 * para el mismo viaje. Ahora dice en la primera pantalla las tres cosas que se
 * pueden hacer aquí —encontrar, ver qué ha cambiado y comparar—, y cada una
 * lleva dentro contenido de verdad en vez de un botón.
 */
const tools = getAllTools();
const stats = getCatalogStats();
const recuento = recuentoVerificacion(tools);

const conteos = conteosDeDecision(tools);
const paraEmpezar = recomendadas(5);
const paraSchema = destacadas(5).map(({ tool }) => tool);

/*
 * Lo que Newsroom haya publicado, sin tocar nada suyo.
 *
 * La portada sólo lee. Ni decide qué se publica, ni cuándo, ni con qué fuente.
 */
const VENTANA_DIAS = 90;
const limite = Date.now() - VENTANA_DIAS * 24 * 60 * 60 * 1000;
const noticias = getLatestNews(12)
  .filter((item) => new Date(item.publishedAt).getTime() >= limite)
  .slice(0, 3);

const opciones = tools.map((t) => ({ slug: t.slug, name: t.name }));

/*
 * La primera pantalla hace una sola pregunta.
 *
 * Abría con la fecha de revisión, un titular sobre lo gratis y un párrafo de
 * método: tres cosas ciertas que obligaban a leer antes de poder hacer nada.
 * Ahora pregunta qué clase de IA buscas y ofrece las seis respuestas como
 * botones grandes; quien ya sabe el nombre tiene el buscador justo debajo. La
 * fecha, las cifras y el método siguen en la página, después de esta pantalla.
 *
 * El orden es el de la pregunta —de lo que se genera a lo que se usa para
 * construir—, no el de la navegación, así que se fija aquí por ruta.
 */
const ORDEN_HERO = ['/imagen', '/video', '/audio', ROUTES.agents, ROUTES.models, '/codigo'];
const tieneLogo = (t: (typeof tools)[number]) =>
  Boolean(t.logo || (registroDeLogos as Record<string, { ruta?: string }>)[t.slug]?.ruta);
const carasUsadas = new Set<string>();
const verticalesHero = ORDEN_HERO.map((href) => VERTICALS.find((v) => v.href === href))
  .filter((v): v is (typeof VERTICALS)[number] => v !== undefined)
  .map((v) => {
    const slugs = VERTICALES.find((x) => x.ruta === v.href)?.slugs ?? [];
    return { ...v, sector: v.href.slice(1), caras: carasDe(tools, slugs, tieneLogo, carasUsadas) };
  });

/*
 * El catálogo entero, al lado de la pregunta.
 *
 * Las seis puertas dicen qué clases hay; el radar enseña cuánto hay en cada
 * una y cuánto cuesta usarlo. Va después del buscador en el orden del
 * documento, así que en un móvil no empuja las puertas por debajo del aviso
 * de cookies; en escritorio se sienta a su derecha.
 */
const radar = radarDe(tools);

/*
 * Caras en el radar, en su sitio.
 *
 * Las dos primeras caras de cada puerta salen también en el radar, sobre su
 * propio punto: no se mueven para quedar bonitas, así que una cara dice a la
 * vez quién es y dónde cae. Y como son las mismas que las de la puerta, al
 * señalar «Audio» se encienden en el sector de Audio las caras que se acaban
 * de ver en el botón.
 */
const registro = registroDeLogos as Record<string, { ruta?: string; placa?: string }>;
const logosDelRadar = verticalesHero
  .flatMap((v) => v.caras.slice(0, 2))
  .map((t) => ({ slug: t.slug, src: t.logo ?? registro[t.slug]?.ruta ?? '', placa: registro[t.slug]?.placa ?? 'tema' }))
  .filter((l) => l.src !== '');

/*
 * El icono de cada puerta sale de su sector, que es la ruta sin la barra:
 * `/imagen` → `imagen`. Las seis rutas de `ORDEN_HERO` tienen el suyo.
 */
const ICONO_DE_SECTOR: Record<string, NombreDeIcono> = {
  imagen: 'imagen',
  video: 'video',
  audio: 'audio',
  agentes: 'agentes',
  modelos: 'modelos',
  codigo: 'codigo',
};

/*
 * Con qué dos herramientas viene puesto el comparador.
 *
 * Arrancaba con las dos primeras del abecedario, que no le dicen nada a nadie.
 * Estas dos son las que más gente reconoce y, además, comparten casi todo menos
 * lo que decide: es una comparación que se entiende sin leer la tabla entera.
 */
const PAR_INICIAL = ['chatgpt', 'claude'];
const par = PAR_INICIAL.filter((slug) => opciones.some((o) => o.slug === slug));
const preseleccion = par.length === 2 ? par : opciones.slice(0, 2).map((o) => o.slug);

const description =
  `Revisamos herramientas de IA contra la página oficial de su fabricante: qué es gratis de verdad, con qué límites, si piden tarjeta y si permiten uso comercial. ${recuento.total} revisadas, ${recuento.accesoGratuitoConfirmado} con acceso gratuito confirmado. Lo que no publican, lo decimos.`;
---

<BaseLayout
  title="Free AI Radar — Qué IA es gratis de verdad"
  description={description}
  schemas={[itemListSchema(paraSchema, 'Herramientas de IA con acceso gratuito confirmado')]}
>
  <section class="hero" aria-labelledby="hero-titulo">
    {/*
      El cielo de la primera pantalla: estrellas y un horizonte.

      Es lo único de la portada que sólo decora, y por eso va en un elemento
      aparte, oculto a los lectores de pantalla y sin recibir el puntero. Se
      pinta con degradados de CSS, sin imágenes que descargar. En claro casi no
      se ve: los tokens `--atmos-*` lo apagan.
    */}
    <div class="hero-cielo" aria-hidden="true"></div>

    <div class="page hero-inner">
      <div class="hero-texto">
        <p class="hero-antetitulo">
          Descubre <span class="hero-antetitulo-punto" aria-hidden="true">•</span> compara <span class="hero-antetitulo-punto" aria-hidden="true">•</span> elige mejor
        </p>

        <h1 id="hero-titulo" class="hero-title">¿Qué clase de <span class="hero-acento">IA</span> estás buscando?</h1>

        {/*
          Una línea, no un párrafo.

          La portada no decía en ninguna parte qué la diferencia de las listas de
          «las 50 mejores IA»: que cada dato sale de la página oficial del
          fabricante y que lo que no publica se dice. Va aquí porque es donde se
          decide si merece la pena quedarse, y es una línea porque el trabajo de
          la primera pantalla es que elijas, no que leas.
        */}
        <p class="hero-diferencial">
          Comprobamos en la web de cada fabricante qué da gratis: si pide tarjeta, con qué límites y si
          puedes usarlo para trabajar. Lo que no publica, lo decimos.
        </p>

        <nav class="hero-verticales" aria-label="Elegir por clase de IA">
          <ul>
            {/*
              Los logos son decorativos para la vista y no para el oído.

              Llevan `alt=""` —el nombre del enlace sigue siendo «Imagen»— y los
              tres nombres van en texto oculto a continuación, para que quien usa
              un lector de pantalla reciba la misma pista que quien los ve:
              «Imagen, por ejemplo Clipdrop, Krea e Ideogram».

              El icono y la descripción son la parte nueva. El icono lleva el
              color de su sector del radar, que es como la puerta y el sector se
              reconocen como la misma cosa; la descripción sólo aparece cuando la
              tarjeta tiene ancho para ella, porque en un móvil las seis puertas
              tienen que caber por encima del aviso de cookies.
            */}
            {verticalesHero.map((vertical) => (
              <li>
                <a class="hero-vertical" href={vertical.href} data-sector={vertical.sector}>
                  <span class="hero-vertical-icono">
                    <Icono nombre={ICONO_DE_SECTOR[vertical.sector] ?? 'imagen'} />
                  </span>
                  <span class="hero-vertical-nombre">{vertical.label}</span>
                  <span class="hero-vertical-flecha" aria-hidden="true">→</span>
                  {vertical.description && <span class="hero-vertical-desc">{vertical.description}</span>}
                  <PilaDeLogos tools={vertical.caras} nombrarOculto />
                </a>
              </li>
            ))}
          </ul>
        </nav>

        <form class="hero-buscar" role="search" action={ROUTES.tools} method="get">
          {/*
            La etiqueta sigue ahí, para quien no ve la lupa.

            Visible decía «¿Buscas algo concreto?» encima de la caja; ahora la
            caja lleva su lupa y su botón, y la pregunta se queda como nombre
            accesible del campo.
          */}
          <label class="sr-only" for="hero-q">¿Buscas algo concreto?</label>
          <div class="hero-buscar-campo">
            <Icono nombre="lupa" class="hero-buscar-lupa" />
            <input
              type="search"
              id="hero-q"
              name="q"
              class="hero-buscar-input"
              placeholder="Quitar fondo, transcribir audio, generar vídeo…"
              autocomplete="off"
            />
            <button type="submit" class="btn btn-primary hero-buscar-boton">
              Buscar <span aria-hidden="true">→</span>
            </button>
          </div>
        </form>

        <div class="hero-ejemplos">
          <span id="hero-ejemplos-t" class="hero-ejemplos-t">Prueba con:</span>
          <ul role="list" aria-labelledby="hero-ejemplos-t">
            {EJEMPLOS_DE_BUSQUEDA.map((ejemplo) => (
              <li>
                <a class="hero-ejemplo" href={hrefDeBusqueda(ejemplo)}>{ejemplo}</a>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <RadarCatalogo radar={radar} logos={logosDelRadar} />
    </div>
  </section>

  <div class="page home">
    {/*
      Cada puerta va en su hueco.

      El hueco lo pone la página y la tarjeta la pinta el componente: el CSS de
      un fichero de Astro sólo alcanza a los elementos que ese fichero escribe,
      así que colocar las secciones de los hijos con `nth-child` no funciona —lo
      comprobé: las tres quedaban en colocación automática—.
    */}
    <div class="puertas">
      <div class="hueco hueco-buscar">
        <PuertaBuscar recomendadas={paraEmpezar} conteos={conteos} />
      </div>
      <div class="hueco hueco-actualidad">
        <PuertaActualidad noticias={noticias} />
      </div>
      <div class="hueco hueco-comparar">
        <PuertaComparar opciones={opciones} preseleccion={preseleccion} />
      </div>
    </div>

    {/*
      Sin la fila «Por lo que quieres hacer».

      Eran las mismas seis verticales que la hero pregunta en la primera
      pantalla, repetidas con su cifra dos desplazamientos más abajo.
    */}
    <p class="home-revisado">
      <span>
        Catálogo revisado por última vez el{' '}
        <time datetime={stats.lastVerifiedAt}>
          {new Date(`${stats.lastVerifiedAt}T00:00:00Z`).toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' })}
        </time>
      </span>
    </p>

    <FranjaConfianza recuento={recuento} />

    <NewsletterForm variant="inline" />
  </div>

  <CompareTray />
</BaseLayout>

<style>
  /*
   * La primera pantalla, de noche.
   *
   * Encima del papel, un halo verde detrás del radar y, en oscuro, un cielo
   * con estrellas y el arco de un horizonte. Todo sale de los tokens
   * `--atmos-*`: en claro el cielo se queda en un halo leve sobre el papel,
   * que es lo que pide el resto del sitio. `overflow: clip` porque el arco es
   * más ancho que la pantalla y no puede empujarla de lado.
   */
  .hero {
    position: relative;
    isolation: isolate;
    overflow: clip;
    border-block-end: 1px solid var(--line);
    background: linear-gradient(to bottom, var(--atmos-base), var(--paper) 85%);
    padding-block: var(--space-m) var(--space-l);
  }

  @media (min-width: 48rem) {
    .hero {
      padding-block: var(--space-xl);
    }
  }

  @media (min-width: 62rem) {
    .hero {
      padding-block: var(--space-2xl) var(--space-xl);
      background:
        radial-gradient(ellipse 38% 48% at 76% 44%, var(--atmos-glow), transparent 72%),
        linear-gradient(to bottom, var(--atmos-base), var(--paper) 85%);
    }
  }

  .hero-cielo {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background-image:
      radial-gradient(1px 1px at 6% 12%, var(--atmos-star), transparent),
      radial-gradient(1px 1px at 18% 64%, var(--atmos-star), transparent),
      radial-gradient(1.5px 1.5px at 27% 28%, var(--atmos-star), transparent),
      radial-gradient(1px 1px at 39% 82%, var(--atmos-star), transparent),
      radial-gradient(1px 1px at 46% 9%, var(--atmos-star), transparent),
      radial-gradient(1.5px 1.5px at 58% 47%, var(--atmos-star), transparent),
      radial-gradient(1px 1px at 67% 18%, var(--atmos-star), transparent),
      radial-gradient(1px 1px at 74% 73%, var(--atmos-star), transparent),
      radial-gradient(1.5px 1.5px at 86% 33%, var(--atmos-star), transparent),
      radial-gradient(1px 1px at 93% 88%, var(--atmos-star), transparent),
      radial-gradient(1px 1px at 97% 6%, var(--atmos-star), transparent);
    background-size: 560px 380px;
    mask-image: linear-gradient(to bottom, black, transparent 92%);
    opacity: 0.8;
  }

  /*
   * El horizonte: un arco enorme cuyo borde de arriba asoma por debajo del
   * radar. Sólo en escritorio, donde el radar está al lado; en un móvil sería
   * una línea curva cruzando las puertas.
   */
  @media (min-width: 62rem) {
    .hero-cielo::after {
      content: '';
      position: absolute;
      inset-inline-start: 18%;
      inset-block-start: 84%;
      width: 130%;
      aspect-ratio: 1;
      border-radius: 50%;
      border-block-start: 1px solid var(--atmos-arc);
      background: radial-gradient(ellipse 50% 6% at 50% 0, var(--atmos-glow), transparent);
      box-shadow: 0 -18px 60px -24px var(--atmos-arc);
    }
  }

  /*
   * Dos columnas en escritorio: la pregunta a la izquierda, el radar a la
   * derecha. En móvil, una detrás de otra y en ese orden, que es el del
   * documento: primero se elige, después se mira.
   */
  .hero-inner {
    display: grid;
    gap: var(--space-xl);
  }

  @media (min-width: 62rem) {
    .hero-inner {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
      align-items: center;
      gap: var(--space-xl);
    }
  }

  .hero-texto {
    display: grid;
    align-content: start;
    gap: var(--space-m);
    min-width: 0;
  }

  /*
   * El antetítulo sólo a partir de 40 rem.
   *
   * En un 375×812 la sexta puerta acaba a 31 px de donde empieza la barra de
   * cookies de la primera visita, y la píldora mide 50 con su hueco: no cabe
   * sin que la última fila de puertas quede debajo del aviso, que es lo que
   * vigila `home.spec.ts`. No dice nada que el titular no diga.
   */
  .hero-antetitulo {
    display: none;
    justify-self: start;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    padding: 0.375rem 0.875rem;
    border: 1px solid var(--signal-line);
    border-radius: var(--radius-full);
    background: color-mix(in oklab, var(--signal-soft) 70%, transparent);
    color: var(--signal-strong);
    font-size: 0.75rem;
    font-weight: 650;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  @media (min-width: 40rem) {
    .hero-antetitulo {
      display: inline-flex;
    }
  }

  .hero-antetitulo-punto {
    color: var(--signal);
  }

  .hero-title {
    margin: 0;
    max-width: 16ch;
    font-size: clamp(2.125rem, 1.15rem + 4.4vw, 4rem);
    font-weight: 700;
    line-height: 1.02;
    letter-spacing: -0.045em;
    text-wrap: balance;
  }

  .hero-acento {
    color: var(--signal);
  }

  .hero-diferencial {
    margin: 0;
    max-width: 48ch;
    color: var(--ink-muted);
    font-size: clamp(1rem, 0.95rem + 0.3vw, 1.1875rem);
    line-height: 1.5;
    text-wrap: pretty;
  }

  /*
   * Seis botones, no seis enlaces.
   *
   * Tienen que parecer lo que son —la respuesta a la pregunta de arriba— y
   * poder pulsarse con el pulgar. Las columnas dependen del ancho de la
   * rejilla, no de la pantalla: a 1024 px la columna de la pregunta mide medio
   * escritorio y tres tarjetas en fila partían la descripción en tres líneas.
   *
   * Tres logos sí. No son texto que haya que leer, son caras que se reconocen,
   * y eso es exactamente lo que ayuda a elegir: quien busca «algo como
   * ElevenLabs» encuentra la puerta sin saber que se llama Audio. Se apilan
   * solapados para que quepan en la mitad de un móvil sin estrujar la palabra.
   */
  .hero-verticales {
    width: 100%;
    container-type: inline-size;
  }

  .hero-verticales ul {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-2xs);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @container (min-width: 36rem) {
    .hero-verticales ul {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  /*
   * Compacta en móvil, y medida.
   *
   * En estrecho, una fila con el icono (24 px, del alto de la palabra), el
   * nombre y la flecha, y debajo los logos (22 px). Medido a 375×812: con un
   * icono de 28 px la sexta puerta acababa a 5 px de la barra de cookies; así
   * queda a más de 20. La descripción entra cuando la rejilla tiene ancho
   * para ella. Siempre por encima de los 44 px de objetivo táctil.
   */
  .hero-vertical {
    --sector: var(--signal);

    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    grid-template-areas:
      'icono nombre flecha'
      'pila pila pila';
    align-items: center;
    align-content: start;
    gap: 0.25rem 0.5rem;
    height: 100%;
    min-height: 56px;
    padding: 0.5rem 0.625rem;
    line-height: 1.2;
    border: 1px solid var(--line);
    border-radius: var(--radius-l);
    background: color-mix(in oklab, var(--surface) 88%, transparent);
    box-shadow: var(--shadow-s);
    color: var(--ink-strong);
    font-size: 1.0625rem;
    font-weight: 650;
    letter-spacing: -0.01em;
    text-decoration: none;
    transition:
      border-color 160ms ease,
      box-shadow 160ms ease,
      transform 160ms ease;
  }

  .hero-vertical[data-sector='imagen'] {
    --sector: var(--sector-imagen);
  }

  .hero-vertical[data-sector='video'] {
    --sector: var(--sector-video);
  }

  .hero-vertical[data-sector='audio'] {
    --sector: var(--sector-audio);
  }

  .hero-vertical[data-sector='agentes'] {
    --sector: var(--sector-agentes);
  }

  .hero-vertical[data-sector='modelos'] {
    --sector: var(--sector-modelos);
  }

  .hero-vertical[data-sector='codigo'] {
    --sector: var(--sector-codigo);
  }

  .hero-vertical:hover {
    border-color: var(--sector);
    box-shadow:
      0 0 0 1px color-mix(in oklab, var(--sector) 35%, transparent),
      var(--shadow-m);
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .hero-vertical:hover {
      transform: translateY(-2px);
    }
  }

  .hero-vertical:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }

  .hero-vertical-icono {
    grid-area: icono;
    display: grid;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
    border: 1px solid color-mix(in oklab, var(--sector) 32%, transparent);
    border-radius: 6px;
    background: color-mix(in oklab, var(--sector) 15%, transparent);
    color: var(--sector);
  }

  .hero-vertical-icono :global(.icono) {
    width: 0.9375rem;
    height: 0.9375rem;
  }

  .hero-vertical-nombre {
    grid-area: nombre;
    min-width: 0;
  }

  .hero-vertical-desc {
    grid-area: desc;
    display: none;
    color: var(--ink-muted);
    font-size: 0.8125rem;
    font-weight: 450;
    line-height: 1.4;
    letter-spacing: 0;
    text-wrap: pretty;
  }

  .hero-vertical :global(.pila) {
    grid-area: pila;
    min-height: 22px;
  }

  .hero-vertical :global(.pila .tool-logo) {
    width: 22px;
    height: 22px;
  }

  @container (min-width: 30rem) {
    .hero-vertical {
      grid-template-areas:
        'icono nombre flecha'
        'desc desc desc'
        'pila pila pila';
      gap: 0.5rem 0.625rem;
      padding: 0.875rem 0.9375rem;
    }

    .hero-vertical-icono {
      width: 2.25rem;
      height: 2.25rem;
      border-radius: 10px;
    }

    .hero-vertical-icono :global(.icono) {
      width: 1.25rem;
      height: 1.25rem;
    }

    .hero-vertical-desc {
      display: block;
    }

    .hero-vertical :global(.pila) {
      min-height: 24px;
    }

    .hero-vertical :global(.pila .tool-logo) {
      width: 24px;
      height: 24px;
    }
  }

  .hero-vertical-flecha {
    grid-area: flecha;
    color: var(--ink-subtle);
    font-weight: 500;
    transition: transform 160ms ease;
  }

  .hero-vertical:hover .hero-vertical-flecha {
    color: var(--sector);
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .hero-vertical:hover .hero-vertical-flecha {
