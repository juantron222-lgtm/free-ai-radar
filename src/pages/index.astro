---
import BaseLayout from '@layouts/BaseLayout.astro';
import PuertaBuscar from '@components/home/PuertaBuscar.astro';
import PuertaActualidad from '@components/home/PuertaActualidad.astro';
import PuertaComparar from '@components/home/PuertaComparar.astro';
import FranjaConfianza from '@components/home/FranjaConfianza.astro';
import CompareTray from '@components/tools/CompareTray.astro';
import NewsletterForm from '@components/marketing/NewsletterForm.astro';
import { getAllTools, getCatalogStats } from '@lib/data/catalog';
import { destacadas } from '@lib/data/home';
import { conteosDeDecision, recomendadas } from '@lib/data/portada';
import { getLatestNews } from '@lib/data/news';
import { itemListSchema } from '@lib/seo/structured-data';
import { recuentoVerificacion } from '@lib/domain/verification';
import { ROUTES, VERTICALS } from '@lib/nav';

/*
 * Tres puertas, no cuatro llamadas compitiendo.
 *
 * La portada anterior ponía a la vez un buscador, seis atajos de intención,
 * seis tarjetas «una por vertical» y ocho enlaces en la cabecera: cuatro listas
 * para el mismo viaje. Ahora dice en la primera pantalla las tres cosas que se
 * pueden hacer aquí —encontrar, ver qué ha cambiado y comparar—, y cada una
 * lleva dentro contenido de verdad en vez de un botón.
 */
const tools = getAllTools();
const stats = getCatalogStats();
const recuento = recuentoVerificacion(tools);

const conteos = conteosDeDecision(tools);
const paraEmpezar = recomendadas(5);
const paraSchema = destacadas(5).map(({ tool }) => tool);

/*
 * Lo que Newsroom haya publicado, sin tocar nada suyo.
 *
 * La portada sólo lee. Ni decide qué se publica, ni cuándo, ni con qué fuente.
 */
const VENTANA_DIAS = 90;
const limite = Date.now() - VENTANA_DIAS * 24 * 60 * 60 * 1000;
const noticias = getLatestNews(12)
  .filter((item) => new Date(item.publishedAt).getTime() >= limite)
  .slice(0, 3);

const opciones = tools.map((t) => ({ slug: t.slug, name: t.name }));

/*
 * La primera pantalla hace una sola pregunta.
 *
 * Abría con la fecha de revisión, un titular sobre lo gratis y un párrafo de
 * método: tres cosas ciertas que obligaban a leer antes de poder hacer nada.
 * Ahora pregunta qué clase de IA buscas y ofrece las seis respuestas como
 * botones grandes; quien ya sabe el nombre tiene el buscador justo debajo. La
 * fecha, las cifras y el método siguen en la página, después de esta pantalla.
 *
 * El orden es el de la pregunta —de lo que se genera a lo que se usa para
 * construir—, no el de la navegación, así que se fija aquí por ruta.
 */
const ORDEN_HERO = ['/imagen', '/video', '/audio', ROUTES.agents, ROUTES.models, '/codigo'];
const verticalesHero = ORDEN_HERO.map((href) => VERTICALS.find((v) => v.href === href)).filter(
  (v): v is (typeof VERTICALS)[number] => v !== undefined
);

/*
 * Con qué dos herramientas viene puesto el comparador.
 *
 * Arrancaba con las dos primeras del abecedario, que no le dicen nada a nadie.
 * Estas dos son las que más gente reconoce y, además, comparten casi todo menos
 * lo que decide: es una comparación que se entiende sin leer la tabla entera.
 */
const PAR_INICIAL = ['chatgpt', 'claude'];
const par = PAR_INICIAL.filter((slug) => opciones.some((o) => o.slug === slug));
const preseleccion = par.length === 2 ? par : opciones.slice(0, 2).map((o) => o.slug);

const description =
  `Revisamos herramientas de IA contra la página oficial de su fabricante: qué es gratis de verdad, con qué límites, si piden tarjeta y si permiten uso comercial. ${recuento.total} revisadas, ${recuento.accesoGratuitoConfirmado} con acceso gratuito confirmado. Lo que no publican, lo decimos.`;
---

<BaseLayout
  title="Free AI Radar — Qué IA es gratis de verdad"
  description={description}
  schemas={[itemListSchema(paraSchema, 'Herramientas de IA con acceso gratuito confirmado')]}
>
  <section class="hero" aria-labelledby="hero-titulo">
    <div class="page hero-inner">
      <h1 id="hero-titulo" class="hero-title">¿Qué clase de IA estás buscando?</h1>

      <nav class="hero-verticales" aria-label="Elegir por clase de IA">
        <ul>
          {verticalesHero.map((vertical) => (
            <li>
              <a class="hero-vertical" href={vertical.href}>
                <span>{vertical.label}</span>
                <span class="hero-vertical-flecha" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <form class="hero-buscar" role="search" action={ROUTES.tools} method="get">
        <label class="hero-buscar-intro" for="hero-q">¿Buscas algo concreto?</label>
        <div class="hero-buscar-campo">
          <input
            type="search"
            id="hero-q"
            name="q"
            class="input"
            placeholder="Quitar fondo, transcribir audio, generar vídeo…"
            autocomplete="off"
          />
          <button type="submit" class="btn btn-primary">Buscar</button>
        </div>
      </form>
    </div>
  </section>

  <div class="page home">
    {/*
      Cada puerta va en su hueco.

      El hueco lo pone la página y la tarjeta la pinta el componente: el CSS de
      un fichero de Astro sólo alcanza a los elementos que ese fichero escribe,
      así que colocar las secciones de los hijos con `nth-child` no funciona —lo
      comprobé: las tres quedaban en colocación automática—.
    */}
    <div class="puertas">
      <div class="hueco hueco-buscar">
        <PuertaBuscar recomendadas={paraEmpezar} conteos={conteos} />
      </div>
      <div class="hueco hueco-actualidad">
        <PuertaActualidad noticias={noticias} />
      </div>
      <div class="hueco hueco-comparar">
        <PuertaComparar opciones={opciones} preseleccion={preseleccion} />
      </div>
    </div>

    {/*
      Sin la fila «Por lo que quieres hacer».

      Eran las mismas seis verticales que la hero pregunta en la primera
      pantalla, repetidas con su cifra dos desplazamientos más abajo.
    */}
    <p class="home-revisado">
      <span>
        Catálogo revisado por última vez el{' '}
        <time datetime={stats.lastVerifiedAt}>
          {new Date(`${stats.lastVerifiedAt}T00:00:00Z`).toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' })}
        </time>
      </span>
    </p>

    <FranjaConfianza recuento={recuento} />

    <NewsletterForm variant="inline" />
  </div>

  <CompareTray />
</BaseLayout>

<style>
  .hero {
    border-block-end: 1px solid var(--line);
    background: linear-gradient(to bottom, var(--surface-sunken), transparent 85%);
    padding-block: var(--space-m);
  }

  @media (min-width: 48rem) {
    .hero {
      padding-block: var(--space-xl) var(--space-l);
    }
  }

  .hero-inner {
    display: grid;
    justify-items: center;
    gap: var(--space-m);
    text-align: center;
  }

  .hero-title {
    margin: 0;
    max-width: 18ch;
    font-size: clamp(2rem, 1.1rem + 4.2vw, 4rem);
    line-height: 1.04;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  /*
   * Seis botones, no seis enlaces.
   *
   * Tienen que parecer lo que son —la respuesta a la pregunta de arriba— y
   * poder pulsarse con el pulgar: 56 px de alto, 2×3 en un móvil de 375 px y
   * una fila en escritorio. Sin descripción ni cifra debajo: aquí sólo se elige.
   */
  .hero-verticales {
    width: 100%;
    max-width: 68rem;
  }

  .hero-verticales ul {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-2xs);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 40rem) {
    .hero-verticales ul {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 62rem) {
    .hero-verticales ul {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }
  }

  .hero-vertical {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    min-height: 56px;
    padding: 0.75rem 1rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-l);
    background: var(--surface);
    color: var(--ink-strong);
    font-size: 1.125rem;
    font-weight: 650;
    text-decoration: none;
    transition:
      border-color 140ms ease,
      color 140ms ease,
      box-shadow 140ms ease;
  }

  .hero-vertical:hover {
    border-color: var(--signal);
    color: var(--signal-strong);
    box-shadow: var(--shadow-m);
  }

  .hero-vertical:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }

  .hero-vertical-flecha {
    color: var(--ink-muted);
    font-weight: 500;
  }

  .hero-vertical:hover .hero-vertical-flecha {
    color: inherit;
  }

  .hero-buscar {
    display: grid;
    justify-items: center;
    gap: 0.4rem;
    width: 100%;
    max-width: 40rem;
  }

  .hero-buscar-intro {
    font-size: 0.9375rem;
    color: var(--ink-muted);
  }

  .hero-buscar-campo {
    display: flex;
    gap: var(--space-3xs);
    width: 100%;
    text-align: start;
  }

  .hero-buscar-campo .input {
    min-height: 48px;
  }

  .home-revisado {
    margin: 0 0 calc(var(--space-2xs) * -1);
    font-size: 0.8125rem;
    color: var(--ink-muted);
  }

  .home {
    display: grid;
    gap: var(--space-m);
    padding-block: var(--space-s) var(--space-xl);
  }

  /*
   * En movil, la primera puerta tiene que caber por encima del aviso de cookies.
   *
   * Medido a 375x812: con la cabecera anterior el titulo de la puerta quedaba a
   * 508 px y su buscador acababa en 627, con la barra de consentimiento
   * empezando en 545. Es decir, la primera visita veia el nombre de la accion y
   * no el campo donde hacerla. Se recorta el aire de arriba, no el contenido.
   */
  @media (min-width: 48rem) {
    .home {
      gap: var(--space-l);
      padding-block: var(--space-l) var(--space-xl);
    }
  }

  .puertas {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-m);
  }

  .hueco {
    display: grid;
    min-width: 0;
  }

  /*
   * La puerta del catálogo manda.
   *
   * Las tres caben en la primera pantalla, pero no pesan igual: buscar es a lo
   * que viene la mayoría, así que ocupa la columna ancha y las dos filas. Tres
   * cajas idénticas serían un índice, que es justo lo que no queremos.
   */
  @media (min-width: 62rem) {
    .puertas {
      grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr);
      grid-template-rows: auto 1fr;
      grid-template-areas:
        'buscar actualidad'
        'buscar comparar';
      align-items: start;
    }

    .hueco-buscar {
      grid-area: buscar;
    }

    .hueco-actualidad {
      grid-area: actualidad;
    }

    .hueco-comparar {
      grid-area: comparar;
    }
  }
</style>
