---
import type { Tool } from '@lib/domain/tool';
import BaseLayout from '@layouts/BaseLayout.astro';
import IntentCard from '@components/catalog/IntentCard.astro';
import ToolMention from '@components/catalog/ToolMention.astro';
import CatalogFilters from '@components/catalog/CatalogFilters.astro';
import { getToolsByCategory } from '@lib/data/catalog';
import { getCategory } from '@lib/domain/taxonomy';
import { catalogueOrder, decideFilters } from '@lib/data/category-page';
import {
  CANDIDATE_FILTERS,
  VIDEO_CAPABILITIES,
  easyToStart,
  freeNow,
  localControl,
  professional,
  talkingHead,
} from '@lib/data/video';
import { repartirBloques } from '@lib/data/category-page';
import { faqSchema, itemListSchema } from '@lib/seo/structured-data';
import { ROUTES } from '@lib/nav';

/**
 * Vídeo, construida con el método de Imagen y con otros bloques.
 *
 * En imagen casi todo el mundo viene a lo mismo: generar. En vídeo hay al menos
 * tres viajes que no se parecen —hacer un plano, poner a una persona a hablar a
 * cámara, y montar material ya grabado—, así que copiar los cinco bloques de
 * Imagen habría metido a HeyGen y a Descript en «genera vídeos gratis», donde
 * no responden a lo que se pregunta.
 *
 * De 2 herramientas a 16. Las dos que había estaban sin verificar, y una de
 * ellas, Runway, figuraba como `freemium` cuando sus 125 créditos no se
 * renuevan.
 */

const category = getCategory('video')!;
const tools = getToolsByCategory('video');

const gratis = freeNow(tools);
const faciles = easyToStart(tools).slice(0, 6);
const personas = talkingHead(tools).slice(0, 5);
const potentes = professional(tools).slice(0, 5);
const { install, technical } = localControl(tools);
const todas = catalogueOrder(tools);

/*
 * Los bloques, en orden editorial y con su motivo.
 *
 * Igual que en las demás verticales: el primero que reclama una herramienta se
 * queda su tarjeta y los siguientes la mencionan. Aquí la página pintaba 44
 * tarjetas para 16 fichas, y una misma llegaba a salir cinco veces.
 *
 * «Profesionales» se llama ahora como lo que mide, que es cuántas capacidades
 * tiene documentadas, no una calidad que no medimos.
 */
const declarados = [
  {
    id: 'gratis',
    titulo: 'Genera vídeos gratis ahora',
    lista: gratis,
    lede: 'Funcionan en el navegador y su acceso gratuito se renueva. Ojo a la diferencia entre créditos que vuelven y créditos de bienvenida.',
    motivo: (tool: Tool) =>
      tool.freePlan.creditsAmount
        ? `Acceso gratuito que se renueva: ${tool.freePlan.creditsAmount}.`
        : 'Acceso gratuito que se renueva.',
  },
  {
    id: 'faciles',
    titulo: 'Fáciles para empezar',
    lista: faciles,
    lede: 'Nada que instalar. Que sean de pago no las descalifica: la pregunta aquí es cuánto cuesta llegar al primer vídeo.',
    motivo: (tool: Tool) =>
      tool.startEffort === 'instant' ? 'Se abre y se genera, sin cuenta.' : 'Sólo hace falta una cuenta.',
  },
  {
    id: 'personas',
    titulo: 'Persona a cámara',
    lista: personas,
    lede: 'Avatares que hablan y sincronía labial: el encargo más común y el que menos se parece a «generar un vídeo».',
    motivo: (tool: Tool) =>
      tool.capabilities.includes('avatar-video') ? 'Genera un avatar que habla.' : 'Sincroniza labios sobre un vídeo.',
  },
  {
    id: 'capaces',
    titulo: 'Las que más cosas saben hacer',
    lista: potentes,
    lede: 'Con más capacidades documentadas por su fabricante, cada una con su cita. No es una nota de calidad: es cuánto sabemos de ellas con certeza.',
    motivo: (tool: Tool) => `${tool.capabilities.length} capacidades documentadas.`,
  },
  {
    id: 'local',
    titulo: 'En tu equipo',
    lista: [...install, ...technical],
    lede: 'Modelos que se ejecutan en tu máquina, sin cuotas ni cuenta. El coste se traslada a la GPU.',
    motivo: (tool: Tool) =>
      tool.startEffort === 'install' ? 'Se instala y ya; sigue pidiendo GPU.' : 'Entorno propio y descarga de pesos.',
  },
].filter((b) => b.lista.length > 0);

const bloques = repartirBloques(declarados);

const decisions = decideFilters(tools, CANDIDATE_FILTERS);
const filters = decisions.filter((d) => d.shown);
const hidden = decisions.filter((d) => !d.shown);

const conCifra = tools.filter(
  (t) => t.freePlan.creditsAmount && ['daily', 'weekly', 'monthly'].includes(t.freePlan.creditReset)
).length;

const crumbs = [
  { name: 'Inicio', path: ROUTES.home },
  { name: 'Categorías', path: ROUTES.categories },
  { name: category.name, path: ROUTES.category('video') },
];

/** Cada respuesta es un dato que esta misma página enseña. */
const faqs = [
  {
    question: '¿Qué herramientas de vídeo puedo usar gratis ahora mismo?',
    answer: `${gratis.length} de las ${tools.length} revisadas generan vídeo en el navegador con un acceso gratuito que sirve hoy: ${gratis
      .slice(0, 5)
      .map((t) => t.name)
      .join(', ')}. Quedan fuera las que sólo dan créditos de una vez y las que hay que instalar.`,
  },
  {
    question: '¿Por qué Runway no aparece en «gratis ahora»?',
    answer:
      'Porque sus 125 créditos son, en palabras de su propia página, «one-time»: se gastan y no vuelven. Eso sirve para probar, no para trabajar sin pagar, y mezclarlo con planes que se renuevan cada mes haría el bloque inútil.',
  },
  {
    question: '¿Puedo generar vídeo en mi ordenador?',
    answer: `Sí, con pesos abiertos, y el límite es la tarjeta gráfica. La variante pequeña de Wan 2.2 declara funcionar con 24 GB de memoria de vídeo; HunyuanVideo pide 60 GB a 720p. Por eso van en un bloque aparte: no es la misma oferta que abrir una web.`,
  },
];
---

<BaseLayout
  title={`IA para vídeo: ${tools.length} herramientas revisadas y qué dan gratis`}
  description={`Cuáles generan vídeo gratis hoy, cuáles sólo dan créditos que no vuelven y qué pide cada modelo local. ${tools.length} revisadas contra la página oficial de cada fabricante.`}
  crumbs={crumbs}
  schemas={[itemListSchema(tools, 'Herramientas de vídeo con IA'), faqSchema(faqs)]}
>
  <div class="page vert">
    <header class="vert-hero">
      <h1 class="vert-h1">IA para vídeo</h1>
      <p class="vert-lede">
        Qué genera cada herramienta, qué te deja hacer sin pagar y cuánto cuesta empezar.{' '}
        <span class="vert-lede-method">
          Sin puntuaciones: lo que hay debajo de cada tarjeta es lo que dice la página
          oficial del fabricante.
        </span>
      </p>
      <nav class="vert-jump" aria-label="Ir a un bloque">
        {bloques.map((b) => <a href={`#${b.id}`}>{b.titulo}</a>)}
        <a href="#todas">Todas</a>
      </nav>
    </header>

    <!-- ------------------------------------------------------------------ -->
    {bloques.map((bloque) => (
      <section class="vert-block" id={bloque.id} aria-labelledby={`${bloque.id}-h`}>
        <div class="vert-block-head">
          <h2 class="vert-h2" id={`${bloque.id}-h`}>{bloque.titulo}</h2>
          <p class="vert-block-lede">{bloque.lede}</p>
        </div>

        {bloque.completas.length > 0 && (
          <ul class="vert-grid">
            {bloque.completas.map((tool) => (
              <li><IntentCard tool={tool} capabilityOrder={VIDEO_CAPABILITIES} /></li>
            ))}
          </ul>
        )}

        {bloque.compactas.length > 0 && (
          <>
            <p class="vert-tambien">
              También responden a esto, con su ficha completa en otro bloque:
            </p>
            <ul class="vert-menciones">
              {bloque.compactas.map((tool) => (
                <li>
                  <ToolMention tool={tool} motivo={bloque.motivo(tool)} ancla={bloque.anclas.get(tool.slug)} />
                </li>
              ))}
            </ul>
          </>
        )}
      </section>
    ))}

    <!-- ------------------------------------------------------------------ -->
    <section class="vert-block" id="todas" aria-labelledby="todas-h">
      <div class="vert-block-head">
        <h2 class="vert-h2" id="todas-h">Todas las herramientas de vídeo</h2>
        <p class="vert-block-lede">
          Las {tools.length} revisadas, con filtros que se combinan. {conCifra} publican
          cuánto dan y cada cuánto.
        </p>
      </div>

      <CatalogFilters
        tools={todas}
        shown={filters}
        hidden={hidden}
        capabilityOrder={VIDEO_CAPABILITIES}
        noun="vídeo"
      />
    </section>

    <p class="vert-tail">
      ¿Falta alguna, o hay un dato que ya no es cierto?
      <a href={ROUTES.submit}>Cuéntanoslo</a> — cada ficha lleva la fecha en que se
      comprobó y el enlace a la página que lo dice.
    </p>
  </div>
</BaseLayout>
