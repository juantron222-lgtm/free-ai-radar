---
import BaseLayout from '@layouts/BaseLayout.astro';
import NewsletterForm from '@components/marketing/NewsletterForm.astro';
import { faqSchema } from '@lib/seo/structured-data';
import { ROUTES } from '@lib/nav';

/**
 * Radar Pro todavía no se puede comprar, así que esta página no lo vende.
 *
 * Lo que había aquí era un comparador de tres planes con botón de suscripción,
 * y encima un aviso que decía «Modo demostración. Stripe no está configurado
 * en este entorno» y remitía a `docs/deployment-guide.md`. Es decir: la página
 * enseñaba precios, ofrecía un checkout que no cobra y explicaba al visitante
 * cómo arreglar nuestro despliegue.
 *
 * La arquitectura de facturación se queda donde está —`src/lib/billing`, la
 * ruta de checkout, el portal— porque servirá cuando esto exista. Lo que se
 * retira es la venta: no hay precios, no hay botón y no hay flujo simulado.
 */

const crumbs = [
  { name: 'Inicio', path: ROUTES.home },
  { name: 'Radar Pro', path: ROUTES.pricing },
];

const faqs = [
  {
    question: '¿Se puede contratar Radar Pro ahora mismo?',
    answer:
      'No. Todavía no existe como producto que se pueda pagar, así que no publicamos precios ni botón de suscripción. Cuando exista, se anunciará en el boletín y en la página de cambios.',
  },
  {
    question: '¿Qué parte de Free AI Radar es de pago?',
    answer:
      'Ninguna. Todas las fichas, la búsqueda, los filtros y el comparador son gratuitos y van a seguir siéndolo. Lo que algún día se cobrará es la inmediatez —enterarse el mismo día de que un plan gratuito ha cambiado—, no el contenido.',
  },
  {
    question: '¿Pagar cambiaría lo que veo del catálogo?',
    answer:
      'No. Las fichas, los veredictos y el orden de las listas son los mismos para todo el mundo, y no se venden ni se ajustan por patrocinio.',
  },
];
---

<BaseLayout
  title="Radar Pro: todavía no se puede contratar"
  description="Radar Pro será el aviso inmediato cuando un plan gratuito cambie. Todavía no existe como producto de pago, así que no publicamos precios ni botón de suscripción."
  crumbs={crumbs}
  noindex
  schemas={[faqSchema(faqs)]}
>
  <div class="page pricing">
    <header class="pricing-head">
      <p class="eyebrow">Radar Pro</p>
      <h1 class="pricing-h1">Todavía no se puede contratar</h1>
      <p class="pricing-lede">
        La idea es sencilla: enterarte <em>el día</em> que una herramienta recorta su plan
        gratuito, empieza a pedir tarjeta o cambia su licencia. Hoy eso no existe como
        producto de pago, así que aquí no hay precios ni botón de suscripción.
      </p>
    </header>

    <section class="pricing-honest card" aria-labelledby="honest-title">
      <h2 id="honest-title">Qué hay hoy y qué no</h2>
      <ul class="pricing-list">
        <li>
          <strong>El contenido es gratis y seguirá siéndolo.</strong> Fichas, búsqueda,
          filtros y comparador, sin cuenta y sin pagar.
        </li>
        <li>
          <strong>Los avisos automáticos aún no funcionan.</strong> Mientras no existan, no
          los ofrecemos ni decimos que están activos.
        </li>
        <li>
          <strong>No hay cobro simulado.</strong> Preferimos no tener botón a tener uno que
          no cobra.
        </li>
      </ul>
    </section>

    <section class="pricing-wait" aria-labelledby="wait-title">
      <h2 id="wait-title">Si quieres enterarte cuando exista</h2>
      <p>
        Lo contaremos en el boletín, junto a los cambios que detectemos en los planes
        gratuitos. Es el mismo correo, sin lista aparte.
      </p>
      <NewsletterForm />
    </section>

    <section class="pricing-promise" aria-labelledby="promise-title">
      <h2 id="promise-title">Lo que el dinero no compra</h2>
      <p>
        Ni una suscripción ni un patrocinio cambian un veredicto o el orden de una
        comparativa. Esa separación es el activo del proyecto: en cuanto se rompe, el sitio
        deja de valer para nada. Está escrita en la
        <a href={ROUTES.editorialPolicy}>política editorial</a> y se aplica sin excepciones.
      </p>
    </section>

    <section class="pricing-faq" aria-labelledby="faq-title">
      <h2 id="faq-title">Preguntas</h2>
      <dl>
        {faqs.map((faq) => (
          <div class="pricing-faq-item">
            <dt>{faq.question}</dt>
            <dd>{faq.answer}</dd>
          </div>
        ))}
      </dl>
    </section>
  </div>
</BaseLayout>

<style>
  .pricing {
    padding-block: var(--space-m) var(--space-xl);
    display: grid;
    gap: var(--space-l);
  }

  .pricing-head {
    max-width: 46rem;
  }

  .pricing-honest {
    padding: var(--space-s);
    max-width: 46rem;
  }

  .pricing-list {
    margin: var(--space-2xs) 0 0;
    padding-inline-start: 1.1rem;
    display: grid;
    gap: var(--space-2xs);
    line-height: 1.55;
  }

  .pricing-wait {
    max-width: 46rem;
    display: grid;
    gap: var(--space-2xs);
  }

  .pricing-h1 {
    font-size: clamp(1.75rem, 1.4rem + 1.7vw, 2.75rem);
    margin-block: 0.35rem var(--space-2xs);
  }

  .pricing-lede {
    margin: 0;
    color: var(--ink-muted);
    font-size: 1.0625rem;
  }

  .pricing-notice {
    margin: 0;
    padding: var(--space-xs) var(--space-s);
    border-radius: var(--radius-m);
    background: var(--info-soft);
    border: 1px solid var(--info-line);
    font-size: 0.875rem;
  }

  .pricing-notice code {
    font-family: var(--font-mono);
    font-size: 0.92em;
  }

  .plans {
    display: grid;
    gap: var(--space-s);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
    align-items: start;
  }

  .plan {
    position: relative;
    padding: var(--space-s);
    display: grid;
    gap: var(--space-2xs);
    align-content: start;
    height: 100%;
  }

  .plan-highlight {
    border-color: var(--signal);
    border-width: 2px;
  }

  .plan-badge {
    position: absolute;
    top: -0.7rem;
    inset-inline-start: var(--space-s);
    padding: 0.15rem 0.6rem;
    border-radius: var(--radius-full);
    background: var(--signal);
    color: var(--on-signal);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.03em;
  }

  .plan-name {
    font-size: 1.0625rem;
    margin: 0;
  }

  .plan-price {
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    margin: 0.15rem 0 0;
    color: var(--ink-strong);
    font-variant-numeric: tabular-nums;
  }

  .plan-tagline {
    margin: 0.15rem 0 var(--space-2xs);
    font-size: 0.875rem;
    color: var(--ink-muted);
  }

  .plan-features {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.35rem;
    font-size: 0.875rem;
  }

  .plan-features li {
    position: relative;
    padding-inline-start: 1.4rem;
    color: var(--ink-muted);
  }

  .plan-features li::before {
    content: '';
    position: absolute;
    inset-inline-start: 0;
    inset-block-start: 0.45em;
    width: 0.75rem;
    height: 0.4rem;
    border-inline-start: 2px solid var(--signal);
    border-block-end: 2px solid var(--signal);
    transform: rotate(-45deg);
  }

  .plan-limit,
  .plan-note {
    margin: 0;
    font-size: 0.75rem;
    color: var(--ink-subtle);
  }

  .plan-cta {
    width: 100%;
    margin-block-start: var(--space-2xs);
  }

  .pricing-result {
    margin: 0;
    padding: 0.65rem 0.85rem;
    border-radius: var(--radius-m);
    background: var(--alert-soft);
    border: 1px solid var(--alert-line);
    color: var(--alert);
    font-size: 0.875rem;
  }

  .pricing-promise,
  .pricing-faq {
    max-width: var(--measure);
  }

  .pricing-promise h2,
  .pricing-faq h2 {
    font-size: 1.35rem;
    margin-block-end: var(--space-2xs);
  }

  .pricing-promise p {
    margin: 0;
    color: var(--ink-muted);
  }

  .pricing-promise a {
    color: var(--signal);
  }

  .pricing-faq dl {
    margin: 0;
    display: grid;
    gap: var(--space-s);
  }

  .pricing-faq-item dt {
    font-weight: 650;
    color: var(--ink-strong);
    margin-block-end: 0.2rem;
  }

  .pricing-faq-item dd {
    margin: 0;
    color: var(--ink-muted);
    font-size: 0.9375rem;
  }
</style>

<script>
  const result = document.querySelector<HTMLElement>('[data-checkout-result]');

  for (const form of Array.from(
    document.querySelectorAll<HTMLFormElement>('[data-checkout-form]')
  )) {
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
      const original = button.textContent;
      button.disabled = true;
      button.textContent = 'Abriendo el pago…';

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: new FormData(form),
        });
        const payload = (await response.json()) as {
          ok: boolean;
          message: string;
          data?: { url: string };
        };

        if (payload.ok && payload.data?.url) {
          window.location.assign(payload.data.url);
          return;
        }

        if (result) {
          result.hidden = false;
          result.textContent = payload.message;
        }
      } catch {
        if (result) {
          result.hidden = false;
          result.textContent = 'No hemos podido conectar con la pasarela de pago.';
        }
      } finally {
        button.disabled = false;
        button.textContent = original;
      }
    });
  }
</script>
