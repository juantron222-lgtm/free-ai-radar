---
import BaseLayout from '@layouts/BaseLayout.astro';
import CabeceraPagina from '@components/site/CabeceraPagina.astro';
import { getAllTools, getTool } from '@lib/data/catalog';
import { agruparFilas, filasDe } from '@lib/data/comparador';
import { parecidas } from '@lib/data/afinidad';
import { comparacionesVigentes, urlDe } from '@lib/data/comparaciones';
import { VERTICALES } from '@lib/data/home';
import { normalize } from '@lib/search/index';
import registroDeLogos from '@/data/logos.json';
import { ROUTES } from '@lib/nav';

export const prerender = false;

const MAX = 4;
const MIN_INDEXABLE = 2;

/*
 * `?t=a,b` y `?t=a&t=b` son la misma petición.
 *
 * La forma con comas es la que produce esta página y la que se comparte. La
 * repetida es la que produce un formulario con dos desplegables llamados `t`,
 * que es como se empieza una comparación desde la portada sin JavaScript.
 * Aceptar las dos evita tener que elegir entre una URL legible y un formulario
 * que funcione sin scripts.
 */
const pedidas = [...new Set(
  Astro.url.searchParams
    .getAll('t')
    .flatMap((valor) => valor.split(','))
    .map((s) => s.trim())
    .filter(Boolean)
)];
const requested = pedidas.slice(0, MAX);

/*
 * Pedir cinco comparaba cuatro sin decirlo: la quinta desaparecía. Ahora se
 * dice cuáles se han quedado fuera.
 */
const fueraDelLimite = pedidas.slice(MAX);

const tools = requested.map((slug) => getTool(slug)).filter((t) => t !== undefined);
const missing = requested.filter((slug) => !getTool(slug));
const hasComparison = tools.length >= MIN_INDEXABLE;

const allTools = getAllTools();
/*
 * «Añadir otra» proponía las doce primeras del abecedario, y con cuatro ya
 * elegidas enlazaba a la misma comparación, porque la quinta se recortaba.
 * Ahora propone las que hacen la misma tarea que las que ya están, y sólo si
 * cabe otra.
 */
const suggestions =
  tools.length >= MIN_INDEXABLE && tools.length < MAX
    ? (() => {
        const estrictas = parecidas(tools, allTools, 8, requested);
        return estrictas.length ? estrictas : parecidas(tools, allTools, 8, requested, true);
      })()
    : [];
const utiles = comparacionesVigentes();

const crumbs = [
  { name: 'Inicio', path: ROUTES.home },
  { name: 'Comparar', path: ROUTES.compare },
];

const title = hasComparison
  ? `${tools.map((t) => t.name).join(' vs ')}: ¿cuál es mejor gratis?`
  : 'Comparar herramientas de IA y lo que dan gratis';

const description = hasComparison
  ? `Comparativa lado a lado de ${tools.map((t) => t.name).join(', ')}: límites del plan gratuito, tarjeta, marca de agua, uso comercial, licencia y privacidad.`
  : 'Enfrenta hasta cuatro herramientas de IA y compara sus planes gratuitos condición por condición: tarjeta, marca de agua, uso comercial, licencia y privacidad.';

/**
 * A comparison URL is only indexable when it actually holds a comparison.
 * The empty picker is a tool, not a document, and two-tool permutations are
 * the ones with genuine search demand.
 */
const noindex = !hasComparison;

const filas = hasComparison ? filasDe(tools) : [];

const grupos = agruparFilas(filas);
const distintas = grupos.diferencias;
const comparables = grupos.diferencias.length + grupos.faltanDatos.length + grupos.coincidencias.length;

/*
 * Por defecto, sólo lo que separa.
 *
 * El interruptor existía, pero arrancaba apagado: una comparación de ChatGPT y
 * Claude enseñaba diecisiete filas para cinco diferencias. Ahora arranca
 * encendido siempre que haya algo que esconder y algo que enseñar.
 */
const soloDiferencias = distintas.length > 0 && grupos.coincidencias.length > 0;

/* Los grupos de la tabla, en el orden en que se leen. */
const cuerpos = [
  { clase: undefined, titulo: null, filas: [...grupos.diferencias, ...grupos.faltanDatos, ...grupos.coincidencias] },
  { clase: 'compare-contexto', titulo: 'Con más detalle', filas: grupos.contexto },
].filter((cuerpo) => cuerpo.filas.length > 0);

/*
 * Un resumen que apunta a filas, no a un ganador.
 *
 * «La mejor es X» es exactamente lo que se retiró de esta página: una nota
 * disfrazada de frase. Lo que sí ayuda es decir dónde mirar, y que cada cosa
 * que se afirme se pueda comprobar dos centímetros más abajo.
 */
const resumen = distintas.slice(0, 3).map((f) => f.row.label);

/** El índice mínimo del selector: nombre para buscar, vertical para filtrar. */
const VERTICAL_DE = new Map<string, string>();
for (const v of VERTICALES) for (const s of v.slugs) VERTICAL_DE.set(s, v.id);

const logos = registroDeLogos as Record<string, { ruta: string }>;

const picker = allTools.map((t) => ({
  slug: t.slug,
  name: t.name,
  n: normalize(`${t.name} ${t.alternativeNames.join(' ')}`),
  v: VERTICAL_DE.get(t.categorySlug) ?? 'otras',
}));

const FILTROS_VERTICAL = [
  { id: 'todas', nombre: 'Todas' },
  { id: 'imagen', nombre: 'Imagen' },
  { id: 'video', nombre: 'Vídeo' },
  { id: 'audio', nombre: 'Audio' },
  { id: 'codigo', nombre: 'Código' },
  { id: 'agentes', nombre: 'Agentes' },
  { id: 'modelos', nombre: 'Modelos' },
  { id: 'otras', nombre: 'Otras' },
];
---

<BaseLayout
  title={title}
  description={description}
  crumbs={crumbs}
  migasEnCabecera
  noindex={noindex}
  canonicalQuery={['t']}
>
  <CabeceraPagina
    titulo={hasComparison ? tools.map((t) => t.name).join(' vs ') : 'Comparar'}
    crumbs={crumbs}
  >
    <p class="cabecera-entradilla">
      {hasComparison
        ? 'Los mismos datos para todas, en las mismas filas. Sin ganadores prefabricados y sin nota: la fila que decide es la que a ti te importe.'
        : 'Elige entre dos y cuatro herramientas y las enfrentamos condición por condición. La URL resultante se puede compartir.'}
    </p>
  </CabeceraPagina>

  <div class="page compare-page">

    {missing.length > 0 && (
      <p class="compare-missing" role="status">
        No tenemos ficha de: {missing.join(', ')}. Se han quitado de la comparación.
      </p>
    )}

    {fueraDelLimite.length > 0 && (
      <p class="compare-missing" role="status">
        Se comparan como mucho {MAX} a la vez. Se ha{fueraDelLimite.length === 1 ? '' : 'n'} quedado
        fuera: {fueraDelLimite.map((slug) => getTool(slug)?.name ?? slug).join(', ')}. Quita una de la
        tabla para meterla.
      </p>
    )}

    {hasComparison ? (
      <>
        <div class="compare-toolbar">
          <p class="compare-summary">
            {distintas.length === 0 ? (
              grupos.faltanDatos.length === 0 ? (
                <>Estas {tools.length} coinciden en las {comparables} filas que comparamos.</>
              ) : (
                <>
                  En lo que sabemos de ellas no se diferencian. En {grupos.faltanDatos.length} de{' '}
                  {comparables} filas falta algún dato para saberlo.
                </>
              )
            ) : (
              <>
                Se diferencian en <strong>{distintas.length}</strong> de {comparables} filas.
                {resumen.length > 0 && <> Las primeras que las separan: {resumen.join(', ')}.</>}
                {grupos.faltanDatos.length > 0 && (
                  <> En {grupos.faltanDatos.length} falta algún dato para saber si se diferencian.</>
                )}
                {grupos.coincidencias.length > 0 && <> En {grupos.coincidencias.length} dicen lo mismo.</>}
              </>
            )}
          </p>
          {grupos.coincidencias.length > 0 && distintas.length > 0 && (
            <label class="compare-only-diff">
              <input type="checkbox" id="solo-diferencias" checked />
              <span>Mostrar sólo diferencias</span>
            </label>
          )}
        </div>

        <div class="table-scroll compare-scroll">
          <table
            class:list={['data-table', 'compare-table', { 'solo-diferencias': soloDiferencias }]}
            id="compare-table"
            role="table"
          >
            <caption class="sr-only">
              Comparativa de {tools.map((t) => t.name).join(', ')}
            </caption>
            <thead role="rowgroup">
              <tr role="row">
                <th scope="col" class="compare-corner" role="columnheader">Condición</th>
                {tools.map((tool) => (
                  <th scope="col" role="columnheader">
                    <a href={ROUTES.tool(tool.slug)} class="compare-tool-name">{tool.name}</a>
                  </th>
                ))}
              </tr>
            </thead>
            {cuerpos.map((cuerpo) => (
            <tbody class={cuerpo.clase} role="rowgroup">
              {cuerpo.titulo && (
                <tr class="compare-grupo" role="row">
                  <th scope="colgroup" colspan={tools.length + 1} role="columnheader">{cuerpo.titulo}</th>
                </tr>
              )}
              {cuerpo.filas.map(({ row, celdas, iguales, faltanDatos }) => (
                <tr data-igual={iguales ? 'si' : faltanDatos ? 'faltan' : 'no'} role="row">
                  <th scope="row" role="rowheader">
                    {row.label}
                    {faltanDatos && <span class="compare-faltan">Faltan datos</span>}
                  </th>
                  {celdas.map((celda, i) => (
                    <td role="cell" data-herramienta={tools[i]?.name}>
                      {celda.tipo === 'lista' && (
                        <ul class="compare-list">
                          {celda.items.slice(0, 4).map((item) => <li>{item}</li>)}
                        </ul>
                      )}
                      {celda.tipo === 'valor' && (
                        <span
                          class={
                            row.better && row.better(celda.texto)
                              ? 'compare-value is-better'
                              : 'compare-value'
                          }
                          title={celda.nota}
                        >
                          {celda.texto}
                          {celda.matiz && <span class="compare-matiz">{celda.matiz}</span>}
                        </span>
                      )}
                      {celda.tipo === 'ausente' && (
                        <span class="compare-absent" title={celda.nota}>
                          {celda.texto}
                          {celda.nota && <span class="sr-only"> — {celda.nota}</span>}
                        </span>
                      )}
                    </td>
                  ))}
                </tr>
              ))}
            </tbody>
            ))}
          </table>
        </div>

        <p class="compare-legend">
          Cuando falta un dato, la tabla dice por qué. <strong>Sin comprobar</strong> es deuda
          nuestra: todavía no hemos abierto la fuente oficial. <strong>El fabricante no lo
          publica</strong> es lo contrario: la abrimos y no lo dice, y eso es información sobre
          el producto. <strong>Sin analizar</strong> es un hueco de redacción nuestro, y{' '}
          <strong>No aplica</strong> una fila que no tiene sentido para esa clase de herramienta.
          Pasa el ratón por encima para ver qué buscábamos.
        </p>

        <div class="compare-actions">
          <a class="btn btn-secondary btn-sm" href={ROUTES.compare}>Empezar de nuevo</a>
          <button type="button" class="btn btn-ghost btn-sm" data-copy-link>Copiar enlace</button>
        </div>
      </>
    ) : (
      <>
        <section class="compare-useful" aria-labelledby="useful-title">
          <h2 id="useful-title" class="compare-picker-title">Comparaciones útiles</h2>
          <p class="hint compare-useful-lede">
            Diez preguntas que se repiten, ya montadas. Ninguna sale de un ranking: cada una está
            escrita a mano y dice para qué sirve.
          </p>
          <ul class="compare-useful-list">
            {utiles.map((c) => (
              <li class="compare-useful-item">
                <a class="compare-useful-link" href={urlDe(c)}>
                  <span class="compare-useful-name">{c.titulo}</span>
                  <span class="compare-useful-tools">
                    {c.slugs.map((s) => getTool(s)?.name ?? s).join(' · ')}
                  </span>
                </a>
                <p class="compare-useful-why">{c.motivo}</p>
              </li>
            ))}
          </ul>
        </section>

        <section class="compare-picker" aria-labelledby="picker-title">
          <h2 id="picker-title" class="compare-picker-title">O móntala tú</h2>
          <form method="get" class="compare-form" id="compare-form">
            {/*
              La entrada eran noventa y cuatro casillas seguidas.

              Para elegir dos había que leerlas todas, y no había forma de
              llegar a una por su nombre: sólo recorrer el muro. Se queda el
              mismo formulario —así sigue funcionando sin JavaScript y la URL
              resultante sigue siendo la misma— y encima van un buscador y un
              filtro por vertical que deciden cuáles se ven.
            */}
            <div class="compare-find">
              <label class="compare-find-label" for="compare-q">Busca por nombre</label>
              <input
                type="search"
                id="compare-q"
                class="compare-find-input"
                placeholder="Lovable, Whisper, Kling…"
                autocomplete="off"
              />
            </div>

            <fieldset class="compare-verticals">
              <legend class="compare-find-label">Filtrar por vertical</legend>
              <div class="compare-vertical-row">
                {FILTROS_VERTICAL.map((v, i) => (
                  <label class="filter-chip">
                    <input
                      type="radio"
                      name="compare-vertical"
                      value={v.id}
                      class="sr-only"
                      checked={i === 0}
                      data-compare-vertical
                    />
                    {v.nombre}
                  </label>
                ))}
              </div>
            </fieldset>

            <div class="compare-chosen" id="compare-chosen" hidden>
              <p class="compare-find-label">Elegidas (<span data-compare-picked>0</span> de 4)</p>
              <ul class="compare-chosen-list" id="compare-chosen-list"></ul>
            </div>

            <fieldset>
              <legend class="compare-find-label">Herramientas</legend>
              <div class="compare-options" id="compare-options">
                {allTools.map((tool) => (
                  <label class="filter-chip" data-compare-option data-slug={tool.slug}>
                    <input type="checkbox" name="t" value={tool.slug} class="sr-only" data-compare-pick />
                    <span class="filter-chip-tick" aria-hidden="true">
                      <svg width="11" height="11" viewBox="0 0 12 12"><path d="M2 6.4 4.6 9 10 3.2" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </span>
                    {/*
                      Un logo pequeño, sólo en el selector.

                      Aquí ayuda a encontrar una marca entre noventa y cuatro
                      pastillas. En la tabla no entra: allí lo que hay que
                      comparar son los datos, y un logo por columna competiría
                      con ellos sin añadir nada que la cabecera no diga ya.
                    */}
                    {logos[tool.slug] && (
                      <img class="compare-option-logo" src={logos[tool.slug]!.ruta} alt="" width="16" height="16" loading="lazy" decoding="async" />
                    )}
                    {tool.name}
                  </label>
                ))}
              </div>
              <p class="hint" id="compare-nomatch" hidden>
                Ninguna herramienta se llama así. Prueba con otro nombre o quita el filtro de vertical.
              </p>
            </fieldset>

            <button type="submit" class="btn btn-primary" data-compare-submit disabled>
              Comparar (<span data-compare-picked>0</span>)
            </button>
            <p class="hint">Máximo cuatro a la vez: más columnas dejan de ser legibles.</p>
          </form>
        </section>
      </>
    )}

    {hasComparison && suggestions.length > 0 && (
      <section class="compare-more" aria-labelledby="more-title">
        <h2 id="more-title" class="compare-more-title">Añadir otra que hace lo mismo</h2>
        <ul class="compare-more-list">
          {suggestions.slice(0, 8).map((tool) => (
            <li>
              <a
                class="filter-chip"
                href={`${ROUTES.compare}?t=${[...requested, tool.slug].slice(0, MAX).join(',')}`}
              >
                {tool.name}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}
  </div>

  <script is:inline type="application/json" id="compare-index" set:html={JSON.stringify(picker)} />
</BaseLayout>

<style>
  .compare-page {
    padding-block: var(--space-m) var(--space-xl);
    display: grid;
    gap: var(--space-m);
  }

  /*
   * El grupo de prosa, separado y en tono de lectura.
   *
   * No compite con las condiciones: va después, con su propio rótulo, y el
   * texto baja de peso para que se lea como contexto y no como veredicto.
   */
  .compare-grupo th {
    padding-block: var(--space-s) var(--space-3xs);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--ink-muted);
    background: var(--surface-sunken);
  }

  .compare-contexto td,
  .compare-contexto th[scope='row'] {
    font-size: 0.875rem;
    color: var(--ink-muted);
  }

  .compare-contexto .compare-value {
    font-weight: 400;
    color: var(--ink);
  }


  .compare-missing {
    margin: 0;
    padding: 0.6rem 0.8rem;
    border-radius: var(--radius-m);
    background: var(--warn-soft);
    border: 1px solid var(--warn-line);
    color: var(--warn);
    font-size: 0.875rem;
  }

  .compare-toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2xs) var(--space-s);
  }

  .compare-faltan {
    display: block;
    margin-top: 0.125rem;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--ink-subtle);
  }

  .compare-summary {
    margin: 0;
    font-size: 0.9375rem;
    color: var(--ink-muted);
    max-width: 60ch;
  }

  .compare-summary strong {
    color: var(--ink-strong);
  }

  .compare-only-diff {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.875rem;
    color: var(--ink-strong);
    white-space: nowrap;
    cursor: pointer;
  }

  .compare-table {
    min-width: 46rem;
  }

  .compare-table thead th {
    vertical-align: bottom;
    position: sticky;
    top: 0;
    z-index: 1;
  }

  .compare-corner {
    min-width: 11rem;
  }

  .compare-tool-name {
    display: block;
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--ink-strong);
    text-transform: none;
    letter-spacing: 0;
    margin-block-end: 0.15rem;
  }

  .compare-value {
    font-weight: 550;
  }

  /* Advantage is marked with a rule and weight as well as colour. */
  .is-better {
    color: var(--signal);
    font-weight: 700;
    box-shadow: inset 0 -2px 0 var(--signal-line);
  }

  .compare-list {
    margin: 0;
    padding-inline-start: 1.1em;
    font-size: 0.8125rem;
    color: var(--ink-muted);
    display: grid;
    gap: 0.15rem;
  }

  /*
   * Una ausencia se escribe, pero no compite con un dato.
   *
   * En cursiva y en tinta apagada: se lee, se entiende que no es una respuesta,
   * y sobre todo no se confunde con «no tiene pegas» —que es justo lo que
   * parecía el guion en la fila «En contra».
   */
  /*
   * El matiz de alcance, pegado al valor que califica.
   *
   * No puede ir en un `title` y nada más: quien mira la tabla en un móvil no
   * tiene ratón con el que descubrirlo, y lo que califica es justo lo que se
   * lee como una promesa.
   */
  .compare-matiz {
    display: block;
    font-weight: 400;
    font-size: 0.75rem;
    font-style: italic;
    color: var(--ink-subtle);
  }

  .compare-absent {
    font-style: italic;
    font-size: 0.8125rem;
    color: var(--ink-subtle);
  }

  .compare-legend {
    margin: 0;
    font-size: 0.8125rem;
    line-height: 1.6;
    color: var(--ink-muted);
    max-width: 72ch;
  }

  .compare-legend strong {
    font-style: italic;
    font-weight: 650;
    color: var(--ink-strong);
  }

  /* El interruptor sólo esconde; no reordena ni recalcula nada. */
  .compare-table.solo-diferencias tbody tr[data-igual='si'] {
    display: none;
  }

  .compare-actions {
    display: flex;
    gap: var(--space-2xs);
    flex-wrap: wrap;
  }

  .compare-picker-title,
  .compare-more-title {
    font-size: 1.125rem;
    margin-block-end: var(--space-2xs);
  }

  .compare-useful-lede {
    margin-block-end: var(--space-s);
    max-width: 62ch;
  }

  .compare-useful-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
    gap: var(--space-xs);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .compare-useful-item {
    display: grid;
    gap: 0.3rem;
    padding: var(--space-xs);
    border: 1px solid var(--line);
    border-radius: var(--radius-m);
    background: var(--surface);
  }

  .compare-useful-link {
    text-decoration: none;
    display: grid;
    gap: 0.15rem;
  }

  .compare-useful-name {
    font-weight: 650;
    color: var(--ink-strong);
  }

  .compare-useful-link:hover .compare-useful-name,
  .compare-useful-link:focus-visible .compare-useful-name {
    text-decoration: underline;
  }

  .compare-useful-tools {
    font-size: 0.8125rem;
    color: var(--ink-subtle);
  }

  .compare-useful-why {
    margin: 0;
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--ink-muted);
  }

  .compare-form {
    display: grid;
    gap: var(--space-s);
    justify-items: start;
  }

  .compare-form fieldset {
    border: 0;
    margin: 0;
    padding: 0;
    min-width: 0;
    width: 100%;
  }

  .compare-find {
    width: 100%;
    max-width: 26rem;
  }

  .compare-find-label {
    display: block;
    margin: 0 0 0.3rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--ink-muted);
    padding: 0;
  }

  .compare-find-input {
    width: 100%;
    padding: 0.55rem 0.7rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-m);
    background: var(--surface);
    color: var(--ink-strong);
    font: inherit;
    font-size: 0.9375rem;
  }

  .compare-option-logo {
    flex: none;
    width: 1rem;
    height: 1rem;
    object-fit: contain;
    border-radius: 3px;
  }

  .compare-vertical-row,
  .compare-options,
  .compare-more-list,
  .compare-chosen-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .compare-chosen {
    width: 100%;
  }

  .compare-chosen-remove {
    background: none;
    border: 0;
    padding: 0 0 0 0.35rem;
    color: inherit;
    font: inherit;
    cursor: pointer;
  }

  .compare-options {
    max-height: 16rem;
    overflow-y: auto;
    padding: 0.15rem;
  }

  .compare-more-list a {
    text-decoration: none;
  }

  @media (max-width: 30rem) {
    .compare-toolbar {
      flex-direction: column;
      align-items: flex-start;
    }
  }

  /*
   * En móvil, una condición debajo de otra.
   *
   * La tabla tenía un ancho mínimo de 46rem y en 375 px se desplazaba de lado:
   * para comparar dos párrafos había que arrastrar la tabla y perder de vista la
   * primera columna. Apilada, cada condición lleva su nombre arriba y cada valor
   * el nombre de su herramienta delante, así que se lee de arriba abajo sin
   * perder a quién pertenece cada dato. Los roles de tabla se declaran en el
   * marcado para que el cambio de `display` no se lleve la semántica.
   *
   * Va al final de la hoja: más arriba, la regla general del ancho mínimo lo
   * pisaba y la tabla apilada seguía midiendo 46rem.
   */
  @media (max-width: 47.99rem) {
    .compare-scroll {
      overflow: visible;
    }

    .compare-table {
      min-width: 0;
    }

    .compare-table,
    .compare-table tbody,
    .compare-table tr,
    .compare-table th,
    .compare-table td {
      display: block;
    }

    .compare-table thead {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }

    .compare-table tbody tr {
      padding: var(--space-2xs) var(--space-s);
      border-block-end: 1px solid var(--line);
    }

    .compare-table.solo-diferencias tbody tr[data-igual='si'] {
      display: none;
    }

    .compare-table tbody th[scope='row'] {
      padding: 0 0 0.35rem;
      border: 0;
      font-size: 0.9375rem;
      color: var(--ink-strong);
    }

    .compare-table td {
      display: grid;
      grid-template-columns: minmax(6.5rem, 34%) minmax(0, 1fr);
      gap: 0.5rem;
      padding: 0.3rem 0;
      border: 0;
    }

    .compare-table td::before {
      content: attr(data-herramienta);
      font-size: 0.8125rem;
      font-weight: 600;
      color: var(--ink-muted);
    }

    .compare-grupo th {
      padding: var(--space-s) var(--space-s) var(--space-3xs);
    }

    /*
     * La prosa, con el nombre encima y no al lado.
     *
     * «Qué te dan gratis», «Límites», «En contra» y el veredicto son párrafos
     * y listas: con la herramienta en la columna de la izquierda se quedaban
     * en media pantalla, a cuatro o cinco palabras por línea. Las condiciones
     * cortas de arriba siguen en dos columnas, que es donde se comparan de un
     * vistazo.
     */
    .compare-contexto td {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.15rem;
      padding-block: 0.45rem;
    }

    .compare-contexto td .compare-list {
      padding-inline-start: 0;
    }
  }
</style>

<script>
  const MAX = 4;
  const picks = Array.from(document.querySelectorAll<HTMLInputElement>('[data-compare-pick]'));
  const submits = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-compare-submit]'));
  const counters = Array.from(document.querySelectorAll<HTMLElement>('[data-compare-picked]'));
  const options = Array.from(document.querySelectorAll<HTMLElement>('[data-compare-option]'));
  const queryInput = document.getElementById('compare-q') as HTMLInputElement | null;
  const verticalInputs = Array.from(
    document.querySelectorAll<HTMLInputElement>('[data-compare-vertical]')
  );
  const nomatch = document.getElementById('compare-nomatch');
  const chosenBox = document.getElementById('compare-chosen');
  const chosenList = document.getElementById('compare-chosen-list');
  const indexNode = document.getElementById('compare-index');

  interface PickerEntry { slug: string; name: string; n: string; v: string }
  const entries: PickerEntry[] = indexNode?.textContent ? JSON.parse(indexNode.textContent) : [];
  const bySlug = new Map(entries.map((e) => [e.slug, e]));
  const optionBySlug = new Map(options.map((o) => [o.dataset['slug']!, o]));

  /** El mismo saneado que usa el índice del buscador, para que «vídeo» encuentre «video». */
  function normalizar(input: string): string {
    return input
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .toLowerCase()
      .replace(/[^a-z0-9\s]/g, ' ')
      .replace(/\s+/g, ' ')
      .trim();
  }

  function seleccionadas(): HTMLInputElement[] {
    return picks.filter((p) => p.checked);
  }

  function pintarElegidas() {
    if (!chosenBox || !chosenList) return;
    const elegidas = seleccionadas();
    chosenBox.hidden = elegidas.length === 0;
    chosenList.replaceChildren(
      ...elegidas.map((input) => {
        const li = document.createElement('li');
        li.className = 'filter-chip';
        li.textContent = bySlug.get(input.value)?.name ?? input.value;
        const quitar = document.createElement('button');
        quitar.type = 'button';
        quitar.className = 'compare-chosen-remove';
        quitar.textContent = '×';
        quitar.setAttribute('aria-label', `Quitar ${li.textContent}`);
        quitar.addEventListener('click', () => {
          input.checked = false;
          sync();
        });
        li.appendChild(quitar);
        return li;
      })
    );
  }

  function filtrar() {
    const q = normalizar(queryInput?.value ?? '');
    const vertical = verticalInputs.find((v) => v.checked)?.value ?? 'todas';
    let visibles = 0;

    for (const [slug, option] of optionBySlug) {
      const entry = bySlug.get(slug);
      const input = option.querySelector<HTMLInputElement>('[data-compare-pick]');
      /*
       * Lo ya elegido no se esconde nunca. Si el filtro lo ocultase, su
       * casilla marcada se iría con él y el formulario mandaría una
       * comparación distinta de la que se ve en pantalla.
       */
      const elegida = input?.checked ?? false;
      const encaja =
        !!entry &&
        (vertical === 'todas' || entry.v === vertical) &&
        (!q || entry.n.includes(q));
      option.hidden = !elegida && !encaja;
      if (!option.hidden) visibles++;
    }

    if (nomatch) nomatch.hidden = visibles > 0;
  }

  function sync() {
    const elegidas = seleccionadas();
    for (const counter of counters) counter.textContent = String(elegidas.length);
    for (const submit of submits) submit.disabled = elegidas.length < 2;
    for (const pick of picks) {
      pick.disabled = !pick.checked && elegidas.length >= MAX;
    }
    pintarElegidas();
    filtrar();
  }

  for (const pick of picks) pick.addEventListener('change', sync);
  for (const vertical of verticalInputs) vertical.addEventListener('change', filtrar);
  queryInput?.addEventListener('input', filtrar);
  if (picks.length) sync();

  const soloDiferencias = document.getElementById('solo-diferencias') as HTMLInputElement | null;
  const tabla = document.getElementById('compare-table');
  soloDiferencias?.addEventListener('change', () => {
    tabla?.classList.toggle('solo-diferencias', soloDiferencias.checked);
  });

  document.querySelector('[data-copy-link]')?.addEventListener('click', async (event) => {
    const button = event.currentTarget as HTMLButtonElement;
    try {
      await navigator.clipboard.writeText(location.href);
      button.textContent = 'Enlace copiado';
    } catch {
      button.textContent = 'Copia la URL de la barra';
    }
    window.setTimeout(() => {
      button.textContent = 'Copiar enlace';
    }, 2000);
  });
</script>
