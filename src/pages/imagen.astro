---
import type { Tool } from '@lib/domain/tool';
import BaseLayout from '@layouts/BaseLayout.astro';
import IntentCard from '@components/catalog/IntentCard.astro';
import CatalogFilters from '@components/catalog/CatalogFilters.astro';
import ToolMention from '@components/catalog/ToolMention.astro';
import { getToolsByCategory } from '@lib/data/catalog';
import { getCategory } from '@lib/domain/taxonomy';
import {
  CANDIDATE_FILTERS,
  IMAGE_CAPABILITIES,
  catalogueOrder,
  decideFilters,
  easyToStart,
  freeNow,
  localControl,
  professional,
} from '@lib/data/imagen';
import { repartirBloques } from '@lib/data/category-page';
import { faqSchema, itemListSchema } from '@lib/seo/structured-data';
import { ROUTES } from '@lib/nav';

/**
 * Imagen, reconstruida alrededor de lo que la gente viene a hacer.
 *
 * La versión anterior era una rejilla ordenada por una nota sobre cien, y esa
 * nota mezclaba propiedades del código con propiedades del producto: casi la
 * mitad premiaba ser open source. El resultado encabezaba la categoría con una
 * instalación de Python que necesita GPU, delante de webs donde escribes y
 * generas. Cada tarjeta era defendible por separado y el conjunto engañaba.
 *
 * Aquí no hay una lista: hay cinco preguntas. Cada bloque declara su propio
 * criterio de orden en `@lib/data/imagen`, porque «mejor» depende de para qué.
 *
 * Piloto: ninguna otra categoría cambia hasta que esta se revise.
 */

const category = getCategory('imagen')!;
const tools = getToolsByCategory('imagen');

const gratis = freeNow(tools);
const faciles = easyToStart(tools).slice(0, 5);
const potentes = professional(tools).slice(0, 5);
const { install, technical } = localControl(tools);
const todas = catalogueOrder(tools);

/*
 * Los bloques, en orden editorial y con su motivo.
 *
 * Dos cosas cambian aquí. La primera: el primero que reclama una herramienta
 * se queda su tarjeta completa y los demás la mencionan, porque «gratis
 * ahora», «fáciles» y «las que más saben» compartían casi el mismo reparto y
 * la página pintaba 41 tarjetas para 17 fichas.
 *
 * La segunda es de honestidad. El bloque se llamaba «Potentes y
 * profesionales» y su criterio real era `capabilities.length >= 6`: no mide
 * potencia ni profesionalidad, mide cuántas capacidades hemos documentado. Se
 * llama como lo que mide.
 */
const declarados = [
  {
    id: 'gratis',
    titulo: 'Genera imágenes gratis ahora',
    lista: gratis,
    lede: 'Funcionan en el navegador y su acceso gratuito se renueva. Lo que ves debajo es lo que dice la página oficial del fabricante.',
    motivo: (tool: Tool) =>
      tool.freePlan.creditsAmount
        ? `Acceso gratuito que se renueva: ${tool.freePlan.creditsAmount}.`
        : 'Acceso gratuito que se renueva.',
  },
  {
    id: 'faciles',
    titulo: 'Fáciles para empezar',
    lista: faciles,
    lede: 'Nada que instalar. Primero las que no piden ni cuenta. Que sean de pago no las descalifica: aquí la pregunta es cuánto cuesta empezar, no cuánto cuesta.',
    motivo: (tool: Tool) =>
      tool.startEffort === 'instant' ? 'Se abre y se genera, sin cuenta.' : 'Sólo hace falta una cuenta.',
  },
  {
    id: 'capaces',
    titulo: 'Las que más cosas saben hacer',
    lista: potentes,
    lede: 'Seis o más capacidades documentadas por su fabricante, cada una con la frase que la demuestra. No es una nota de calidad: es cuánto sabemos de ellas con certeza.',
    motivo: (tool: Tool) => `${tool.capabilities.length} capacidades documentadas.`,
  },
  {
    id: 'local',
    titulo: 'Local y máximo control',
    lista: [...install, ...technical],
    lede: 'Se ejecutan en tu equipo: sin cuotas, sin enviar nada a nadie y sin depender de que alguien cambie su plan gratuito. El coste se traslada al hardware.',
    motivo: (tool: Tool) =>
      tool.startEffort === 'install' ? 'Se instala y ya; sigue pidiendo GPU.' : 'Entorno propio y descarga de modelos.',
  },
].filter((b) => b.lista.length > 0);

const bloques = repartirBloques(declarados);

const decisions = decideFilters(tools, CANDIDATE_FILTERS);
const filters = decisions.filter((d) => d.shown);
const hidden = decisions.filter((d) => !d.shown);


const conCreditosDocumentados = tools.filter(
  (t) => t.freePlan.creditsAmount && ['daily', 'weekly', 'monthly'].includes(t.freePlan.creditReset)
).length;

const crumbs = [
  { name: 'Inicio', path: ROUTES.home },
  { name: 'Categorías', path: ROUTES.categories },
  { name: category.name, path: ROUTES.category('imagen') },
];

/** Cada respuesta es un dato que esta misma página enseña. */
const faqs = [
  {
    question: '¿Qué herramientas de imagen puedo usar gratis ahora mismo?',
    answer: `${gratis.length} de las ${tools.length} que hemos verificado generan imágenes, funcionan en el navegador y tienen acceso gratuito utilizable hoy: ${gratis
      .slice(0, 5)
      .map((t) => t.name)
      .join(', ')}. Las herramientas locales quedan fuera de esa lista porque hay que instalarlas antes de generar nada.`,
  },
  {
    question: '¿Cuáles publican cuántas imágenes gratis dan y cada cuánto?',
    answer: `${conCreditosDocumentados}. En el resto sólo consta que hay créditos, no cuántos: cuando el fabricante no publica la cantidad, no la estimamos.`,
  },
  {
    question: '¿Es lo mismo «gratis online» que «open source local»?',
    answer:
      'No, y por eso van en bloques distintos. Una web gratuita se abre y se usa; una herramienta local es gratis por licencia pero el coste se traslada a tu equipo: instalación, modelos de varios gigas y, casi siempre, una GPU.',
  },
];
---

<BaseLayout
  title={`IA para imágenes: ${tools.length} herramientas revisadas y qué dan gratis`}
  description={`Cuáles generan imágenes gratis hoy, cuáles piden instalación y qué da exactamente cada plan gratuito. ${tools.length} revisadas contra la página oficial de cada fabricante.`}
  crumbs={crumbs}
  schemas={[itemListSchema(tools, 'Herramientas de imagen con IA'), faqSchema(faqs)]}
>
  <div class="page vert">
    <header class="vert-hero">
      <h1 class="vert-h1">IA para imágenes</h1>
      {/*
        Un párrafo con dos frases: la promesa y el método.
        Van en el mismo `<p>` para que en el escritorio se lean seguidas, como
        siempre; el `<span>` sólo existe para que en el móvil la segunda baje de
        tamaño y salte de línea. Nada de lo que esta página dice sobre cómo
        trabaja se esconde según el ancho de la pantalla: pesa menos donde el
        alto es el recurso escaso, y nada más.
      */}
      <p class="vert-lede">
        Qué hace cada herramienta, qué te deja hacer sin pagar y cuánto cuesta empezar.{' '}
        <span class="vert-lede-method">
          Sin puntuaciones: lo que hay debajo de cada tarjeta es lo que dice la página
          oficial del fabricante.
        </span>
      </p>
      {/*
        Un `nav` con nombre, no un párrafo de enlaces.
        Es navegación dentro de la página, así que decirlo cuesta un atributo y
        se lo gana quien usa un lector de pantalla: aparece en la lista de
        regiones en vez de como texto suelto. De paso da un asidero estable —el
        nombre accesible— a la prueba que vigila el alto en el móvil, en lugar
        de una clase CSS que cualquiera puede renombrar.
      */}
      <nav class="vert-jump" aria-label="Ir a un bloque">
        {bloques.map((b) => <a href={`#${b.id}`}>{b.titulo}</a>)}
        <a href="#todas">Todas</a>
      </nav>
    </header>

    <!-- ------------------------------------------------------------------ -->
    {bloques.map((bloque) => (
      <section class="vert-block" id={bloque.id} aria-labelledby={`${bloque.id}-h`}>
        <div class="vert-block-head">
          <h2 class="vert-h2" id={`${bloque.id}-h`}>{bloque.titulo}</h2>
          <p class="vert-block-lede">{bloque.lede}</p>
        </div>

        {bloque.completas.length > 0 && (
          <ul class="vert-grid">
            {bloque.completas.map((tool) => (
              <li><IntentCard tool={tool} capabilityOrder={IMAGE_CAPABILITIES} /></li>
            ))}
          </ul>
        )}

        {bloque.compactas.length > 0 && (
          <>
            <p class="vert-tambien">
              También responden a esto, con su ficha completa en otro bloque:
            </p>
            <ul class="vert-menciones">
              {bloque.compactas.map((tool) => (
                <li>
                  <ToolMention tool={tool} motivo={bloque.motivo(tool)} ancla={bloque.anclas.get(tool.slug)} />
                </li>
              ))}
            </ul>
          </>
        )}
      </section>
    ))}

    <!-- ------------------------------------------------------------------ -->
    <section class="vert-block im-all" id="todas" aria-labelledby="todas-h">
      <div class="vert-block-head">
        <h2 class="vert-h2" id="todas-h">Todas las herramientas de imagen</h2>
        <p class="vert-block-lede">Las {tools.length} revisadas, con filtros que se combinan.</p>
      </div>

      <CatalogFilters
        tools={todas}
        shown={filters}
        hidden={hidden}
        capabilityOrder={IMAGE_CAPABILITIES}
        noun="imagen"
      />

    </section>

    <p class="vert-tail">
      ¿Falta alguna, o hay un dato que ya no es cierto?
      <a href={ROUTES.submit}>Cuéntanoslo</a> — cada ficha lleva la fecha en que se
      comprobó y el enlace a la página que lo dice.
    </p>

  </div>
</BaseLayout>
