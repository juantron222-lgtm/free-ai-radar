---
import BaseLayout from '@layouts/BaseLayout.astro';
import NewsletterForm from '@components/marketing/NewsletterForm.astro';
import newsData from '@/data/news.json';
import { ROUTES } from '@lib/nav';

interface NewsItem {
  id: string;
  title: string;
  canonical_url: string;
  source_name: string;
  published_at: string;
  category: string;
  excerpt: string | null;
  official_source: boolean;
  language: string;
  status?: string;
}

const raw = (newsData as { updated_at: string; items: NewsItem[] }).items ?? [];

/**
 * Only official sources, newest first, capped.
 *
 * This is an aggregator, not a publisher: we link out, never reproduce. Each
 * entry shows the source name prominently and the link goes straight to the
 * original with `rel="nofollow noopener"`.
 */
const items = raw
  .filter((item) => (!item.status || item.status === 'active') && item.canonical_url)
  .sort((a, b) => b.published_at.localeCompare(a.published_at))
  .slice(0, 60);

const updatedAt = (newsData as { updated_at: string }).updated_at;

const now = Date.now();
const DAY = 86_400_000;

const groups = [
  { key: 'today', label: 'Hoy', items: [] as NewsItem[] },
  { key: 'week', label: 'Últimos 7 días', items: [] as NewsItem[] },
  { key: 'older', label: 'Anteriores', items: [] as NewsItem[] },
];

for (const item of items) {
  const age = now - Date.parse(item.published_at);
  const bucket = age < DAY ? groups[0]! : age < 7 * DAY ? groups[1]! : groups[2]!;
  bucket.items.push(item);
}

const populated = groups.filter((group) => group.items.length > 0);

const sources = [...new Set(items.map((item) => item.source_name))].slice(0, 12);

const crumbs = [
  { name: 'Inicio', path: ROUTES.home },
  { name: 'Novedades', path: ROUTES.news },
];

const fmt = (iso: string) =>
  new Date(iso).toLocaleDateString('es-ES', { day: 'numeric', month: 'short', year: 'numeric' });
---

<BaseLayout
  title="Novedades de IA"
  description="Titulares de fuentes oficiales del sector de la IA, agregados y enlazados a su origen. Sin refritos ni resúmenes generados."
  crumbs={crumbs}
>
  <div class="page news">
    <header class="news-head">
      <h1 class="news-h1">Novedades</h1>
      <p class="news-lede">
        Titulares de las fuentes oficiales del sector, con enlace directo al original. Agregamos y
        enlazamos: no reescribimos noticias ajenas ni generamos resúmenes automáticos que digan lo
        que la fuente no dice.
      </p>
      {updatedAt && (
        <p class="news-updated">
          Última recogida:
          <time datetime={updatedAt}>
            {new Date(updatedAt).toLocaleString('es-ES', { dateStyle: 'long', timeStyle: 'short' })}
          </time>
          · {items.length} titulares de {sources.length} fuentes
        </p>
      )}
      <p class="news-note">
        ¿Buscas lo que cambia en los <em>planes gratuitos</em>? Eso está en
        <a href={ROUTES.changes}> el registro de cambios</a>, que es contenido nuestro y verificado.
      </p>
    </header>

    {populated.length > 0 ? (
      populated.map((group) => (
        <section class="news-group" aria-labelledby={`group-${group.key}`}>
          <h2 id={`group-${group.key}`} class="news-group-title">{group.label}</h2>
          <ul class="news-list">
            {group.items.map((item) => (
              <li class="news-item">
                <a
                  href={item.canonical_url}
                  rel="nofollow noopener"
                  target="_blank"
                  class="news-title"
                >
                  {item.title}
                </a>
                <p class="news-meta">
                  <span class="news-source">{item.source_name}</span>
                  <span aria-hidden="true">·</span>
                  <time datetime={item.published_at}>{fmt(item.published_at)}</time>
                  {item.language !== 'es' && (
                    <>
                      <span aria-hidden="true">·</span>
                      <span class="chip news-lang">{item.language.toUpperCase()}</span>
                    </>
                  )}
                </p>
                {item.excerpt && <p class="news-excerpt">{item.excerpt}</p>}
              </li>
            ))}
          </ul>
        </section>
      ))
    ) : (
      <p class="news-empty">
        No hay titulares recogidos ahora mismo. La recogida es automática y se ejecuta a diario.
      </p>
    )}

    <NewsletterForm source="noticias" />
  </div>
</BaseLayout>

<style>
  .news {
    padding-block: var(--space-m) var(--space-xl);
    display: grid;
    gap: var(--space-l);
  }

  .news-head {
    max-width: 58ch;
  }

  .news-h1 {
    font-size: clamp(1.75rem, 1.4rem + 1.6vw, 2.6rem);
    margin-block-end: var(--space-2xs);
  }

  .news-lede {
    margin: 0 0 var(--space-2xs);
    color: var(--ink-muted);
  }

  .news-updated {
    margin: 0 0 var(--space-2xs);
    font-size: 0.8125rem;
    color: var(--ink-subtle);
  }

  .news-note {
    margin: 0;
    padding: 0.6rem 0.85rem;
    border-radius: var(--radius-m);
    background: var(--surface-sunken);
    border: 1px solid var(--line);
    font-size: 0.875rem;
    color: var(--ink-muted);
  }

  .news-note a {
    color: var(--signal);
    font-weight: 550;
  }

  .news-group-title {
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--ink-subtle);
    padding-block-end: 0.35rem;
    border-block-end: 1px solid var(--line);
    margin-block-end: var(--space-2xs);
  }

  .news-list {
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: 52rem;
  }

  .news-item {
    padding-block: var(--space-xs);
    border-block-end: 1px solid var(--line-hairline);
  }

  .news-title {
    font-family: var(--font-display);
    font-size: 1.0625rem;
    font-weight: 650;
    color: var(--ink-strong);
    text-decoration: none;
    line-height: 1.3;
  }

  .news-title:hover {
    text-decoration: underline;
    text-decoration-color: var(--signal);
  }

  .news-meta {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    flex-wrap: wrap;
    margin: 0.25rem 0 0;
    font-size: 0.75rem;
    color: var(--ink-subtle);
  }

  .news-source {
    font-weight: 600;
    color: var(--ink-muted);
  }

  .news-lang {
    font-size: 0.62rem;
    padding-block: 0.05rem;
  }

  .news-excerpt {
    margin: 0.35rem 0 0;
    font-size: 0.875rem;
    color: var(--ink-muted);
    max-width: 68ch;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .news-empty {
    color: var(--ink-muted);
  }
</style>
