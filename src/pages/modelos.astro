---
import BaseLayout from '@layouts/BaseLayout.astro';
import IntentCard from '@components/catalog/IntentCard.astro';
import CatalogFilters from '@components/catalog/CatalogFilters.astro';
import { catalogueOrder, decideFilters } from '@lib/data/category-page';
import {
  CANDIDATE_FILTERS,
  MIN_BLOQUE,
  MODEL_CAPABILITIES,
  conApiGratis,
  conPesosAbiertos,
  enChatGratis,
  modelTools,
  pequenosEnLocal,
  porApi,
  withCapability,
} from '@lib/data/modelos';
import { faqSchema, itemListSchema } from '@lib/seo/structured-data';
import { ROUTES } from '@lib/nav';

/**
 * Modelos: por dónde se llega a cada uno.
 *
 * La página no ordena por «inteligencia» y no la va a ordenar: no hay
 * puntuación, no hay ranking y no se reconstruye ninguna arena. Lo que separa
 * a unos de otros aquí es el acceso, que es lo único que decide si puedes
 * usarlos hoy.
 */

const tools = modelTools();

const chatGratis = enChatGratis(tools);
const apiGratis = conApiGratis(tools);
const pesos = conPesosAbiertos(tools);

const codigo = withCapability(tools, 'code-generation');
const razonamiento = withCapability(tools, 'reasoning');
const multimodal = withCapability(tools, 'vision');
const pequenos = pequenosEnLocal(tools);
const api = porApi(tools);
const todos = catalogueOrder(tools);

const decisions = decideFilters(tools, CANDIDATE_FILTERS);
const filters = decisions.filter((d) => d.shown);
const hidden = decisions.filter((d) => !d.shown);

/** Las intenciones que hoy tienen catálogo suficiente. */
const bloques = [
  {
    id: 'codigo',
    titulo: 'Para programar',
    lista: codigo,
    lede: 'Los que su propio fabricante posiciona para escribir código, con la frase que lo dice en la ficha. No es nuestro juicio ni una media de benchmarks.',
  },
  {
    id: 'razonamiento',
    titulo: 'Razonamiento',
    lista: razonamiento,
    lede: 'Los que documentan un modo de pensamiento —adaptativo, extendido, con niveles de esfuerzo—, no los que se describen como inteligentes.',
  },
  {
    id: 'multimodal',
    titulo: 'Entienden más que texto',
    lista: multimodal,
    lede: 'Aceptan imágenes de entrada, y algunos también audio o vídeo. Cada modalidad está tomada de la documentación de esa versión, no de la familia.',
  },
  {
    id: 'pequenos',
    titulo: 'Pequeños, para tu equipo',
    lista: pequenos,
    lede: 'Se instalan y funcionan sin infraestructura. El listón no es el número de parámetros —cada fabricante lo cuenta a su manera— sino lo que cuesta arrancarlos.',
  },
  {
    id: 'api',
    titulo: 'Por API',
    lista: api,
    lede: 'Los que se pueden consumir desde código. Que exista API no dice nada del precio: sólo tres de esta lista tienen capa gratuita documentada.',
  },
].filter((b) => b.lista.length >= MIN_BLOQUE);

const conPesosOsi = pesos.filter((t) => t.openSource === 'yes');
const conLicenciaPropia = pesos.filter((t) => t.openSource === 'weights');

const crumbs = [
  { name: 'Inicio', path: ROUTES.home },
  { name: 'Modelos', path: ROUTES.models },
];

const faqs = [
  {
    question: '¿Qué modelos de IA puedo usar gratis?',
    answer: `Depende de por dónde entres, y son tres puertas distintas. ${apiGratis.length} tienen capa gratuita de API documentada por su fabricante. ${pesos.length} publican sus pesos y se pueden ejecutar en tu equipo. Y en aplicaciones de chat sólo hay ${chatGratis.length} confirmado: las páginas de OpenAI, xAI y Perplexity devuelven 403 a toda lectura automática, así que no podemos comprobar qué modelo sirve su plan gratuito.`,
  },
  {
    question: '¿«Pesos abiertos» es lo mismo que «open source»?',
    answer: `No, y la diferencia decide. De los ${pesos.length} modelos descargables del catálogo, ${conPesosOsi.length} tienen licencia OSI —Apache 2.0 o MIT— sin condiciones añadidas. Los otros ${conLicenciaPropia.length} llevan licencia propia: Llama 4 obliga a pedir permiso a Meta por encima de 700 millones de usuarios mensuales y a mostrar «Built with Llama»; Kimi K3 exige atribución a partir de 100 millones; Qwen publica su modelo grande bajo una licencia llamada «qwen3.8-max» mientras el de 27B es Apache 2.0.`,
  },
  {
    question: '¿Si la API de un fabricante tiene capa gratuita, la tienen todos sus modelos?',
    answer:
      'No. La tabla de precios de Google es el ejemplo más claro: Gemini 3.7 Flash aparece con «Free Tier: Available» y Gemini 3.1 Pro, dos filas más abajo, con «Free Tier: Not available». Por eso cada modelo responde por separado a si tiene chat, si ese chat es gratis, si tiene API, si esa API es gratis y si sus pesos se descargan.',
  },
  {
    question: '¿Hay una puntuación de inteligencia en esta página?',
    answer:
      'No, y no la va a haber. No publicamos notas sobre 100, no ordenamos por capacidad y no reconstruimos ninguna arena de comparación. Los bloques son por intención y por acceso, y cada capacidad que se atribuye a un modelo viene de una frase de su documentación oficial que puedes leer en su ficha.',
  },
];
---

<BaseLayout
  title={`Modelos de IA: cuáles puedes usar gratis y por dónde (${tools.length} verificados)`}
  description={`Modelos de lenguaje con sus tres puertas separadas: chat, API y pesos descargables. ${tools.length} verificados contra la documentación oficial de cada fabricante. Sin puntuaciones ni rankings.`}
  crumbs={crumbs}
  schemas={[itemListSchema(tools, 'Modelos de IA verificados'), faqSchema(faqs)]}
>
  <div class="page vert">
    <header class="vert-hero">
      <h1 class="vert-h1">Modelos de IA</h1>
      <p class="vert-lede">
        Cuáles puedes usar sin pagar y por cuál de las tres puertas.{' '}
        <span class="vert-lede-method">
          Sin puntuaciones ni rankings: cada capacidad viene de una frase de la
          documentación del fabricante.
        </span>
      </p>
      <nav class="vert-jump" aria-label="Ir a un bloque">
        <a href="#gratis">Gratis ahora</a>
        <a href="#puertas">Las tres puertas</a>
        {bloques.map((b) => <a href={`#${b.id}`}>{b.titulo}</a>)}
        <a href="#pesos">Pesos abiertos</a>
        <a href="#todos">Todos</a>
      </nav>
    </header>

    <!-- ------------------------------------------------------------------ -->
    <section class="vert-block" id="gratis" aria-labelledby="gratis-h">
      <div class="vert-block-head">
        <h2 class="vert-h2" id="gratis-h">Usar gratis ahora</h2>
        <p class="vert-block-lede">
          Con capa gratuita de API documentada por el fabricante. Es el único
          «gratis» de esta vertical que se puede comprobar de principio a fin: la
          tabla de precios lo dice o no lo dice.
        </p>
      </div>
      <ul class="vert-grid">
        {apiGratis.map((tool) => (
          <li><IntentCard tool={tool} capabilityOrder={MODEL_CAPABILITIES} /></li>
        ))}
      </ul>
      <p class="vert-note">
        No hay bloque de «gratis en un chat» porque sólo hay {chatGratis.length}{' '}
        confirmado. Las páginas de precios de OpenAI, xAI y Perplexity devuelven
        403 a toda lectura automática, así que no podemos comprobar qué modelo
        sirve su plan gratuito — y suponerlo sería justo lo que este catálogo no
        hace.
      </p>
    </section>

    <!-- ------------------------------------------------------------------ -->
    <section class="vert-block" id="puertas" aria-labelledby="puertas-h">
      <div class="vert-block-head">
        <h2 class="vert-h2" id="puertas-h">Las tres puertas, y por qué no se heredan</h2>
        <p class="vert-block-lede">
          Un modelo puede tener varias formas de acceso y cada una responde por su
          cuenta. Es el error más común de esta vertical, y siempre en la misma
          dirección: dar por gratis lo que no se ha comprobado.
        </p>
      </div>
      <ul class="vert-doors">
        <li>
          <h3>En un chat</h3>
          <p>
            Que exista una aplicación donde usarlo no dice qué gama sirve su plan
            gratuito. <strong>ChatGPT tiene plan gratuito; la API de GPT no.</strong>
          </p>
        </li>
        <li>
          <h3>Por API</h3>
          <p>
            Y por modelo, no por fabricante. Gemini 3.7 Flash aparece con «Free
            Tier: Available»; Gemini 3.1 Pro, en la misma tabla, con
            <strong> «Not available»</strong>.
          </p>
        </li>
        <li>
          <h3>Los pesos</h3>
          <p>
            Descargarlos es gratis; el endpoint alojado del mismo modelo no tiene
            por qué serlo. Y <strong>la licencia de los pesos no siempre es
            OSI</strong>.
          </p>
        </li>
      </ul>
    </section>

    <!-- ------------------------------------------------------------------ -->
    {bloques.map((bloque) => (
      <section class="vert-block" id={bloque.id} aria-labelledby={`${bloque.id}-h`}>
        <div class="vert-block-head">
          <h2 class="vert-h2" id={`${bloque.id}-h`}>{bloque.titulo}</h2>
          <p class="vert-block-lede">{bloque.lede}</p>
        </div>
        <ul class="vert-grid">
          {bloque.lista.map((tool) => (
            <li><IntentCard tool={tool} capabilityOrder={MODEL_CAPABILITIES} /></li>
          ))}
        </ul>
      </section>
    ))}

    <!-- ------------------------------------------------------------------ -->
    <section class="vert-block" id="pesos" aria-labelledby="pesos-h">
      <div class="vert-block-head">
        <h2 class="vert-h2" id="pesos-h">Pesos abiertos</h2>
        <p class="vert-block-lede">
          Los que puedes descargar y ejecutar. Van separados por licencia, porque
          «abierto» no significa lo mismo en los dos grupos y la diferencia sólo
          aparece cuando la lees.
        </p>
      </div>

      {conPesosOsi.length > 0 && (
        <div class="vert-sub">
          <h3 class="vert-h3">Con licencia OSI</h3>
          <p class="vert-sub-lede">
            Apache 2.0 o MIT, sin condiciones añadidas: ni umbral de usuarios ni
            atribución obligatoria.
          </p>
          <ul class="vert-grid">
            {conPesosOsi.map((tool) => (
              <li><IntentCard tool={tool} headingLevel="h4" capabilityOrder={MODEL_CAPABILITIES} /></li>
            ))}
          </ul>
        </div>
      )}

      {conLicenciaPropia.length > 0 && (
        <div class="vert-sub">
          <h3 class="vert-h3">Con licencia propia</h3>
          <p class="vert-sub-lede">
            Los pesos se descargan, pero la licencia no es OSI y pone condiciones.
            Léelas antes de construir encima.
          </p>
          <ul class="vert-grid">
            {conLicenciaPropia.map((tool) => (
              <li><IntentCard tool={tool} headingLevel="h4" capabilityOrder={MODEL_CAPABILITIES} /></li>
            ))}
          </ul>
        </div>
      )}
    </section>

    <!-- ------------------------------------------------------------------ -->
    <section class="vert-block" id="todos" aria-labelledby="todos-h">
      <div class="vert-block-head">
        <h2 class="vert-h2" id="todos-h">Todos los modelos</h2>
        <p class="vert-block-lede">
          Los {tools.length} verificados, con filtros que se combinan. Ollama y
          LM Studio no están aquí: son la forma de ejecutar un modelo, no modelos.
        </p>
      </div>

      <CatalogFilters
        tools={todos}
        shown={filters}
        hidden={hidden}
        capabilityOrder={MODEL_CAPABILITIES}
        noun="modelos"
      />
    </section>

    <p class="vert-tail">
      ¿Falta alguno, o hay un dato que ya no es cierto?
      <a href={ROUTES.submit}>Cuéntanoslo</a> — cada ficha lleva la fecha en que se
      comprobó y el enlace a la página que lo dice.
    </p>
  </div>
</BaseLayout>

<style>
  .vert-doors {
    display: grid;
    gap: var(--space-xs);
    margin: 0;
    padding: 0;
    list-style: none;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
  }

  .vert-doors li {
    padding: var(--space-xs);
    border: 1px solid var(--line);
    border-radius: var(--radius-m);
    background: var(--surface);
  }

  .vert-doors h3 {
    margin: 0 0 0.35rem;
    font-size: 0.9375rem;
  }

  .vert-doors p {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--ink-muted);
  }
</style>
