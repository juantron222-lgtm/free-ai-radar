---
import type { Tool } from '@lib/domain/tool';
import BaseLayout from '@layouts/BaseLayout.astro';
import IntentCard from '@components/catalog/IntentCard.astro';
import ToolMention from '@components/catalog/ToolMention.astro';
import CatalogFilters from '@components/catalog/CatalogFilters.astro';
import { catalogueOrder, decideFilters, repartirBloques } from '@lib/data/category-page';
import {
  CANDIDATE_FILTERS,
  CODE_CAPABILITIES,
  CODE_TYPE_HINT,
  CODE_TYPE_LABEL,
  MIN_BLOQUE,
  abiertoYLocal,
  byType,
  codeTools,
  codeType,
  facilesParaEmpezar,
  freeNow,
  localControl,
  type CodeType,
} from '@lib/data/codigo';
import { faqSchema, itemListSchema } from '@lib/seo/structured-data';
import { ROUTES } from '@lib/nav';

/**
 * Código: cinco productos distintos con las mismas dos palabras.
 *
 * La separación que más decide está entre los dos últimos bloques de tipo:
 * crear una aplicación desde una idea no es trabajar sobre un repositorio que
 * ya existe. Quien busca una cosa no quiere la otra, y hasta ahora estaban en
 * la misma lista.
 */

const tools = codeTools();

const gratis = freeNow(tools);
const faciles = facilesParaEmpezar(tools);
const abiertos = abiertoYLocal(tools);
const { install, technical } = localControl(tools);
const todas = catalogueOrder(tools);

const decisions = decideFilters(tools, CANDIDATE_FILTERS);
const filters = decisions.filter((d) => d.shown);
const hidden = decisions.filter((d) => !d.shown);

/** Los tipos que hoy tienen catálogo suficiente para llevar título propio. */
const TIPOS: Array<{ id: string; type: CodeType; titulo: string; lede: string }> = [
  {
    id: 'agentes',
    type: 'agent',
    titulo: 'Agentes que trabajan en tu repositorio',
    lede: 'Abren tu proyecto, leen los ficheros, cambian lo que haga falta y ejecutan órdenes para comprobar el resultado. Parten de código que ya existe.',
  },
  {
    id: 'terminal',
    type: 'cli',
    titulo: 'Terminal',
    lede: 'Se usan desde la consola, sin editor de por medio. Es la forma más directa de darle una tarea a un agente, y la que menos se interpone.',
  },
  {
    id: 'copilotos',
    type: 'copilot',
    titulo: 'Copilotos y autocompletado',
    lede: 'Viven dentro de tu editor y sugieren mientras escribes. No toman el mando: lo devuelven en cada tecla.',
  },
  {
    id: 'apps',
    type: 'app-builder',
    titulo: 'Crea una app desde una idea',
    lede: 'Parten de una descripción y devuelven algo desplegable. No abren tu repositorio: te dan uno. Es otro encargo, y por eso van aparte.',
  },
];

/*
 * Los bloques, en orden editorial y con su motivo.
 *
 * El primero que reclama una herramienta se queda su tarjeta; los siguientes
 * la mencionan. Esta página pintaba 51 tarjetas para quince fichas, y tres de
 * sus bloques estaban contenidos enteros dentro de otro.
 */
const declarados = [
  {
    id: 'gratis',
    titulo: 'Programa gratis ahora',
    lista: gratis,
    lede: 'Acceso gratuito que se renueva. Mira qué incluye: aquí lo gratis no siempre es el producto que ibas buscando.',
    motivo: (tool: Tool) =>
      tool.freePlan.creditsAmount
        ? `Acceso gratuito que se renueva: ${tool.freePlan.creditsAmount}.`
        : 'Acceso gratuito que se renueva.',
  },
  ...TIPOS.map((tipo) => ({
    id: tipo.id,
    titulo: tipo.titulo,
    lista: byType(tools, tipo.type),
    lede: tipo.lede,
    motivo: () => CODE_TYPE_HINT[tipo.type],
  })),
  {
    id: 'faciles',
    titulo: 'Fáciles para empezar',
    lista: faciles,
    lede: 'Funcionan en el navegador o con una cuenta: sin entorno que preparar ni claves que conseguir.',
    motivo: (tool: Tool) =>
      tool.startEffort === 'instant' ? 'Se abre y funciona, sin cuenta.' : 'Sólo hace falta una cuenta.',
  },
  {
    id: 'local',
    titulo: 'Local y open source',
    lista: [...install, ...technical],
    lede: 'Se ejecutan en tu equipo y no dependen de la cuota de nadie. El coste se traslada al modelo que les conectes, que es otra factura.',
    motivo: (tool: Tool) =>
      tool.openSource === 'yes'
        ? `Se ejecuta en tu equipo; licencia ${tool.licence ?? 'OSI'}.`
        : 'Se ejecuta en tu equipo.',
  },
].filter((b) => b.lista.length >= MIN_BLOQUE);

const bloques = repartirBloques(declarados);

/*
 * El primero va antes del explicador.
 *
 * Al convertir «gratis ahora» en un bloque más, el explicador se quedó por
 * delante y la primera recomendación cayó a más de 900 px en un móvil de 375:
 * quien llega ve la teoría antes que nada que pueda usar. El reparto de
 * tarjetas no cambia —manda el orden de `declarados`—, sólo dónde se pinta.
 */
const [primero, ...resto] = bloques;

/** Los tipos que existen en el catálogo, con o sin bloque propio. */
const leyenda = (['ide', 'copilot', 'agent', 'cli', 'app-builder'] as CodeType[])
  .map((type) => ({ type, cuantos: byType(tools, type).length }))
  .filter((t) => t.cuantos > 0);

const crumbs = [
  { name: 'Inicio', path: ROUTES.home },
  { name: 'Código', path: '/codigo' },
];

const faqs = [
  {
    question: '¿Qué herramientas de programación con IA puedo usar gratis?',
    answer: `${gratis.length} de las ${tools.length} revisadas funcionan hoy con un acceso gratuito que se renueva. Léelas con cuidado: lo que un plan gratuito incluye no siempre es el producto que ibas buscando.`,
  },
  {
    question: '¿El plan gratuito de GitHub Copilot incluye su agente?',
    answer:
      'No. Su propia página de planes dice que Copilot Free da 2.000 completados al mes y chat, y excluye expresamente los agentes y el agente de programación, la revisión de código y el modo agente. Que una marca tenga plan gratuito no hace gratis su producto agéntico, y esta es la comprobación que lo demuestra.',
  },
  {
    question: '¿Es lo mismo un constructor de aplicaciones que un agente de código?',
    answer:
      'No, y es la distinción que más decide de esta sección. Lovable, Bolt y v0 parten de una descripción y te devuelven una aplicación desplegable. Claude Code, Cline o Codex abren un repositorio que ya existe y lo modifican. Compararlos en la misma lista respondería una pregunta que nadie ha hecho.',
  },
  {
    question: '¿Hay opciones de código abierto que se ejecuten en mi equipo?',
    answer:
      abiertos.length > 0
        ? `Sí: ${abiertos.length} del catálogo tienen licencia OSI y se ejecutan en tu máquina, así que no dependen de la cuota de nadie. El coste es el modelo que les conectes.`
        : 'Hoy no tenemos ninguna confirmada con licencia OSI y ejecución local.',
  },
];
---

<BaseLayout
  title={`Programar con IA: ${tools.length} herramientas y qué dan gratis`}
  description={`Editores, copilotos, agentes, terminales y constructores de aplicaciones, separados por lo que son. ${tools.length} revisadas contra la documentación oficial de cada fabricante.`}
  crumbs={crumbs}
  schemas={[itemListSchema(tools, 'Herramientas de programación con IA'), faqSchema(faqs)]}
>
  <div class="page vert">
    <header class="vert-hero">
      <h1 class="vert-h1">Programar con IA</h1>
      <p class="vert-lede">
        Qué clase de herramienta es cada una, y qué puedes hacer sin pagar.{' '}
        <span class="vert-lede-method">
          Un editor, un copiloto, un agente y un constructor de aplicaciones no
          son lo mismo.
        </span>
      </p>
      <nav class="vert-jump" aria-label="Ir a un bloque">
        <a href="#tipos">Qué es cada cosa</a>
        {bloques.map((b) => <a href={`#${b.id}`}>{b.titulo}</a>)}
        <a href="#todas">Todas</a>
      </nav>
    </header>

    <!-- ------------------------------------------------------------------ -->
    <!-- ------------------------------------------------------------------ -->
    {primero && (
      <section class="vert-block" id={primero.id} aria-labelledby={`${primero.id}-h`}>
        <div class="vert-block-head">
          <h2 class="vert-h2" id={`${primero.id}-h`}>{primero.titulo}</h2>
          <p class="vert-block-lede">{primero.lede}</p>
        </div>

        {primero.completas.length > 0 && (
          <ul class="vert-grid">
            {primero.completas.map((tool) => (
              <li><IntentCard
                  tool={tool}
                  capabilityOrder={CODE_CAPABILITIES}
                  typeLabel={codeType(tool) ? CODE_TYPE_LABEL[codeType(tool)!] : undefined}
                  typeHint={codeType(tool) ? CODE_TYPE_HINT[codeType(tool)!] : undefined}
                /></li>
            ))}
          </ul>
        )}

        {primero.compactas.length > 0 && (
          <>
            <p class="vert-tambien">
              También responden a esto, con su ficha completa en otro bloque:
            </p>
            <ul class="vert-menciones">
              {primero.compactas.map((tool) => (
                <li>
                  <ToolMention tool={tool} motivo={primero.motivo(tool)} ancla={primero.anclas.get(tool.slug)} />
                </li>
              ))}
            </ul>
          </>
        )}
      </section>
    )}

    <section class="vert-block" id="tipos" aria-labelledby="tipos-h">
      <div class="vert-block-head">
        <h2 class="vert-h2" id="tipos-h">Qué es cada cosa</h2>
        <p class="vert-block-lede">
          Todas se anuncian como «programar con IA» y ninguna hace lo mismo que
          la de al lado. Cada tarjeta lleva su tipo escrito.
        </p>
      </div>
      <dl class="cod-tipos">
        {leyenda.map((t) => (
          <div class="cod-tipo">
            <dt>{CODE_TYPE_LABEL[t.type]}</dt>
            <dd>
              {CODE_TYPE_HINT[t.type]}
              <span class="cod-tipo-n tnum">{t.cuantos}</span>
            </dd>
          </div>
        ))}
      </dl>
    </section>

    <!-- ------------------------------------------------------------------ -->
    {resto.map((bloque) => (
      <section class="vert-block" id={bloque.id} aria-labelledby={`${bloque.id}-h`}>
        <div class="vert-block-head">
          <h2 class="vert-h2" id={`${bloque.id}-h`}>{bloque.titulo}</h2>
          <p class="vert-block-lede">{bloque.lede}</p>
        </div>

        {bloque.completas.length > 0 && (
          <ul class="vert-grid">
            {bloque.completas.map((tool) => (
              <li>
                <IntentCard
                  tool={tool}
                  capabilityOrder={CODE_CAPABILITIES}
                  typeLabel={codeType(tool) ? CODE_TYPE_LABEL[codeType(tool)!] : undefined}
                  typeHint={codeType(tool) ? CODE_TYPE_HINT[codeType(tool)!] : undefined}
                />
              </li>
            ))}
          </ul>
        )}

        {bloque.compactas.length > 0 && (
          <>
            <p class="vert-tambien">
              También responden a esto, con su ficha completa en otro bloque:
            </p>
            <ul class="vert-menciones">
              {bloque.compactas.map((tool) => (
                <li>
                  <ToolMention tool={tool} motivo={bloque.motivo(tool)} ancla={bloque.anclas.get(tool.slug)} />
                </li>
              ))}
            </ul>
          </>
        )}
      </section>
    ))}

    <!-- ------------------------------------------------------------------ -->
    <section class="vert-block" id="todas" aria-labelledby="todas-h">
      <div class="vert-block-head">
        <h2 class="vert-h2" id="todas-h">Todas las herramientas</h2>
        <p class="vert-block-lede">
          Las {tools.length} revisadas, con filtros que se combinan. El primero
          es el tipo, porque es lo primero que hay que decidir.
        </p>
      </div>

      <CatalogFilters
        tools={todas}
        shown={filters}
        hidden={hidden}
        capabilityOrder={CODE_CAPABILITIES}
        noun="herramientas"
      />
    </section>

    <p class="vert-tail">
      ¿Falta alguna, o hay un dato que ya no es cierto?
      <a href={ROUTES.submit}>Cuéntanoslo</a> — cada ficha lleva la fecha en que se
      comprobó y el enlace a la página que lo dice.
    </p>
  </div>
</BaseLayout>

<style>
  /*
   * La leyenda, igual que en /agentes: definiciones, no tarjetas.
   *
   * Si se parecieran a las tarjetas de abajo competirían con ellas, y lo que
   * hacen es lo contrario — explicar cómo leerlas.
   */
  .cod-tipos {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: var(--space-xs);
    margin: 0;
  }

  .cod-tipo {
    padding: var(--space-2xs) var(--space-xs);
    border-inline-start: 2px solid var(--line);
  }

  .cod-tipo dt {
    font-weight: 650;
    font-size: 0.9375rem;
  }

  .cod-tipo dd {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2xs);
    margin: 0.15rem 0 0;
    color: var(--ink-muted);
    font-size: 0.875rem;
  }

  .cod-tipo-n {
    flex: none;
    color: var(--ink-subtle);
    font-weight: 650;
  }
</style>
