---
import AuthLayout from '@layouts/AuthLayout.astro';
import { CSRF_FIELD } from '@lib/security/csrf';
import { safeRedirect } from '@lib/security/redirect';
import { ROUTES } from '@lib/nav';

export const prerender = false;

// Already signed in? Nothing to do here.
if (Astro.locals.user) {
  return Astro.redirect(safeRedirect(Astro.url.searchParams.get('next'), ROUTES.account), 302);
}

const next = safeRedirect(Astro.url.searchParams.get('next'), ROUTES.account);
const flashError = Astro.url.searchParams.get('error');
/*
 * `?confirmado=1` carries its own sentence so the page says something useful
 * even if the message is missing — a link somebody kept and reopened, say.
 */
const flashOk =
  Astro.url.searchParams.get('ok') ??
  (Astro.url.searchParams.get('confirmado') === '1' ? 'Correo confirmado correctamente.' : null);
---

<AuthLayout
  title="Entrar en tu cuenta"
  heading="Entrar"
  lede="Accede para recuperar lo que has guardado y tus listas."
>
  {flashOk && <p class="form-flash form-flash-ok" role="status">{flashOk}</p>}
  {flashError && <p class="form-flash form-flash-error" role="alert">{flashError}</p>}

  <form method="post" action="/api/auth/login" class="auth-form" data-auth-form novalidate>
    <input type="hidden" name={CSRF_FIELD} value={Astro.locals.csrfToken} />
    <input type="hidden" name="next" value={next} />

    <div class="field">
      <label class="label" for="email">Correo electrónico</label>
      <input
        type="email"
        id="email"
        name="email"
        class="input"
        required
        autocomplete="email"
        autofocus
        aria-describedby="email-error"
      />
      <p class="error-text" id="email-error" data-error-for="email" hidden></p>
    </div>

    <div class="field">
      <div class="label-row">
        <label class="label" for="password">Contraseña</label>
        <a href={ROUTES.forgot} class="auth-link-small">¿La has olvidado?</a>
      </div>
      <div class="password-wrap">
        <input
          type="password"
          id="password"
          name="password"
          class="input"
          required
          autocomplete="current-password"
          aria-describedby="password-error"
        />
        <button type="button" class="password-toggle" data-toggle-password="password">
          <span class="sr-only">Mostrar contraseña</span>
          <svg width="17" height="17" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path d="M1.8 10S4.6 4.8 10 4.8 18.2 10 18.2 10 15.4 15.2 10 15.2 1.8 10 1.8 10Z" stroke="currentColor" stroke-width="1.5"/>
            <circle cx="10" cy="10" r="2.4" stroke="currentColor" stroke-width="1.5"/>
          </svg>
        </button>
      </div>
      <p class="error-text" id="password-error" data-error-for="password" hidden></p>
    </div>

    <button type="submit" class="btn btn-primary auth-submit">Entrar</button>

    <p class="form-result" role="status" data-form-result hidden></p>
  </form>

  <p class="auth-alt">
    ¿Todavía no tienes cuenta?
    <a href={`${ROUTES.register}?next=${encodeURIComponent(next)}`}>Crear una gratis</a>
  </p>
</AuthLayout>

<style is:global>
  .auth-form {
    display: grid;
    gap: var(--space-s);
  }

  .label-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2xs);
  }

  .auth-link-small {
    font-size: 0.8125rem;
    color: var(--signal);
  }

  .password-wrap {
    position: relative;
    display: flex;
  }

  .password-wrap .input {
    padding-inline-end: 2.75rem;
  }

  .password-toggle {
    position: absolute;
    inset-inline-end: 0.35rem;
    inset-block: 0.35rem;
    width: 36px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 0;
    border-radius: var(--radius-s);
    background: transparent;
    color: var(--ink-subtle);
    cursor: pointer;
  }

  .password-toggle:hover {
    background: var(--surface-sunken);
    color: var(--ink);
  }

  .auth-submit {
    width: 100%;
  }

  .auth-alt {
    margin-block-start: var(--space-m);
    padding-block-start: var(--space-s);
    border-block-start: 1px solid var(--line);
    font-size: 0.9375rem;
    color: var(--ink-muted);
  }

  .auth-alt a {
    color: var(--signal);
    font-weight: 600;
  }

  .form-flash,
  .form-result {
    margin: 0 0 var(--space-s);
    padding: 0.65rem 0.85rem;
    border-radius: var(--radius-m);
    font-size: 0.875rem;
    font-weight: 550;
  }

  .form-flash-ok,
  .form-result[data-tone='ok'] {
    background: var(--signal-soft);
    border: 1px solid var(--signal-line);
    color: var(--signal);
  }

  .form-flash-error,
  .form-result[data-tone='error'] {
    background: var(--alert-soft);
    border: 1px solid var(--alert-line);
    color: var(--alert);
  }
</style>

<script src="/auth-form.js" is:inline defer></script>
