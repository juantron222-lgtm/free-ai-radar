---
import AuthLayout from '@layouts/AuthLayout.astro';
import { CSRF_FIELD } from '@lib/security/csrf';
import { safeRedirect } from '@lib/security/redirect';
import { MIN_PASSWORD_LENGTH } from '@lib/auth/password';
import { ROUTES } from '@lib/nav';

export const prerender = false;

if (Astro.locals.user) {
  return Astro.redirect(ROUTES.account, 302);
}

const next = safeRedirect(Astro.url.searchParams.get('next'), ROUTES.account);
---

<AuthLayout
  title="Crear una cuenta gratis"
  heading="Crear cuenta"
  lede="Gratis y sin tarjeta. Sólo hace falta para guardar cosas y recibir avisos."
>
  <form method="post" action="/api/auth/signup" class="auth-form" data-auth-form novalidate>
    <input type="hidden" name={CSRF_FIELD} value={Astro.locals.csrfToken} />
    <input type="hidden" name="next" value={next} />
    <div class="signup-hp" aria-hidden="true">
      <label for="website">No rellenes este campo</label>
      <input type="text" id="website" name="website" tabindex="-1" autocomplete="off" />
    </div>

    <div class="field">
      <label class="label" for="displayName">Cómo quieres que te llamemos <span class="hint">(opcional)</span></label>
      <input
        type="text"
        id="displayName"
        name="displayName"
        class="input"
        autocomplete="nickname"
        maxlength="80"
        aria-describedby="displayName-error"
      />
      <p class="error-text" data-error-for="displayName" hidden></p>
    </div>

    <div class="field">
      <label class="label" for="email">Correo electrónico</label>
      <input
        type="email"
        id="email"
        name="email"
        class="input"
        required
        autocomplete="email"
        aria-describedby="email-error"
      />
      <p class="error-text" data-error-for="email" hidden></p>
    </div>

    <div class="field">
      <label class="label" for="password">Contraseña</label>
      <div class="password-wrap">
        <input
          type="password"
          id="password"
          name="password"
          class="input"
          required
          minlength={MIN_PASSWORD_LENGTH}
          autocomplete="new-password"
          aria-describedby="password-hint password-error"
          data-strength-for="password"
        />
        <button type="button" class="password-toggle" data-toggle-password="password">
          <span class="sr-only">Mostrar contraseña</span>
          <svg width="17" height="17" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path d="M1.8 10S4.6 4.8 10 4.8 18.2 10 18.2 10 15.4 15.2 10 15.2 1.8 10 1.8 10Z" stroke="currentColor" stroke-width="1.5"/>
            <circle cx="10" cy="10" r="2.4" stroke="currentColor" stroke-width="1.5"/>
          </svg>
        </button>
      </div>
      <div class="strength">
        <div class="strength-bar" data-strength-bar data-score="0" aria-hidden="true"></div>
        <span class="strength-label" data-strength-label></span>
      </div>
      <p class="hint" id="password-hint">
        Mínimo {MIN_PASSWORD_LENGTH} caracteres. Una frase que recuerdes es mejor que un jeroglífico
        corto.
      </p>
      <p class="error-text" data-error-for="password" hidden></p>
    </div>

    <button type="submit" class="btn btn-primary auth-submit">Crear cuenta gratis</button>

    <p class="signup-terms">
      Al crear la cuenta aceptas los <a href={ROUTES.terms}>términos</a> y la
      <a href={ROUTES.privacy}>política de privacidad</a>. No enviamos correo comercial salvo que lo
      pidas expresamente.
    </p>

    <p class="form-result" role="status" data-form-result hidden></p>
  </form>

  <p class="auth-alt">
    ¿Ya tienes cuenta? <a href={`${ROUTES.login}?next=${encodeURIComponent(next)}`}>Entrar</a>
  </p>
</AuthLayout>

<style>
  .signup-hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .strength {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
    margin-block-start: 0.4rem;
  }

  .strength-bar {
    flex: 1;
    height: 4px;
    border-radius: var(--radius-full);
    background: var(--surface-sunken);
    border: 1px solid var(--line);
    overflow: hidden;
    position: relative;
  }

  .strength-bar::after {
    content: '';
    position: absolute;
    inset-block: 0;
    inset-inline-start: 0;
    width: calc(var(--strength, 0) * 25%);
    background: var(--warn);
    transition: width 160ms ease;
  }

  .strength-bar[data-score='3']::after,
  .strength-bar[data-score='4']::after {
    background: var(--signal);
  }

  .strength-bar[data-score='0']::after,
  .strength-bar[data-score='1']::after {
    background: var(--alert);
  }

  .strength-label {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--ink-muted);
    min-width: 5rem;
  }

  .signup-terms {
    margin: 0;
    font-size: 0.75rem;
    color: var(--ink-subtle);
    line-height: 1.5;
  }

  .signup-terms a {
    color: var(--ink-muted);
    text-decoration: underline;
  }
</style>

<script src="/auth-form.js" is:inline defer></script>
