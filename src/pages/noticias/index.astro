---
import BaseLayout from '@layouts/BaseLayout.astro';
import CabeceraPagina from '@components/site/CabeceraPagina.astro';
import NewsCard from '@components/news/NewsCard.astro';
import NewsletterForm from '@components/marketing/NewsletterForm.astro';
import {
  getAllNews,
  getNewsStats,
  getPopulatedNewsCategories,
  getFreePlanNews,
  getPortada,
} from '@lib/data/news';
import { getCatalogChanges } from '@lib/data/catalog';
import { itemListSchema } from '@lib/seo/structured-data';
import { absoluteUrl } from '@lib/seo/site';
import { ROUTES } from '@lib/nav';

const news = getAllNews();

/*
 * La portada se acota; el archivo sigue accesible justo debajo.
 *
 * Una sección de novedades no parece abandonada por no tener noticias nuevas,
 * sino por acumular viejas. Lo que sale de arriba conserva su URL, su sitio en
 * el sitemap y cualquier enlace guardado: cambia dónde se encuentra, no si se
 * encuentra.
 */
const { destacadas, archivo } = getPortada();
const stats = getNewsStats();
const categories = getPopulatedNewsCategories();
const freePlanNews = getFreePlanNews();

/*
 * Historial, no actualidad.
 *
 * La sección se llamaba «Cambios detectados en el catálogo» y decía que
 * anotamos cada cambio en una ficha verificada. Las anotaciones que hay van de
 * 2022 a junio de 2024: en una página de actualidad, debajo de noticias de esta
 * semana, se leían como recientes. Ahora se llama lo que es, dice de cuándo es
 * la más reciente y, si esa fecha queda fuera de la ventana de actualidad de la
 * portada (90 días), lo dice con todas las letras.
 *
 * El orden lo garantiza `getCatalogChanges`, de más reciente a más antiguo; lo
 * vigila `web-v2-fase3.test.ts`.
 */
const historial = getCatalogChanges(8);
const historialMasReciente = historial[0]?.change.date;
const DIAS_DE_ACTUALIDAD = 90;
const historialEsAntiguo =
  historialMasReciente !== undefined &&
  Date.now() - new Date(`${historialMasReciente}T00:00:00Z`).getTime() > DIAS_DE_ACTUALIDAD * 86_400_000;
const fechaLarga = (iso: string) =>
  new Date(`${iso}T00:00:00Z`).toLocaleDateString('es-ES', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
    timeZone: 'UTC',
  });

const [lead, ...rest] = destacadas;

const crumbs = [
  { name: 'Inicio', path: ROUTES.home },
  { name: 'Últimas noticias', path: ROUTES.news },
];

/**
 * ItemList of the news, so the section is discoverable as a collection rather
 * than as a stack of unrelated pages.
 */
const listSchema = {
  '@type': 'ItemList',
  name: 'Últimas noticias de IA verificadas',
  numberOfItems: news.length,
  itemListElement: news.slice(0, 30).map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    url: absoluteUrl(ROUTES.newsItem(item.slug)),
    name: item.title,
  })),
};
void itemListSchema;
---

<BaseLayout
  title="Últimas noticias de IA, con fuente y fecha"
  description={`${stats.total} novedades verificadas contra la página oficial del fabricante: modelos, agentes, planes gratuitos, precios y limitaciones nuevas. ${stats.affectingFreePlan} afectan a lo que puedes hacer gratis.`}
  crumbs={crumbs}
  migasEnCabecera
  schemas={[listSchema]}
>
  {/*
    La cabecera de todas las secciones.

    Noticias pintaba la suya, con cuatro cifras grandes en rejilla que pesaban
    más que el titular. Ahora es la misma banda que el catálogo y las
    verticales, y las cifras van en la franja de estado, a tamaño de texto:
    siguen a la vista y no compiten con las noticias.
  */}
  <CabeceraPagina titulo="Últimas noticias" crumbs={crumbs}>
    <p class="cabecera-entradilla">
      Sólo publicamos lo que hemos podido verificar en la página oficial del fabricante, con su
      fecha y su enlace. Un resumen de buscador nos sirve para encontrar la noticia; nunca para
      respaldarla.
    </p>
    <p class="franja-estado">
      <span><strong>{stats.total}</strong> noticias</span>
      <span><strong>{stats.verified}</strong> verificadas</span>
      <span><strong>{stats.affectingFreePlan}</strong> afectan al plan gratuito</span>
      <span><strong>{stats.categories}</strong> categorías</span>
    </p>
  </CabeceraPagina>

  <div class="page news-page">

    {news.length === 0 ? (
      <div class="card news-empty">
        <h2>Todavía no hay noticias publicadas</h2>
        <p>
          Aparecerán aquí en cuanto verifiquemos la primera contra su fuente oficial. Preferimos una
          sección vacía a una llena de cosas sin comprobar.
        </p>
        <a href={ROUTES.tools} class="btn btn-secondary btn-sm">Ver el catálogo mientras tanto</a>
      </div>
    ) : (
      <>
        {/*
          Las mismas pastillas con cifra que la portada y el catálogo.

          El estado activo va en `aria-current`, no en una clase: así lo oye
          también quien no lo ve, y el sistema ya sabe pintarlo.
        */}
        <nav class="news-filters scroll-x" aria-label="Filtrar por categoría">
          <a href="#todas" class="cifra-chip" aria-current="true" data-news-filter="all">
            Todas <span class="cifra-chip-n">{stats.total}</span>
          </a>
          {categories.map((category) => (
            <a href={`#${category.category}`} class="cifra-chip" data-news-filter={category.category}>
              {category.label} <span class="cifra-chip-n">{category.count}</span>
            </a>
          ))}
        </nav>

        {freePlanNews.length > 0 && (
          <section class="panel news-highlight" aria-labelledby="free-title">
            <div class="news-section-head">
              <h2 id="free-title" class="panel-titulo">Lo que cambia si no pagas</h2>
              <p class="panel-entradilla">
                De las {stats.total} noticias, estas {freePlanNews.length} afectan directamente a lo
                que puedes hacer sin pagar.
              </p>
            </div>
            <ul class="grid-cards news-grid">
              {freePlanNews.map((item) => (
                <li data-news-item data-category={item.category}>
                  <NewsCard item={item} headingLevel="h3" featured />
                </li>
              ))}
            </ul>
          </section>
        )}

        <section class="news-section" aria-labelledby="all-title">
          <h2 id="all-title" class="seccion-titulo">Todas las noticias</h2>
          <ul class="grid-cards news-grid" id="news-list">
            {lead && (
              <li data-news-item data-category={lead.category}>
                <NewsCard item={lead} headingLevel="h3" />
              </li>
            )}
            {rest.map((item) => (
              <li data-news-item data-category={item.category}>
                <NewsCard item={item} headingLevel="h3" />
              </li>
            ))}
          </ul>
          <p class="news-none" id="news-none" hidden>
            No hay noticias en esa categoría todavía.
          </p>
        </section>

        {archivo.length > 0 && (
          <section class="news-section" aria-labelledby="archive-title">
            <div class="news-section-head">
              <h2 id="archive-title" class="seccion-titulo">Archivo</h2>
              <p class="news-section-lede">
                Siguen siendo ciertas y siguen accesibles; ya no son actualidad. {archivo.length} en total.
              </p>
            </div>
            <ul class="archive-list">
              {archivo.map((item) => (
                <li>
                  <a href={ROUTES.newsItem(item.slug)}>{item.title}</a>
                  <time datetime={item.publishedAt} class="archive-date tnum">
                    {new Date(`${item.publishedAt}T00:00:00Z`).toLocaleDateString('es-ES', {
                      day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC',
                    })}
                  </time>
                </li>
              ))}
            </ul>
          </section>
        )}

        {historial.length > 0 && historialMasReciente && (
          <section class="news-section" aria-labelledby="catalog-title">
            <div class="news-section-head">
              <h2 id="catalog-title" class="seccion-titulo">Historial de cambios</h2>
              <p class="news-section-lede">
                Lo que se anotó en las fichas del catálogo, de más reciente a más antiguo.{' '}
                {historialEsAntiguo ? (
                  <>
                    Es historial, no actualidad: la anotación más reciente es del{' '}
                    <time datetime={historialMasReciente}>{fechaLarga(historialMasReciente)}</time>.
                  </>
                ) : (
                  <>
                    La más reciente es del{' '}
                    <time datetime={historialMasReciente}>{fechaLarga(historialMasReciente)}</time>.
                  </>
                )}
              </p>
            </div>
            <ol class="catalog-changes">
              {historial.map(({ tool, change }) => (
                <li>
                  <time datetime={change.date} class="tnum">
                    {new Date(`${change.date}T00:00:00Z`).toLocaleDateString('es-ES', {
                      day: '2-digit',
                      month: 'short',
                      year: 'numeric',
                      timeZone: 'UTC',
                    })}
                  </time>
                  <div>
                    <a href={ROUTES.tool(tool.slug)}>{tool.name}</a>
                    <p>{change.summary}</p>
                  </div>
                </li>
              ))}
            </ol>
          </section>
        )}
      </>
    )}

    <section class="panel" aria-labelledby="cta-title">
      <div class="news-section-head">
        <h2 id="cta-title" class="panel-titulo">No vuelvas a enterarte tarde</h2>
        <p class="panel-entradilla">
          Los planes gratuitos cambian sin avisar. Puedes seguir una herramienta concreta desde su
          ficha, o recibir el resumen semanal con lo que ha cambiado.
        </p>
      </div>
      <div class="news-cta-actions">
        <a href={ROUTES.tools} class="btn btn-secondary btn-sm">Seguir una herramienta</a>
        <a href={ROUTES.pricing} class="btn btn-ghost btn-sm">Avisos inmediatos con Pro</a>
        <a href="/rss.xml" class="btn btn-ghost btn-sm">RSS</a>
      </div>
    </section>

    <NewsletterForm source="noticias" />

    <p class="news-method">
      ¿Cómo decidimos qué se publica? Está en la{' '}
      <a href={ROUTES.editorialPolicy}>política editorial</a>. Los cambios de esta web, no del
      sector, están en <a href={ROUTES.radarChangelog}>cambios del Radar</a>.
    </p>
  </div>
</BaseLayout>

<style>
  .news-page {
    padding-block: var(--space-s) var(--space-xl);
    display: grid;
    gap: var(--space-l);
  }

  @media (min-width: 48rem) {
    .news-page {
      padding-block-start: var(--space-m);
    }
  }

  .news-section {
    display: grid;
    gap: var(--space-s);
  }

  .news-section-head {
    display: grid;
    gap: 0.25rem;
  }

  .news-section-lede {
    margin: 0;
    color: var(--ink-muted);
    font-size: 0.9375rem;
    max-width: 60ch;
  }

  .news-filters {
    display: flex;
    gap: 0.4rem;
    padding-block-end: 0.25rem;
  }

  /*
   * El bloque del plan gratuito, destacado sin pintarlo de verde.
   *
   * Era un recuadro verde con tarjetas blancas dentro: el color de «disponible»
   * usado como fondo de sección, encima de pastillas que usan ese mismo verde
   * para decir otra cosa. Ahora es un panel del sistema sobre fondo hundido,
   * que separa el bloque sin prestarle significado a un color.
   */
  .news-highlight {
    background: var(--surface-sunken);
  }

  .news-grid {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .news-grid > li {
    display: flex;
  }

  .news-grid > li > :global(*) {
    width: 100%;
  }

  .news-none {
    margin: 0;
    color: var(--ink-subtle);
  }

  .archive-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    max-width: 56rem;
  }

  .archive-list li {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-xs);
    padding-block: 0.55rem;
    border-block-end: 1px solid var(--line-hairline);
    font-size: 0.9375rem;
  }

  .archive-list a {
    color: var(--ink);
    text-decoration: none;
  }

  .archive-list a:hover {
    color: var(--ink-strong);
    text-decoration: underline;
    text-decoration-color: var(--signal);
  }

  .archive-date {
    color: var(--ink-subtle);
    font-size: 0.8125rem;
    white-space: nowrap;
  }

  .catalog-changes {
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: 56rem;
  }

  .catalog-changes li {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.15rem;
    padding-block: var(--space-2xs);
    border-block-end: 1px solid var(--line-hairline);
  }

  @media (min-width: 36rem) {
    .catalog-changes li {
      grid-template-columns: 7rem minmax(0, 1fr);
      gap: var(--space-s);
    }
  }

  .catalog-changes time {
    font-size: 0.8125rem;
    color: var(--ink-subtle);
    font-weight: 600;
    padding-block-start: 0.1rem;
  }

  .catalog-changes a {
    font-weight: 650;
    color: var(--ink-strong);
    text-decoration: none;
  }

  .catalog-changes a:hover {
    text-decoration: underline;
    text-decoration-color: var(--signal);
  }

  .catalog-changes p {
    margin: 0.1rem 0 0;
    font-size: 0.875rem;
    color: var(--ink-muted);
  }

  .news-cta-actions {
    display: flex;
    gap: var(--space-2xs);
    flex-wrap: wrap;
  }

  .news-empty {
    padding: var(--space-l) var(--space-s);
    text-align: center;
  }

  .news-empty h2 {
    font-size: 1.125rem;
    margin-block-end: var(--space-2xs);
  }

  .news-empty p {
    margin: 0 auto var(--space-s);
    max-width: 46ch;
    color: var(--ink-muted);
    font-size: 0.9375rem;
  }

  .news-method {
    margin: 0;
    font-size: 0.8125rem;
    color: var(--ink-subtle);
  }

  .news-method a {
    color: var(--signal);
  }
</style>

<script>
  /**
   * Category filtering without a round trip. Progressive enhancement: the
   * chips are anchors, so with JavaScript off they are inert links rather than
   * dead buttons, and every item stays visible.
   */
  const chips = Array.from(document.querySelectorAll<HTMLElement>('[data-news-filter]'));
  const items = Array.from(document.querySelectorAll<HTMLElement>('[data-news-item]'));
  const none = document.getElementById('news-none');

  for (const chip of chips) {
    chip.addEventListener('click', (event) => {
      event.preventDefault();
      const wanted = chip.dataset['newsFilter']!;

      for (const other of chips) {
        if (other === chip) other.setAttribute('aria-current', 'true');
        else other.removeAttribute('aria-current');
      }

      let visible = 0;
      for (const item of items) {
        const match = wanted === 'all' || item.dataset['category'] === wanted;
        item.hidden = !match;
        if (match) visible++;
      }

      if (none) none.hidden = visible > 0;
    });
  }
</script>
