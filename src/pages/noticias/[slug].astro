---
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/site/Breadcrumbs.astro';
import NewsCard from '@components/news/NewsCard.astro';
import ToolCard from '@components/tools/ToolCard.astro';
import { getAllNews } from '@lib/data/news';
import { getTool } from '@lib/data/catalog';
import { articleSchema } from '@lib/seo/structured-data';
import { NEWS_CATEGORY_LABEL, type AvailabilityTone, type NewsSourceKind } from '@lib/domain/news';
import { ROUTES } from '@lib/nav';

export function getStaticPaths() {
  return getAllNews().map((item) => ({ params: { slug: item.slug }, props: { item } }));
}

const { item } = Astro.props;

const related = item.relatedTools.map(getTool).filter((t) => t !== undefined);

const more = getAllNews()
  .filter((n) => n.slug !== item.slug && n.category === item.category)
  .slice(0, 3);

const fallback = getAllNews().filter((n) => n.slug !== item.slug).slice(0, 3);
const alsoRead = more.length >= 2 ? more : fallback;

const crumbs = [
  { name: 'Inicio', path: ROUTES.home },
  { name: 'Últimas noticias', path: ROUTES.news },
  { name: item.title, path: ROUTES.newsItem(item.slug) },
];

/*
 * Las migas visibles paran en la sección.
 *
 * La última era el titular entero, que en 375 px ocupaba tres líneas justo
 * encima del mismo titular en grande. El JSON-LD de migas sigue llevando las
 * tres: lo pone el layout con `crumbs`.
 */
const migasVisibles = crumbs.slice(0, -1);

const fmt = (iso: string) =>
  new Date(`${iso}T00:00:00Z`).toLocaleDateString('es-ES', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
    timeZone: 'UTC',
  });

const FREE_PLAN_LABEL = {
  yes: 'Sí, afecta al plan gratuito',
  no: 'No afecta al plan gratuito',
  unverified: 'Sin confirmar si afecta al plan gratuito',
} as const;

/*
 * Qué es cada fuente, dicho en castellano.
 *
 * Debajo de cada enlace salía el valor interno tal cual —«official»,
 * «release-notes», «model-card»—: un error de presentación, no de datos. El
 * dato no cambia; sólo cómo se lee.
 */
const TIPO_DE_FUENTE: Record<NewsSourceKind, string> = {
  official: 'anuncio oficial',
  'release-notes': 'notas de versión',
  pricing: 'página de precios',
  docs: 'documentación',
  repo: 'repositorio',
  'model-card': 'ficha del modelo',
};

/** Same mapping as the card, so a story reads identically in both places. */
const AVAILABILITY_CHIP: Record<AvailabilityTone, string> = {
  ok: 'chip-signal',
  caution: 'chip-warn',
  ended: 'chip-alert',
  future: 'chip-info',
  pending: '',
};
---

<BaseLayout
  title={item.seoTitle ?? item.title}
  description={item.seoDescription ?? item.summary}
  crumbs={crumbs}
  migasEnCabecera
  ogType="article"
  schemas={[
    articleSchema({
      headline: item.title,
      description: item.summary,
      path: ROUTES.newsItem(item.slug),
      datePublished: item.publishedAt,
      dateModified: item.checkedAt,
      authorName: item.author,
    }),
  ]}
>
  <article class="noticia">
    {/*
      La cabecera de la ficha, contando una noticia.

      Misma banda, misma tipografía y las migas dentro. Arriba va lo que se
      decide antes de leer: de qué va, cuándo, si está disponible, si afecta
      al plan gratuito y si está verificada. La acción principal —ir al anuncio
      oficial— sube aquí, como «Ir a…» en la ficha de una herramienta: estaba
      al final de las fuentes, después de todo el texto.
    */}
    <header class="cabecera noticia-cabecera">
      <div class="page cabecera-inner">
        <Breadcrumbs crumbs={migasVisibles} />
        <p class="eyebrow noticia-antetitulo">
          <span>{NEWS_CATEGORY_LABEL[item.category]}</span>
          <span aria-hidden="true">·</span>
          <time datetime={item.publishedAt} class="tnum">{fmt(item.publishedAt)}</time>
        </p>

        <h1 class="cabecera-titulo noticia-titulo">{item.title}</h1>
        <p class="cabecera-entradilla">{item.summary}</p>

        <p class="franja-estado noticia-estado">
          <span class="detail-event">{item.eventTypeLabel}</span>
          <span class={`chip ${AVAILABILITY_CHIP[item.availabilityTone]}`}>
            {item.availabilityLabel}
          </span>
          <span class={`chip ${item.affectsFreePlan === 'yes' ? 'chip-signal' : ''}`}>
            {FREE_PLAN_LABEL[item.affectsFreePlan]}
          </span>
          <span class={`chip ${item.verification === 'verified' ? 'chip-signal' : 'chip-warn'}`}>
            {item.verificationLabel}
          </span>
        </p>

        <div class="noticia-acciones">
          <a class="btn btn-primary" href={item.officialUrl} rel="nofollow noopener" target="_blank">
            Leer el anuncio oficial <span aria-hidden="true">↗</span>
            <span class="sr-only">(se abre en una pestaña nueva)</span>
          </a>
          <a class="noticia-fuentes" href="#sources-title">Ver fuentes</a>
        </div>
      </div>
    </header>

    <div class="page news-detail">
    {item.verification === 'partial' && item.unconfirmed.length > 0 && (
      <div class="detail-caveat" role="note">
        <p><strong>Lo que todavía no hemos confirmado</strong></p>
        <ul>
          {item.unconfirmed.map((point) => <li>{point}</li>)}
        </ul>
        <p class="detail-caveat-note">
          Lo decimos en vez de omitirlo. Si tienes la fuente oficial que lo aclara,{' '}
          <a href={ROUTES.contact}>escríbenos</a>.
        </p>
      </div>
    )}

    <div class="detail-body">
      <section class="detail-section" aria-labelledby="impact-title">
        <h2 id="impact-title">Qué significa para ti</h2>
        <p class="detail-impact">{item.impact}</p>
      </section>

      {related.length > 0 && (
        <section class="detail-section" aria-labelledby="tools-title">
          <h2 id="tools-title">Herramientas afectadas</h2>
          <ul class="grid-cards detail-tools">
            {related.map((tool) => (
              <li><ToolCard tool={tool} variant="compact" /></li>
            ))}
          </ul>
          <p class="detail-hint">
            Pulsa «Avisarme» en cualquiera de estas fichas y te escribimos cuando su plan gratuito
            cambie otra vez.
          </p>
        </section>
      )}

      <section class="detail-section" aria-labelledby="sources-title">
        <h2 id="sources-title">Fuentes</h2>
        <p class="detail-texto">
          Todo lo anterior sale de estas páginas. Si alguna contradice lo que publicamos, gana la
          fuente y lo corregimos.
        </p>
        <ul class="detail-sources">
          {item.sources.map((source) => (
            <li>
              <a href={source.url} rel="nofollow noopener" target="_blank">{source.label}</a>
              <span class="detail-source-meta">
                {new URL(source.url).hostname.replace(/^www\./, '')} ·
                {' '}{TIPO_DE_FUENTE[source.kind]} ·
                comprobada el <time datetime={source.checkedAt}>{fmt(source.checkedAt)}</time>
              </span>
            </li>
          ))}
        </ul>
      </section>

      <section class="detail-section detail-byline" aria-labelledby="byline-title">
        <h2 id="byline-title" class="sr-only">Responsable editorial</h2>
        <p>
          Redactado por <strong>{item.author}</strong> ·
          publicado por el fabricante el <time datetime={item.publishedAt}>{fmt(item.publishedAt)}</time> ·
          fuente comprobada el <time datetime={item.checkedAt}>{fmt(item.checkedAt)}</time>.{' '}
          <a href={ROUTES.editorialPolicy}>Cómo decidimos qué publicamos</a>.
        </p>
      </section>
    </div>

    {alsoRead.length > 0 && (
      <section class="detail-more" aria-labelledby="more-title">
        <h2 id="more-title" class="seccion-titulo">Seguir leyendo</h2>
        <ul class="grid-cards detail-more-grid">
          {alsoRead.map((other) => (
            <li><NewsCard item={other} headingLevel="h3" /></li>
          ))}
        </ul>
      </section>
    )}
    </div>
  </article>
</BaseLayout>

<style>
  .noticia-antetitulo {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: var(--space-3xs) 0 0;
  }

  /*
   * Un escalón por debajo del H1 de una sección.
   *
   * «Últimas noticias» son dos palabras; un titular de noticia son quince, y al
   * tamaño de la cabecera común ocupaba cinco líneas en 375 px y cuatro en
   * escritorio antes de la entradilla.
   */
  .noticia-titulo {
    max-width: 34ch;
    font-size: clamp(1.5rem, 1.2rem + 1.5vw, 2.25rem);
    line-height: 1.12;
  }

  .noticia-estado {
    align-items: center;
    gap: 0.35rem 0.5rem;
    margin-block-start: var(--space-3xs);
  }

  /*
    Plain text, not a chip, and placed before the chips: it keeps the event
    type from reading as one more badge, and says what happened before the
    three states say what it means.
  */
  .detail-event {
    font-weight: 600;
    color: var(--ink-muted);
  }

  .noticia-acciones {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2xs) var(--space-s);
    margin-block-start: var(--space-2xs);
  }

  .noticia-fuentes {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 0.9375rem;
    color: var(--signal);
  }

  .news-detail {
    padding-block: var(--space-m) var(--space-xl);
    display: grid;
    gap: var(--space-l);
  }

  .detail-caveat {
    max-width: var(--measure);
    padding: var(--space-xs) var(--space-s);
    border-radius: var(--radius-l);
    border: 1px solid var(--warn-line);
    background: var(--warn-soft);
  }

  .detail-caveat p {
    margin: 0 0 var(--space-3xs);
    font-size: 0.875rem;
  }

  .detail-caveat strong {
    color: var(--warn);
  }

  .detail-caveat ul {
    margin: 0 0 var(--space-2xs);
    padding-inline-start: 1.2em;
    font-size: 0.875rem;
    color: var(--ink);
  }

  .detail-caveat .detail-caveat-note {
    margin: 0;
    font-size: 0.8125rem;
    color: var(--ink-muted);
  }

  .detail-caveat-note a {
    color: var(--warn);
    font-weight: 600;
  }

  .detail-body {
    display: grid;
    gap: var(--space-l);
    max-width: var(--measure);
  }

  /* Los mismos títulos de sección que la ficha de una herramienta. */
  .detail-section h2 {
    font-size: clamp(1.25rem, 1.1rem + 0.7vw, 1.5rem);
    margin-block-end: var(--space-2xs);
    padding-block-end: var(--space-3xs);
    border-block-end: 1px solid var(--line);
  }

  .detail-texto {
    margin: 0;
    color: var(--ink-muted);
  }

  .detail-impact {
    margin: 0;
    font-size: 1.0625rem;
    color: var(--ink);
  }

  .detail-tools {
    list-style: none;
    margin: var(--space-2xs) 0 0;
    padding: 0;
  }

  .detail-tools > li {
    display: flex;
  }

  .detail-tools > li > :global(*) {
    width: 100%;
  }

  .detail-hint {
    margin: var(--space-2xs) 0 0;
    font-size: 0.8125rem;
    color: var(--ink-subtle);
  }

  .detail-sources {
    list-style: none;
    margin: var(--space-s) 0 0;
    padding: 0;
    display: grid;
    gap: var(--space-xs);
  }

  .detail-sources li {
    display: grid;
    gap: 0.1rem;
  }

  .detail-sources a {
    color: var(--signal);
    font-weight: 550;
    overflow-wrap: anywhere;
  }

  .detail-source-meta {
    font-size: 0.8125rem;
    color: var(--ink-subtle);
  }

  .detail-byline p {
    margin: 0;
    font-size: 0.8125rem;
    color: var(--ink-subtle);
    padding: var(--space-2xs) 0;
    border-block: 1px solid var(--line);
  }

  .detail-byline a {
    color: var(--signal);
  }

  .detail-more {
    display: grid;
    gap: var(--space-s);
    padding-block-start: var(--space-m);
    border-block-start: 1px solid var(--line);
  }

  .detail-more-grid {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .detail-more-grid > li {
    display: flex;
  }

  .detail-more-grid > li > :global(*) {
    width: 100%;
  }
</style>
