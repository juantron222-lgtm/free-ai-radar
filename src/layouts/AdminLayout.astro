---
import BaseLayout from './BaseLayout.astro';
import { ADMIN_NAV, isActivePath } from '@lib/nav';
import { CSRF_FIELD } from '@lib/security/csrf';

interface Props {
  title: string;
  heading: string;
  lede?: string;
}

const { title, heading, lede } = Astro.props;
const { user, csrfToken } = Astro.locals;
const current = Astro.url.pathname;
---

{/*
  The admin shell.

  Access control lives in `src/middleware.ts`, which returns 404 (not 403) for
  non-staff so the area's existence is not confirmed to a probing visitor.
  `noindex` here plus `X-Robots-Tag` in vercel.json belt-and-braces the
  indexing side.
*/}
<BaseLayout title={`${title} · Admin`} noindex bare>
  <div class="admin">
    <header class="admin-bar">
      <div class="page admin-bar-inner">
        <a href="/" class="admin-home">Free AI Radar</a>
        <span class="chip chip-info admin-badge">Administración</span>
        <span class="admin-user">{user?.email} · {user?.role}</span>
        <form method="post" action="/api/auth/logout" class="admin-logout">
          <input type="hidden" name={CSRF_FIELD} value={csrfToken} />
          <button type="submit" class="btn btn-ghost btn-sm">Salir</button>
        </form>
      </div>
    </header>

    <div class="page admin-body">
      <nav class="admin-nav scroll-x" aria-label="Secciones de administración">
        <ul>
          {ADMIN_NAV.map((item) => (
            <li>
              <a href={item.href} aria-current={isActivePath(current, item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <main class="admin-main">
        <header class="admin-head">
          <h1 class="admin-title">{heading}</h1>
          {lede && <p class="admin-lede">{lede}</p>}
        </header>
        <slot />
      </main>
    </div>
  </div>
</BaseLayout>

<style>
  .admin-bar {
    border-block-end: 1px solid var(--line);
    background: var(--surface);
    position: sticky;
    top: 0;
    z-index: 30;
  }

  .admin-bar-inner {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
    height: 52px;
    flex-wrap: wrap;
  }

  .admin-home {
    font-family: var(--font-display);
    font-weight: 700;
    text-decoration: none;
    color: var(--ink-strong);
    font-size: 0.9375rem;
  }

  .admin-badge {
    font-size: 0.65rem;
  }

  .admin-user {
    margin-inline-start: auto;
    font-size: 0.75rem;
    color: var(--ink-subtle);
    font-family: var(--font-mono);
  }

  .admin-logout {
    display: flex;
  }

  .admin-body {
    display: grid;
    gap: var(--space-m);
    padding-block: var(--space-m) var(--space-xl);
  }

  .admin-nav ul {
    display: flex;
    gap: 0.2rem;
    list-style: none;
    margin: 0;
    padding: 0 0 0.25rem;
  }

  .admin-nav a {
    display: block;
    padding: 0.4rem 0.7rem;
    border-radius: var(--radius-m);
    font-size: 0.8125rem;
    font-weight: 550;
    color: var(--ink-muted);
    text-decoration: none;
    white-space: nowrap;
    min-height: 36px;
    line-height: 1.7;
  }

  .admin-nav a:hover {
    background: var(--surface-sunken);
    color: var(--ink-strong);
  }

  .admin-nav a[aria-current='page'] {
    background: var(--info-soft);
    color: var(--info);
    font-weight: 650;
  }

  .admin-main {
    min-width: 0;
  }

  .admin-head {
    margin-block-end: var(--space-m);
    padding-block-end: var(--space-2xs);
    border-block-end: 1px solid var(--line);
  }

  .admin-title {
    font-size: 1.5rem;
    margin: 0;
  }

  .admin-lede {
    margin: var(--space-3xs) 0 0;
    font-size: 0.875rem;
    color: var(--ink-muted);
    max-width: 60ch;
  }

  @media (min-width: 60rem) {
    .admin-body {
      grid-template-columns: 13rem minmax(0, 1fr);
      gap: var(--space-xl);
    }

    .admin-nav ul {
      flex-direction: column;
      gap: 0.1rem;
      position: sticky;
      top: 68px;
    }
  }
</style>
