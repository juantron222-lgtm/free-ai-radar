---
import '@/styles/global.css';
import Header from '@components/site/Header.astro';
import Footer from '@components/site/Footer.astro';
import ConsentBanner from '@components/consent/ConsentBanner.astro';
import { SITE, canonicalFor, metaDescription, pageTitle, absoluteUrl } from '@lib/seo/site';
import { graph, organizationSchema, websiteSchema, breadcrumbSchema, type Crumb } from '@lib/seo/structured-data';
import Breadcrumbs from '@components/site/Breadcrumbs.astro';
import Analytics from '@vercel/analytics/astro';

interface Props {
  title: string;
  description?: string;
  /** Extra query params that belong in the canonical (comparator only). */
  canonicalQuery?: string[];
  ogImage?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  crumbs?: Crumb[];
  /** Additional JSON-LD nodes merged into the page graph. */
  schemas?: Record<string, unknown>[];
  /** Suppresses the site chrome — used by the auth and admin shells. */
  bare?: boolean;
  mainClass?: string;
}

const {
  title,
  description = SITE.description,
  canonicalQuery = [],
  ogImage,
  ogType = 'website',
  noindex = false,
  crumbs = [],
  schemas = [],
  bare = false,
  mainClass = '',
} = Astro.props;

const canonical = canonicalFor(Astro.url, canonicalQuery);
const resolvedTitle = pageTitle(title);
const resolvedDescription = metaDescription(description);
const resolvedOgImage = absoluteUrl(ogImage ?? '/og-default.jpg');

const jsonLd = graph(
  organizationSchema(),
  websiteSchema(),
  ...(crumbs.length ? [breadcrumbSchema(crumbs)] : []),
  ...schemas
);
---

<!doctype html>
<html lang={SITE.lang} data-theme-default="system">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{resolvedTitle}</title>
    <meta name="description" content={resolvedDescription} />

    {noindex
      ? <meta name="robots" content="noindex, nofollow" />
      : <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />}

    <link rel="canonical" href={canonical} />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={resolvedTitle} />
    <meta property="og:description" content={resolvedDescription} />
    <meta property="og:image" content={resolvedOgImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={resolvedTitle} />
    <meta name="twitter:description" content={resolvedDescription} />
    <meta name="twitter:image" content={resolvedOgImage} />

    {/* Ready for the English edition; both entries point at the current tree
        until /en exists, which is the documented no-op state. */}
    <link rel="alternate" hreflang="es" href={canonical} />
    <link rel="alternate" hreflang="x-default" href={canonical} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/icons/icon-192.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#fbfaf7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0c0e11" media="(prefers-color-scheme: dark)" />
    <meta name="apple-mobile-web-app-title" content="AI Radar" />

    <link rel="alternate" type="application/rss+xml" title={`${SITE.name} — novedades`} href="/rss.xml" />

    {/* External by design: keeps CSP at `script-src 'self'`. See the file header. */}
    <script src="/theme-init.js" is:inline></script>

    <script type="application/ld+json" set:html={jsonLd} is:inline />
  </head>

  <body>
    <a class="skip-link" href="#main">Saltar al contenido</a>

    {!bare && <Header />}

    <main id="main" class={mainClass} tabindex="-1">
      {crumbs.length > 0 && !bare && (
        <div class="page">
          <Breadcrumbs crumbs={crumbs} />
        </div>
      )}
      <slot />
    </main>

    {!bare && <Footer />}

    <ConsentBanner />

    {/*
      Vercel Web Analytics.

      Sits inside our existing CSP without changing it, which is worth stating
      because most analytics do not: in production the script is served from
      `/_vercel/insights/script.js` and the beacon goes to
      `/_vercel/insights/event`, both same-origin, so `script-src 'self'` and
      `connect-src 'self'` already cover them. The one external URL in the
      package, `va.vercel-scripts.com`, is the debug build and is only reached
      when `isDevelopment()` — never from this build.

      Not behind the consent banner, and that is a decision rather than an
      oversight: this counts page views first-party with no cookie and no
      cross-site identifier, so it is not what the banner exists to gate.
    */}
    <Analytics />

    <script src="/sw-register.js" is:inline defer></script>
  </body>
</html>
