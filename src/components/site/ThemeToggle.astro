---
/**
 * Cycles system → light → dark. "System" is the default and is reachable
 * again, so a reader who prefers to follow the OS never gets locked out of it.
 */
---

<button
  type="button"
  class="theme-toggle"
  id="theme-toggle"
  aria-live="polite"
  data-label-system="Tema: automático"
  data-label-light="Tema: claro"
  data-label-dark="Tema: oscuro"
>
  <svg class="theme-icon theme-icon-system" width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true">
    <rect x="2.5" y="3.5" width="15" height="11" rx="1.5" stroke="currentColor" stroke-width="1.6" />
    <path d="M7 17h6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
  </svg>
  <svg class="theme-icon theme-icon-light" width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true">
    <circle cx="10" cy="10" r="3.6" stroke="currentColor" stroke-width="1.6" />
    <path
      d="M10 2v1.8M10 16.2V18M18 10h-1.8M3.8 10H2M15.7 4.3l-1.3 1.3M5.6 14.4l-1.3 1.3M15.7 15.7l-1.3-1.3M5.6 5.6 4.3 4.3"
      stroke="currentColor"
      stroke-width="1.6"
      stroke-linecap="round"
    />
  </svg>
  <svg class="theme-icon theme-icon-dark" width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true">
    <path
      d="M16.5 12.2A7 7 0 0 1 7.8 3.5a7 7 0 1 0 8.7 8.7Z"
      stroke="currentColor"
      stroke-width="1.6"
      stroke-linejoin="round"
    />
  </svg>
  <span class="sr-only" id="theme-toggle-label">Tema: automático</span>
</button>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: var(--radius-m);
    border: 1px solid transparent;
    background: transparent;
    color: var(--ink-muted);
    cursor: pointer;
  }

  .theme-toggle:hover {
    background: var(--surface-sunken);
    color: var(--ink-strong);
  }

  .theme-icon {
    display: none;
  }

  .theme-toggle[data-mode='system'] .theme-icon-system,
  .theme-toggle[data-mode='light'] .theme-icon-light,
  .theme-toggle[data-mode='dark'] .theme-icon-dark {
    display: block;
  }
</style>

<script>
  const STORAGE_KEY = 'far-theme';
  type Mode = 'system' | 'light' | 'dark';
  const ORDER: Mode[] = ['system', 'light', 'dark'];

  const button = document.getElementById('theme-toggle');
  const label = document.getElementById('theme-toggle-label');

  function readStored(): Mode {
    try {
      const value = localStorage.getItem(STORAGE_KEY);
      return value === 'light' || value === 'dark' ? value : 'system';
    } catch {
      return 'system';
    }
  }

  function apply(mode: Mode) {
    const root = document.documentElement;
    if (mode === 'system') root.removeAttribute('data-theme');
    else root.setAttribute('data-theme', mode);

    try {
      if (mode === 'system') localStorage.removeItem(STORAGE_KEY);
      else localStorage.setItem(STORAGE_KEY, mode);
    } catch {
      /* Storage unavailable: the choice applies to this page view only. */
    }

    if (button) {
      button.setAttribute('data-mode', mode);
      const text = button.getAttribute(`data-label-${mode}`) ?? 'Tema';
      button.setAttribute('title', text);
      if (label) label.textContent = text;
    }
  }

  if (button) {
    apply(readStored());
    button.addEventListener('click', () => {
      const next = ORDER[(ORDER.indexOf(readStored()) + 1) % ORDER.length]!;
      apply(next);
    });
  }
</script>
