---
interface Props {
  size?: number;
  showWordmark?: boolean;
}
const { size = 28, showWordmark = true } = Astro.props;
---

<span class="logo">
  {/* Concentric sweep with one resolved contact: detection, not decoration. */}
  <svg
    width={size}
    height={size}
    viewBox="0 0 32 32"
    fill="none"
    aria-hidden="true"
    class="logo-mark"
  >
    <circle cx="16" cy="16" r="14" stroke="currentColor" stroke-opacity="0.22" stroke-width="1.5" />
    <circle cx="16" cy="16" r="8.5" stroke="currentColor" stroke-opacity="0.35" stroke-width="1.5" />
    <path
      d="M16 16 L16 2.5"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-opacity="0.5"
    />
    <circle cx="23" cy="10.5" r="3" class="logo-blip" />
  </svg>
  {showWordmark && (
    <span class="logo-word">
      Free AI <span class="logo-word-accent">Radar</span>
    </span>
  )}
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--ink-strong);
  }

  .logo-mark {
    flex-shrink: 0;
  }

  .logo-blip {
    fill: var(--signal);
  }

  .logo-word {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.0625rem;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }

  .logo-word-accent {
    color: var(--signal);
  }
</style>
