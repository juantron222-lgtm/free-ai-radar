---
import Logo from './Logo.astro';
import ThemeToggle from './ThemeToggle.astro';
import { PRIMARY_NAV, ROUTES, isActivePath } from '@lib/nav';

const current = Astro.url.pathname;
---

<header class="site-header">
  <div class="page header-inner">
    <a href={ROUTES.home} class="header-brand" aria-label="Free AI Radar, ir al inicio">
      <Logo />
    </a>

    <nav class="header-nav" aria-label="Navegación principal">
      <ul>
        {PRIMARY_NAV.map((item) => (
          <li>
            <a
              href={item.href}
              class="header-link"
              aria-current={isActivePath(current, item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="header-actions">
      <a href={`${ROUTES.tools}#buscador`} class="header-icon-btn" aria-label="Buscar herramientas">
        <svg width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <circle cx="9" cy="9" r="6" stroke="currentColor" stroke-width="1.8" />
          <path d="M13.5 13.5 L17 17" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
        </svg>
      </a>

      <ThemeToggle />

      <a href={ROUTES.login} class="btn btn-secondary btn-sm header-login">Entrar</a>

      <button
        type="button"
        class="header-icon-btn header-menu-btn"
        id="menu-toggle"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span class="sr-only">Abrir menú</span>
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path d="M3 6h14M3 10h14M3 14h14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
        </svg>
      </button>
    </div>
  </div>

  <div class="mobile-menu" id="mobile-menu" hidden>
    <nav class="page" aria-label="Navegación móvil">
      <ul>
        {PRIMARY_NAV.map((item) => (
          <li>
            <a href={item.href} aria-current={isActivePath(current, item.href) ? 'page' : undefined}>
              <span class="mobile-menu-label">{item.label}</span>
              {item.description && <span class="mobile-menu-desc">{item.description}</span>}
            </a>
          </li>
        ))}
        <li class="mobile-menu-divider">
          <a href={ROUTES.login}>
            <span class="mobile-menu-label">Entrar o crear cuenta</span>
            <span class="mobile-menu-desc">Guarda herramientas y comprueba tus listas</span>
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: color-mix(in srgb, var(--paper) 88%, transparent);
    backdrop-filter: saturate(140%) blur(12px);
    border-bottom: 1px solid var(--line);
  }

  .header-inner {
    display: flex;
    align-items: center;
    gap: var(--space-m);
    height: 60px;
  }

  .header-brand {
    text-decoration: none;
    flex-shrink: 0;
  }

  .header-nav {
    display: none;
    flex: 1;
  }

  .header-nav ul {
    display: flex;
    align-items: center;
    gap: var(--space-3xs);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .header-link {
    display: block;
    padding: 0.4rem 0.7rem;
    border-radius: var(--radius-m);
    font-size: 0.9375rem;
    font-weight: 550;
    color: var(--ink-muted);
    text-decoration: none;
    transition:
      color 140ms ease,
      background-color 140ms ease;
  }

  .header-link:hover {
    color: var(--ink-strong);
    background: var(--surface-sunken);
  }

  /* Current page is marked by weight and a rule, not by colour alone. */
  .header-link[aria-current='page'] {
    color: var(--ink-strong);
    font-weight: 650;
    box-shadow: inset 0 -2px 0 var(--signal);
    border-radius: var(--radius-s);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: var(--space-3xs);
    margin-inline-start: auto;
  }

  .header-icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: var(--radius-m);
    border: 1px solid transparent;
    background: transparent;
    color: var(--ink-muted);
    cursor: pointer;
    text-decoration: none;
  }

  .header-icon-btn:hover {
    background: var(--surface-sunken);
    color: var(--ink-strong);
  }

  .header-login {
    display: none;
  }

  .mobile-menu {
    border-top: 1px solid var(--line);
    background: var(--surface);
    padding-block: var(--space-2xs) var(--space-s);
    max-height: calc(100dvh - 60px);
    overflow-y: auto;
  }

  .mobile-menu ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .mobile-menu a {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    padding: 0.7rem 0.25rem;
    text-decoration: none;
    border-bottom: 1px solid var(--line-hairline);
    min-height: 44px;
  }

  .mobile-menu li:last-child a {
    border-bottom: 0;
  }

  .mobile-menu-divider {
    margin-block-start: var(--space-2xs);
    padding-block-start: var(--space-2xs);
    border-top: 1px solid var(--line);
  }

  .mobile-menu-label {
    font-weight: 600;
    color: var(--ink-strong);
  }

  .mobile-menu a[aria-current='page'] .mobile-menu-label {
    color: var(--signal);
  }

  .mobile-menu-desc {
    font-size: 0.8125rem;
    color: var(--ink-muted);
  }

  @media (min-width: 68rem) {
    .header-nav {
      display: block;
    }

    .header-menu-btn {
      display: none;
    }

    .header-login {
      display: inline-flex;
    }

    .mobile-menu {
      display: none;
    }
  }
</style>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');

  if (toggle && menu) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      menu.hidden = !open;
    };

    setOpen(false);

    toggle.addEventListener('click', () => {
      setOpen(toggle.getAttribute('aria-expanded') !== 'true');
    });

    // Escape closes the menu and returns focus to the control that opened it.
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });

    // Resizing into the desktop breakpoint must not leave a hidden-but-open menu.
    const desktop = window.matchMedia('(min-width: 60rem)');
    desktop.addEventListener('change', (event) => {
      if (event.matches) setOpen(false);
    });
  }
</script>
