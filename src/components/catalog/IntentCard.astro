---
import type { Tool } from '@lib/domain/tool';
import { CAPABILITY_LABEL, HOSTING_LABEL } from '@lib/domain/taxonomy';
import { esfuerzoDe } from '@lib/domain/esfuerzo';
import type { Capability } from '@lib/domain/taxonomy';
import { freeAccessLabel } from '@lib/data/category-page';
import { ROUTES } from '@lib/nav';
import ToolLogo from '@components/tools/ToolLogo.astro';
import { estaProbada } from '@lib/data/muestras';
import { filaDe } from '@lib/data/portada';
import { verificacionDe } from '@lib/domain/verification';

/**
 * Una tarjeta que contesta cuatro preguntas y ninguna más.
 *
 *   1. ¿Qué hace?           → las capacidades citadas, en castellano
 *   2. ¿Puedo usarla gratis? → el tipo de gratuidad, con cantidad sólo si consta
 *   3. ¿Online o local?      → dónde se ejecuta
 *   4. ¿Cuánto cuesta empezar? → el esfuerzo, con el motivo en el `title`
 *
 * Sin número sobre cien. La nota global respondía «¿cuál es mejor?», y esa
 * pregunta no tiene respuesta sin saber quién la hace: AUTOMATIC1111 sacaba 89
 * y Midjourney 65, lo que a alguien que quiere una imagen ahora no le decía
 * nada, porque el 89 es una instalación de Python que necesita GPU.
 *
 * Lo que no consta no se pinta. Un hueco es más honesto que una etiqueta
 * tranquilizadora, y mucho más que una alarmante: `unverified` significa que no
 * lo hemos comprobado, no que la respuesta sea «no».
 */

interface Props {
  tool: Tool;
  headingLevel?: 'h3' | 'h4';
  /** Cuántas capacidades caben antes de resumir el resto. */
  capabilityLimit?: number;
  /**
   * Qué capacidades enseña esta categoría, y en qué orden.
   *
   * Cada vertical decide las suyas: en Imagen «texto a imagen» encabeza, en
   * Vídeo lo hace «texto a vídeo», y ninguna de las dos quiere enseñar las de
   * la otra aunque la ficha las tenga. Sin esta prop, la tarjeta tendría que
   * saber de categorías, que es exactamente lo que no debe saber.
   */
  capabilityOrder: readonly Capability[];
  /**
   * Qué clase de cosa es, cuando la categoría no lo hace obvio.
   *
   * En imagen o audio sobra: dos fichas del mismo bloque hacen el mismo
   * trabajo. En agentes no — Manus recibe un encargo y actúa, CrewAI es una
   * biblioteca con la que programas el tuyo— y confundirlas cuesta una tarde.
   * Sin esta prop la tarjeta se pinta igual que siempre.
   */
  typeLabel?: string;
  /** El porqué del tipo, en el `title`. Se ignora sin `typeLabel`. */
  typeHint?: string;
  /**
   * Sobre el pliegue.
   *
   * Las seis de la portada se ven sin desplazar nada: pedir sus logos en
   * diferido las deja unos cuantos fotogramas sin identidad justo donde más
   * falta hace. Las demás sí esperan su turno.
   */
  priority?: boolean;
}

const {
  tool,
  headingLevel: Heading = 'h3',
  capabilityLimit = 4,
  capabilityOrder,
  typeLabel,
  typeHint,
  priority = false,
} = Astro.props;

const access = freeAccessLabel(tool);
const esfuerzo = esfuerzoDe(tool);
const shown = capabilityOrder.filter((c) => tool.capabilities.includes(c));
const visible = shown.slice(0, capabilityLimit);
const rest = shown.length - visible.length;

const local = tool.hosting !== 'cloud';

/*
 * «Sólo uso personal», junto a la etiqueta de gratuidad y no enterrado abajo.
 *
 * Es la condición que más decisiones cambia y la que peor se ve: Suno da
 * cincuenta créditos al día y no deja monetizar nada; ElevenLabs reserva la
 * licencia comercial para los planes de pago; los pesos de AudioCraft y F5-TTS
 * son CC-BY-NC. Saberlo después de integrar la herramienta en un encargo es
 * saberlo tarde.
 *
 * Sólo aparece cuando está **verificado** como `no`. `unverified` no se pinta:
 * no haberlo comprobado no es lo mismo que tenerlo prohibido, y esa confusión
 * es justo la que este catálogo salió a corregir.
 */
const soloPersonal = tool.freePlan.commercialUse === 'no';

/*
 * Por dónde se llega a un modelo, que son tres puertas y no una.
 *
 * Sólo aparece cuando la ficha responde que sí a alguna, porque en las demás
 * verticales `access` está vacío y la tarjeta no debe inventarse una fila.
 * `unverified` no pinta nada: una puerta sin comprobar no es una puerta
 * cerrada, y enseñarla tachada diría lo contrario.
 */
const puertas = [
  tool.access.chat === 'yes'
    ? { id: 'chat', label: tool.access.chatWhere ? `En ${tool.access.chatWhere}` : 'En un chat', libre: tool.access.chatFree === 'yes' }
    : null,
  tool.access.api === 'yes' ? { id: 'api', label: 'Por API', libre: tool.access.apiFree === 'yes' } : null,
  tool.access.weights === 'yes' ? { id: 'weights', label: 'Pesos descargables', libre: true } : null,
].filter((p): p is { id: string; label: string; libre: boolean } => p !== null);

/*
 * La licencia, por capas, cuando no coinciden.
 *
 * Un proyecto puede publicar el código con una licencia permisiva y los pesos
 * con otra que prohíbe el uso comercial. Resumirlo en «Open source» sería
 * cierto a medias, y la mitad que se pierde es la que decide.
 */
const capas = tool.licences ?? {};
const licenciaDividida = Boolean(capas.code && capas.weights && capas.code !== capas.weights);

/*
 * Las mismas tres condiciones que la tarjeta del catálogo.
 *
 * Esta tarjeta y la del catálogo describían la misma ficha con dos diseños:
 * aquí «Cuánto, Dónde, Empezar» con la gratuidad en una pastilla arriba a la
 * derecha; allí el acceso en una línea y tarjeta, registro y uso comercial.
 * Quien pasaba de /herramientas a /imagen tenía que volver a aprender a leer.
 * Ahora las dos salen de `filaDe()`. Lo que es propio de la vertical —qué hace
 * en su orden, el tipo de agente, las puertas de un modelo— se queda.
 */
const fila = filaDe(tool);
const verificacion = verificacionDe(tool);
const CONDICIONES = [
  { etiqueta: 'Tarjeta', condicion: fila.tarjeta },
  { etiqueta: 'Registro', condicion: fila.registro },
  { etiqueta: 'Uso comercial', condicion: fila.comercial },
];

/* Registro ya dice si hace falta cuenta; el esfuerzo sólo añade algo si hay que instalar. */
const seInstala = tool.startEffort === 'install' || tool.startEffort === 'technical';
---

<article
  class="ic card card-interactive"
  data-imagen-card
  data-slug={tool.slug}
  data-name={tool.name.toLowerCase()}
>
  <div class="ic-head">
    <ToolLogo tool={tool} priority={priority} />
    <div class="ic-ident">
      <Heading class="ic-name">
        <a href={ROUTES.tool(tool.slug)} class="ic-link">{tool.name}</a>
        {/*
          Una marca de tres palabras, sin miniatura.
          
          La miniatura en la vertical es lo que de verdad añadiría densidad a
          una rejilla que ya lleva logo, insignia de acceso, capacidades y
          cuatro datos. Esto sólo dice que existe una prueba propia y dónde
          verla; la imagen vive en la ficha, que es donde se puede mirar.
        */}
        {estaProbada(tool.slug) && (
          <span class="ic-probada" title="Hemos generado un resultado con su acceso gratuito. Está en su ficha.">
            Probada por nosotros
          </span>
        )}
      </Heading>
    </div>
  </div>

  <p class="ic-acceso">
    <span class="ic-acceso-tipo" data-tono={access.tone}>{access.kind}</span>
    <span class={access.amount ? 'ic-acceso-cantidad' : 'ic-acceso-cantidad ic-unpublished'}>
      {access.amount ?? access.amountFallback}
    </span>
  </p>

  {typeLabel && (
    <p class="ic-type">
      <span class="ic-type-chip" title={typeHint}>{typeLabel}</span>
    </p>
  )}

  {puertas.length > 0 && (
    <p class="ic-doors">
      {puertas.map((puerta) => (
        <span class="ic-door" data-free={puerta.libre ? 'si' : 'no'}>{puerta.label}</span>
      ))}
    </p>
  )}

  {/*
    «Uso comercial: No» ya está en las condiciones, con tono de aviso. La
    pastilla sólo sigue cuando añade algo que esa fila no dice: que la licencia
    del código y la de los pesos no coinciden.
  */}
  {soloPersonal && licenciaDividida && (
    <p class="ic-personal">
      <span class="chip chip-warn ic-personal-chip">Solo uso personal</span>
      {licenciaDividida && <span class="ic-personal-why">pesos {capas.weights}</span>}
    </p>
  )}

  {/* 1. Qué hace. Si no consta ninguna capacidad, se dice, no se rellena. */}
  {visible.length > 0 ? (
    <p class="ic-does">
      {visible.map((c, i) => (
        <>
          {i > 0 && <span aria-hidden="true"> · </span>}
          <span class="ic-cap">{CAPABILITY_LABEL[c]}</span>
        </>
      ))}
      {rest > 0 && <span class="ic-more"> +{rest}</span>}
    </p>
  ) : (
    <p class="ic-does ic-does-empty">Capacidades sin comprobar en fuente oficial</p>
  )}

  <dl class="ic-condiciones">
    {CONDICIONES.map(({ etiqueta, condicion }) => (
      <div>
        <dt>{etiqueta}</dt>
        <dd class="cond" data-tono={condicion.tono}>{condicion.etiqueta}</dd>
      </div>
    ))}
  </dl>

  {/* «En el navegador» en cada tarjeta era ruido: sólo se dice lo que se sale de lo normal. */}
  {(local || seInstala) && (
    <p class="ic-ejecucion">
      {local && <span>{HOSTING_LABEL[tool.hosting]}</span>}
      {local && seInstala && <span aria-hidden="true"> · </span>}
      {seInstala && <span title={tool.startEffortReason || esfuerzo.meaning}>{esfuerzo.label}</span>}
    </p>
  )}

  <p class="ic-foot">
    <span class="ic-estado" data-state={verificacion.state}>{verificacion.label}</span>
    <span aria-hidden="true"> · </span>
    <span class="ic-date">
      revisada el{' '}
      <time datetime={tool.lastVerifiedAt}>
        {new Date(`${tool.lastVerifiedAt}T00:00:00Z`).toLocaleDateString('es-ES', {
          day: 'numeric',
          month: 'short',
          year: 'numeric',
          timeZone: 'UTC',
        })}
      </time>
    </span>
  </p>
</article>

<style>
  .ic {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    padding: var(--space-s);
    height: 100%;
  }

  /*
   * El tipo, en un tono distinto al de la gratuidad.
   *
   * Comparte sitio con «Solo uso personal» pero no puede parecer una
   * advertencia: no lo es. Es la clase de producto, y en esta vertical decide
   * antes que el precio.
   */
  .ic-type {
    margin: 0;
  }

  .ic-type-chip {
    display: inline-block;
    padding: 0.1rem 0.5rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-full);
    background: var(--neutral-soft);
    color: var(--ink-muted);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.01em;
  }

  .ic-head {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2xs);
  }

  /*
   * El nombre manda, y el acceso se aparta cuando no cabe.
   *
   * Antes el nombre y la etiqueta de acceso compartían una fila con
   * `justify-content: space-between`, y en 375 px «Bolt.new» o «Amazon Q
   * Developer» se partían letra a letra para dejarle sitio a «Free tier». El
   * orden de lectura es nombre, qué hace, acceso — nunca al revés—, así que
   * ahora la etiqueta se envuelve debajo en vez de estrujar el nombre.
   */
  .ic-ident {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.25rem var(--space-2xs);
  }

  .ic-name {
    margin: 0;
    flex: 1 1 auto;
    min-width: 8ch;
    font-size: 1.0625rem;
    font-weight: 650;
    overflow-wrap: break-word;
  }

  .ic-link {
    text-decoration: none;
    color: var(--ink-strong);
  }

  /* Toda la tarjeta es pulsable con una sola parada de tabulación. */
  .ic-link::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }

  .ic-link:hover {
    text-decoration: underline;
    text-decoration-color: var(--signal);
  }

  .ic-acceso {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.1rem 0.5rem;
    margin: 0;
    font-size: 0.875rem;
  }

  .ic-acceso-tipo {
    font-weight: 650;
    color: var(--ink-strong);
  }

  .ic-acceso-tipo[data-tono='good'] {
    color: var(--signal-strong);
  }

  .ic-acceso-tipo[data-tono='warn'] {
    color: var(--warn);
  }

  .ic-acceso-cantidad {
    color: var(--ink-muted);
  }

  .ic-acceso-cantidad.ic-unpublished {
    font-style: italic;
  }

  .ic-probada {
    display: inline-block;
    margin-inline-start: 0.4rem;
    padding: 0.05rem 0.45rem;
    border: 1px solid var(--signal-line);
    border-radius: var(--radius-full);
    background: var(--signal-soft);
    color: var(--signal-strong);
    font-size: 0.6875rem;
    font-weight: 650;
    vertical-align: middle;
    white-space: nowrap;
  }


  /* Pegada a la etiqueta de gratuidad: es la letra pequeña de esa promesa. */
  .ic-doors {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3xs);
    margin: 0 0 var(--space-2xs);
  }

  /*
   * La puerta gratuita se distingue de la de pago, y sin color como único
   * portador: la de pago lleva el borde discontinuo, que se ve igual en
   * escala de grises y con cualquier daltonismo.
   */
  .ic-door {
    padding: 0.05rem 0.45rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-full);
    font-size: 0.75rem;
    color: var(--ink-muted);
  }

  .ic-door[data-free='si'] {
    border-color: var(--signal-line);
    background: var(--signal-soft);
    color: var(--signal);
    font-weight: 550;
  }

  .ic-door[data-free='no'] {
    border-style: dashed;
  }

  .ic-personal {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35rem;
    margin: -0.15rem 0 0;
  }

  .ic-personal-chip {
    font-size: 0.75rem;
  }

  .ic-personal-why {
    font-size: 0.75rem;
    color: var(--ink-muted);
  }

  .ic-does {
    margin: 0;
    font-size: 0.875rem;
    color: var(--ink);
    line-height: 1.45;
  }

  /*
   * `--ink-subtle` da 3.54:1 sobre el papel claro, y a 11–14 px eso incumple el
   * 4.5:1 que exige WCAG 2.2 AA para texto normal. Lo secundario de estas
   * tarjetas usa `--ink-muted`, que sí lo cumple en los dos temas.
   */
  .ic-does-empty {
    color: var(--ink-muted);
    font-style: italic;
  }

  .ic-more {
    color: var(--ink-muted);
  }

  .ic-condiciones {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.5rem;
    margin: var(--space-3xs) 0 0;
    padding-block: 0.55rem;
    border-block: 1px solid var(--line-hairline);
  }

  .ic-condiciones div {
    display: grid;
    gap: 0.1rem;
    min-width: 0;
  }

  .ic-condiciones dt {
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .ic-condiciones dd {
    margin: 0;
    font-size: 0.8125rem;
  }

  .ic-ejecucion {
    margin: 0;
    font-size: 0.75rem;
    color: var(--ink-muted);
  }

  /*
   * Los rótulos suben de 11 px a 12.
   *
   * En /codigo hay noventa de éstos —«CUÁNTO», «DÓNDE», «EMPEZAR»— y a 11 px
   * en versalitas quedaban en el límite de lo cómodo. Con los logos delante
   * la tarjeta ya no necesita apretar el texto para diferenciarse: puede
   * permitirse el píxel.
   */
  .ic-fact dt {
    margin: 0;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--ink-muted);
  }

  .ic-fact dd {
    margin: 0;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--ink);
    line-height: 1.3;
  }

  .ic-fact-effort dd {
    font-weight: 500;
    color: var(--ink-muted);
  }

  /*
   * Lo que no consta se ve distinto de lo que sí, sin parecer una alarma.
   * Va anidado bajo `.ic-fact` porque `.ic-fact dd` tiene más especificidad que
   * una clase suelta y se comía la regla entera.
   */
  .ic-fact dd.ic-unpublished {
    font-weight: 500;
    font-style: italic;
    color: var(--ink-muted);
  }

  /*
   * El pie, donde vive el enlace a la ficha, a 13 px.
   *
   * Era la llamada a la acción de cada tarjeta y competía en tamaño con la
   * fecha de verificación, que es contexto. Sube el bloque y el peso del
   * enlace hace el resto.
   */
  .ic-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 0.25rem;
    margin: auto 0 0;
    font-size: 0.75rem;
    color: var(--ink-muted);
  }

  .ic-estado {
    font-weight: 650;
  }

  .ic-estado[data-state='verificada'] {
    color: var(--signal-strong);
  }

  .ic-estado[data-state='retirada'] {
    color: var(--alert);
  }

  .ic-date {
    color: var(--ink-muted);
  }
</style>
