---
import ToolLogo from '@components/tools/ToolLogo.astro';
import Icono, { type NombreDeIcono } from '@components/home/Icono.astro';
import type { Conteo, Recomendada } from '@lib/data/portada';
import { MOTIVO_EXPLICACION, MOTIVO_LABEL, type MotivoDeHueco } from '@lib/domain/evidencia';
import { ROUTES } from '@lib/nav';

interface Props {
  recomendadas: Recomendada[];
  conteos: Conteo[];
}

const { recomendadas, conteos } = Astro.props;

/**
 * La primera puerta: encontrar una IA, para quien todavía no sabe el nombre.
 *
 * Llevaba otra caja de búsqueda, y la hero ya tiene una justo encima: dos cajas
 * iguales a un desplazamiento de distancia. Lo que no hace la hero es lo que
 * queda aquí: filtrar por la condición que uno no negocia —tarjeta, registro,
 * uso comercial, código abierto— y ofrecer cinco con las que empezar, con el
 * dato que decide a la vista y no una promesa.
 */

/* Un filtro que devuelve cero es un callejón: no se ofrece. */
const filtros = conteos.filter((c) => c.n > 0);

/*
 * Una nota por cada clase de hueco que haya en la tabla, y sólo si lo hay.
 *
 * Explica un valor que puede no aparecer: si ninguna de las cinco lo tiene, es
 * una línea más que leer para nada. Y las dos clases se explican por separado
 * porque no significan lo mismo: una es trabajo nuestro pendiente, la otra es
 * un dato que su fabricante no publica.
 */
const motivos = new Set<MotivoDeHueco>(
  recomendadas.flatMap(({ fila }) =>
    [fila.tarjeta, fila.registro, fila.comercial].flatMap((c) => (c.motivo ? [c.motivo] : []))
  )
);
const ORDEN_MOTIVOS: MotivoDeHueco[] = ['no_publicado', 'pendiente'];

const COLUMNAS = ['Herramienta', 'Qué da gratis', '¿Tarjeta?', '¿Registro?', '¿Uso comercial?'];

/* El icono de cada filtro sale de su clave, que es el parámetro de su URL. */
const ICONO_DE_FILTRO: Record<string, NombreDeIcono> = {
  nocard: 'nocard',
  nosignup: 'nosignup',
  comm: 'comm',
  oss: 'oss',
};
---

<section class="puerta puerta-buscar" aria-labelledby="puerta-buscar-t">
  <header class="puerta-head">
    <h2 id="puerta-buscar-t" class="puerta-title">Encontrar una IA</h2>
    <p class="puerta-lede">Filtra por lo que no estás dispuesto a dar, o empieza por una de estas.</p>
  </header>

  {/*
    Filtros y catálogo en la misma fila.

    «Ver todas las herramientas» iba al pie, después de la tabla; en la
    maqueta está al lado de los filtros, que es donde se decide si filtrar o
    mirarlo todo. El rótulo «Filtros rápidos» sigue siendo el nombre de la
    navegación, pero ya no se ve: los iconos dicen lo mismo con menos.
  */}
  <div class="buscar-barra">
    {filtros.length > 0 && (
      <nav class="filtros" aria-labelledby="filtros-t">
        <h3 id="filtros-t" class="sr-only">Filtros rápidos</h3>
        {/*
          Enlaces, no casillas.

          Cada uno es la URL del catálogo con ese filtro puesto: funciona sin
          JavaScript, se puede compartir y el número es el que devuelve al
          pulsarlo (lo comprueba `web-v2-portada.test.ts`). Casillas que marcar
          aquí para luego pulsar «Buscar» serían otro formulario encima de la hero.
        */}
        <ul class="filtros-lista">
          {filtros.map((c) => (
            <li>
              <a href={c.href} class="filtro">
                {ICONO_DE_FILTRO[c.clave] && <Icono nombre={ICONO_DE_FILTRO[c.clave]!} />}
                <span class="filtro-etiqueta">{c.etiqueta}</span>
                <span class="filtro-n tnum">{c.n}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )}
    <a href={ROUTES.tools} class="ver-todas">
      Ver todas las herramientas <span aria-hidden="true">→</span>
    </a>
  </div>

  {recomendadas.length > 0 && (
    <div class="recomendadas">
      <div class="recomendadas-head">
        <h3 class="puerta-sub" id="recomendadas-t">Para empezar hoy, sin pagar</h3>
        <p class="recomendadas-criterio">
          Una por clase de IA: se usan gratis sin instalar nada y hemos comprobado en su página
          oficial si piden tarjeta o registro.
        </p>
      </div>

      <div class="tabla-wrap">
        <table class="evidencia" aria-labelledby="recomendadas-t" role="table">
          <thead role="rowgroup">
            <tr role="row">
              {COLUMNAS.map((c) => <th scope="col" role="columnheader">{c}</th>)}
            </tr>
          </thead>
          <tbody role="rowgroup">
            {recomendadas.map(({ tool, fila, clase }) => (
              <tr role="row">
                <th scope="row" role="rowheader">
                  <span class="rec">
                    <ToolLogo tool={tool} size="sm" />
                    <span class="rec-textos">
                      <a href={ROUTES.tool(fila.slug)}>{fila.nombre}</a>
                      <span class="rec-clase">{clase}</span>
                    </span>
                  </span>
                </th>
                <td role="cell">
                  <span class="acceso-tipo">{fila.tipoDeAcceso}</span>
                  <span class="acceso-cantidad">{fila.cantidad}</span>
                </td>
                <td role="cell" class="celda-cond" data-etiqueta="Tarjeta"><span class="cond" data-tono={fila.tarjeta.tono}>{fila.tarjeta.etiqueta}</span></td>
                <td role="cell" class="celda-cond" data-etiqueta="Registro"><span class="cond" data-tono={fila.registro.tono}>{fila.registro.etiqueta}</span></td>
                <td role="cell" class="celda-cond" data-etiqueta="Uso comercial"><span class="cond" data-tono={fila.comercial.tono}>{fila.comercial.etiqueta}</span></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  )}

  {motivos.size > 0 && (
    <p class="puerta-pie">
      {ORDEN_MOTIVOS.filter((m) => motivos.has(m)).map((m) => (
        <span class="puerta-nota">«{MOTIVO_LABEL[m]}»: {MOTIVO_EXPLICACION[m]}</span>
      ))}
    </p>
  )}
</section>

<style>
  .puerta {
    display: grid;
    gap: var(--space-m);
    align-content: start;
    padding: var(--space-s);
    border: 1px solid var(--line);
    border-radius: var(--radius-l);
    background: var(--surface);
    box-shadow: var(--shadow-s);
    min-width: 0;
  }

  @media (min-width: 48rem) {
    .puerta {
      padding: var(--space-m);
    }
  }

  .puerta-head {
    display: grid;
    gap: 0.25rem;
  }

  .puerta-title {
    margin: 0;
    font-size: clamp(1.375rem, 1.15rem + 0.8vw, 1.875rem);
    line-height: 1.15;
    font-weight: 700;
    letter-spacing: -0.03em;
  }

  .puerta-lede {
    margin: 0;
    color: var(--ink-muted);
    max-width: 52ch;
  }

  .puerta-sub {
    margin: 0;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .buscar-barra {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-xs) var(--space-s);
  }

  .filtros {
    flex: 1 1 34rem;
    min-width: 0;
    container-type: inline-size;
  }

  /*
   * Cuatro filtros, 2×2 en móvil y en fila en cuanto caben.
   *
   * Son la misma familia visual que los seis botones de la hero, un escalón por
   * debajo: borde, icono, 48 px de alto y el número a la derecha. Como
   * pastillas de 36 px quedaban por debajo de lo que un pulgar acierta con
   * comodidad y se leían como etiquetas, no como algo que se pulsa.
   *
   * Las columnas dependen del ancho de la fila, no de la pantalla: con
   * icono, cada casilla necesita unos 180 px para no partir «Uso comercial»
   * en dos, así que cuatro en fila sólo a partir de 46 rem.
   */
  .filtros-lista {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-3xs);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @container (min-width: 18.5rem) {
    .filtros-lista {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @container (min-width: 46rem) {
    .filtros-lista {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .filtro {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    min-height: 48px;
    padding: 0.5rem 0.5rem 0.5rem 0.625rem;
    font-size: 0.875rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-m);
    background: var(--paper);
    color: var(--ink-strong);
    font-weight: 600;
    text-decoration: none;
    transition:
      border-color 140ms ease,
      background-color 140ms ease,
      color 140ms ease;
  }

  /*
   * El icono, sólo cuando la casilla tiene sitio.
   *
   * En un móvil cada casilla mide 150 px y, con icono, «Sin tarjeta» se
   * partía en dos líneas. El icono no dice nada que no diga la palabra, así
   * que es lo primero que sobra.
   */
  .filtro :global(.icono) {
    display: none;
    width: 1.125rem;
    height: 1.125rem;
    color: var(--signal);
  }

  @container (min-width: 26rem) {
    .filtro {
      gap: 0.5rem;
      padding-inline: 0.75rem 0.625rem;
      font-size: 0.9375rem;
    }

    .filtro :global(.icono) {
      display: block;
    }
  }

  .filtro:hover {
    border-color: var(--signal);
    background: var(--signal-soft);
    color: var(--signal-strong);
  }

  .filtro:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }

  .filtro-etiqueta {
    flex: 1;
    min-width: 0;
  }

  .filtro-n {
    padding: 0.0625rem 0.375rem;
    border-radius: var(--radius-full);
    background: var(--neutral-soft);
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--ink-muted);
  }

  .ver-todas {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 44px;
    color: var(--signal-strong);
    font-weight: 650;
    text-decoration: none;
    white-space: nowrap;
  }

  .ver-todas:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .recomendadas {
    display: grid;
    gap: var(--space-xs);
  }

  .recomendadas-head {
    display: grid;
    gap: 0.2rem;
  }

  .recomendadas-criterio {
    margin: 0;
    font-size: 0.875rem;
    color: var(--ink-muted);
  }

  .tabla-wrap {
    min-width: 0;
  }

  /*
   * La tabla, dibujada como tarjetas a todos los anchos.
   *
   * En móvil ya lo era; ahora también en escritorio, una tarjeta por clase de
   * IA y cinco en fila cuando caben, como en la maqueta. Sigue siendo una
   * tabla: los roles explícitos mantienen la semántica que el cambio de
   * `display` se lleva por delante en varios navegadores, y la cabecera sigue
   * ahí para los lectores de pantalla, oculta sólo a la vista. Lo que no se ve
   * de la cabecera lo dice cada casilla con su propia etiqueta.
   *
   * Sin corazones, sin «Popular» y sin «Ordenar por»: la portada no tiene
   * favoritos, no mide popularidad y estas cinco no se ordenan, son una por
   * clase. Un botón que no hace nada sería una promesa falsa.
   */
  .evidencia,
  .evidencia tbody,
  .evidencia th,
  .evidencia td {
    display: block;
  }

  .evidencia {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.875rem;
  }

  .evidencia thead {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .evidencia tbody {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 13.25rem), 1fr));
    gap: var(--space-xs);
  }

  /*
   * Toda la tarjeta lleva a la ficha, con un solo enlace.
   *
   * El enlace del nombre se estira sobre la tarjeta entera (`::after`), así
   * que el objetivo táctil es la tarjeta y no una palabra de 20 px, sin
   * añadir un segundo enlace a la misma ficha.
   */
  .evidencia tbody tr {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: auto 1fr;
    gap: 0.375rem;
    padding: var(--space-s);
    border: 1px solid var(--line);
    border-radius: var(--radius-l);
    background: color-mix(in oklab, var(--surface-raised) 60%, var(--paper));
    transition:
      border-color 140ms ease,
      box-shadow 140ms ease,
      transform 140ms ease;
  }

  .evidencia tbody tr:hover {
    border-color: var(--signal-line);
    box-shadow: var(--shadow-m);
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .evidencia tbody tr:hover {
      transform: translateY(-2px);
    }
  }

  .evidencia tbody tr:has(a:focus-visible) {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }

  .evidencia th,
  .evidencia td {
    padding: 0;
    text-align: left;
    border: 0;
  }

  .evidencia tbody th {
    margin-block-end: 0.375rem;
    font-size: 1rem;
  }

  .evidencia tbody td:not(.celda-cond) {
    margin-block-end: 0.5rem;
  }

  .rec {
    display: flex;
    align-items: center;
    gap: 0.625rem;
  }

  .rec :global(.tool-logo) {
    width: 2.25rem;
    height: 2.25rem;
  }

  .rec-textos {
    display: grid;
    min-width: 0;
  }

  .rec a {
    font-weight: 650;
    color: var(--ink-strong);
    text-decoration: none;
  }

  .rec a:hover {
    text-decoration: underline;
  }

  .rec a:focus-visible {
    outline: none;
  }

  .rec a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }

  .rec-clase {
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--ink-muted);
  }

  .acceso-tipo {
    display: block;
    font-weight: 600;
    color: var(--ink-strong);
  }

  .acceso-cantidad {
    display: block;
    color: var(--ink-muted);
  }

  /*
   * Las tres condiciones, como etiquetas: una por línea, la pregunta a la
   * izquierda y la respuesta a la derecha.
   *
   * Tres en fila dejaban 55 px a cada una, y «El fabricante no lo publica»
   * se partía en cinco líneas. La etiqueta de cada una («Tarjeta»,
   * «Registro», «Uso comercial») sale del atributo, con `::before`, así que
   * la celda sigue diciendo sólo «Sí» o «No» a quien la lee: es lo que
   * comprueba `home.spec.ts`.
   */
  .evidencia .celda-cond {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.125rem 0.75rem;
    min-width: 0;
    padding: 0.3125rem 0.625rem;
    border-radius: var(--radius-m);
    background: var(--neutral-soft);
    font-size: 0.8125rem;
    text-align: end;
  }

  /* Si la respuesta no cabe al lado, baja a su propia línea, a la derecha. */
  .evidencia .celda-cond .cond {
    margin-inline-start: auto;
  }

  .evidencia .celda-cond::before {
    content: attr(data-etiqueta);
    flex: none;
    font-size: 0.6875rem;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .puerta-pie {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2xs) var(--space-s);
    margin: 0;
  }

  .puerta-nota {
    font-size: 0.8125rem;
    color: var(--ink-muted);
  }
</style>
