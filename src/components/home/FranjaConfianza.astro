---
import type { RecuentoVerificacion } from '@lib/domain/verification';
import { ROUTES } from '@lib/nav';

interface Props {
  recuento: RecuentoVerificacion;
}

const { recuento } = Astro.props;

/**
 * La confianza, en una franja.
 *
 * Aquí había un bloque de unas 350 palabras —tres cifras, la suma, dos
 * párrafos y cinco principios— al final de la portada. Decía cosas ciertas y
 * las decía dos veces: cada ficha ya lleva su estado, su fecha y su fuente. Lo
 * que hace falta arriba es el reparto, que cierra, y por dónde comprobarlo.
 */
---

<aside class="franja" aria-label="Estado del catálogo">
  <dl class="franja-cifras">
    <div>
      <dt>Revisadas</dt>
      <dd class="tnum">{recuento.total}</dd>
    </div>
    <div>
      <dt>Verificadas</dt>
      <dd class="tnum">{recuento.verificada}</dd>
    </div>
    <div>
      <dt>Verificación parcial</dt>
      <dd class="tnum">{recuento.parcial}</dd>
    </div>
    <div>
      <dt>Catalogadas</dt>
      <dd class="tnum">{recuento.catalogada}</dd>
    </div>
    {/*
      Las retiradas sólo aparecen cuando las hay.

      El reparto tiene que cerrar —es lo único que esta franja promete— y una
      cuarta cifra clavada en cero cuando no hay ninguna es ruido que se lee
      como un hueco.
    */}
    {recuento.retirada > 0 && (
      <div>
        <dt>Retiradas</dt>
        <dd class="tnum">{recuento.retirada}</dd>
      </div>
    )}
  </dl>
  <p class="franja-nota">
    Cada dato sale de la página del fabricante y lleva fecha.{' '}
    <a href={ROUTES.methodology}>Cómo lo comprobamos</a>.
  </p>
</aside>

<style>
  /*
   * Cifras grandes, entre dos filetes.
   *
   * Era una píldora gris con números a 18 px, y se leía como un pie de página.
   * Son las cifras que sostienen la promesa de la portada —cuántas hemos
   * revisado y en qué estado está cada una—, así que se dicen al tamaño de
   * una cifra, sin caja alrededor: el filete basta para separarlas.
   */
  .franja {
    display: grid;
    gap: var(--space-s);
    padding-block: var(--space-m);
    border-block: 1px solid var(--line);
  }

  .franja-cifras {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-m) var(--space-s);
    margin: 0;
  }

  @media (min-width: 40rem) {
    .franja-cifras {
      grid-template-columns: repeat(auto-fit, minmax(7.5rem, 1fr));
      gap: var(--space-s);
    }

    .franja-cifras div + div {
      padding-inline-start: var(--space-s);
      border-inline-start: 1px solid var(--line);
    }
  }

  .franja-cifras div {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    min-width: 0;
  }

  .franja-cifras dt {
    order: 2;
    font-size: 0.875rem;
    color: var(--ink-muted);
  }

  .franja-cifras dd {
    order: 1;
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2rem, 1.55rem + 1.8vw, 3rem);
    font-weight: 650;
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--ink-strong);
  }

  .franja-nota {
    margin: 0;
    font-size: 0.875rem;
    color: var(--ink-muted);
  }
</style>
