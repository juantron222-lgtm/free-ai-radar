---
import type { AvailabilityTone, HydratedNewsItem } from '@lib/domain/news';
import { getTool } from '@lib/data/catalog';
import { ROUTES } from '@lib/nav';

interface Props {
  item: HydratedNewsItem;
  headingLevel?: 'h2' | 'h3';
  featured?: boolean;
}

const { item, headingLevel: Heading = 'h3', featured = false } = Astro.props;

const related = item.relatedTools.map(getTool).filter((t) => t !== undefined);

/**
 * Only availability is coloured. The event type is a plain label: it says what
 * happened, which is a fact, not a warning. Availability is the one a reader
 * acts on — whether they can go and use this today — so it gets the colour, and
 * `deprecated` lands on the alert chip so a withdrawal can never be skimmed as
 * a launch.
 */
const AVAILABILITY_CHIP: Record<AvailabilityTone, string> = {
  ok: 'chip-signal',
  caution: 'chip-warn',
  ended: 'chip-alert',
  future: 'chip-info',
  pending: '',
};

const fmt = (iso: string) =>
  new Date(`${iso}T00:00:00Z`).toLocaleDateString('es-ES', {
    day: 'numeric',
    month: 'short',
    year: 'numeric',
    timeZone: 'UTC',
  });
---

{/*
  La misma tarjeta que el catálogo, contando una noticia.

  Llevaba cuatro sistemas de pastillas a la vez —la categoría en azul, los
  avisos, la disponibilidad y las herramientas relacionadas— y en una rejilla
  de veinte eso se leía como ruido de colores. Ahora la categoría es texto,
  como la de una ficha; sólo son pastilla los dos avisos que cambian la
  lectura (afecta al plan gratuito, verificación parcial) y la disponibilidad,
  que es lo que se usa para decidir. El aviso del plan gratuito sigue delante:
  es lo único que dice de un vistazo si la noticia le cuesta algo a quien lee.
*/}
<article class={`card card-interactive news-card ${featured ? 'is-featured' : ''}`}>
  <div class="news-card-head">
    <span class="news-cat">{item.categoryLabel}</span>
    {item.affectsFreePlan === 'yes' && (
      <span class="chip chip-signal">Afecta al plan gratuito</span>
    )}
    {item.verification === 'partial' && (
      <span class="chip chip-warn" title="Hay datos de esta noticia que no hemos podido confirmar">
        Parcial
      </span>
    )}
  </div>

  <Heading class="news-card-title">
    <a href={ROUTES.newsItem(item.slug)}>{item.title}</a>
  </Heading>

  <p class="news-card-summary">{item.summary}</p>

  <div class="news-card-foot">
    <p class="news-card-state">
      <span class="news-event">{item.eventTypeLabel}</span>
      <span class="news-state-sep" aria-hidden="true">·</span>
      <span class={`chip news-avail ${AVAILABILITY_CHIP[item.availabilityTone]}`}>
        {item.availabilityShort}
      </span>
    </p>
    <p class="news-card-meta">
      <time datetime={item.publishedAt} class="news-card-date tnum">{fmt(item.publishedAt)}</time>
      {related.length > 0 && (
        <>
          <span class="news-state-sep" aria-hidden="true">·</span>
          <span class="sr-only">Herramientas:</span>
          <span class="news-card-tools">{related.slice(0, 3).map((tool) => tool.name).join(', ')}</span>
        </>
      )}
    </p>
  </div>
</article>

<style>
  .news-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    padding: var(--space-s);
    height: 100%;
  }

  .is-featured {
    border-color: var(--signal-line);
  }

  .news-card-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.3rem 0.5rem;
  }

  .news-cat {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--ink-muted);
  }

  .news-card-title {
    font-size: 1.0625rem;
    font-weight: 650;
    margin: 0;
    line-height: 1.3;
    overflow-wrap: break-word;
  }

  .news-card-title a {
    color: var(--ink-strong);
    text-decoration: none;
  }

  .news-card-title a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }

  .news-card-title a:hover {
    text-decoration: underline;
    text-decoration-color: var(--signal);
  }

  /* Tres líneas, como la entradilla de la tarjeta del catálogo: se escanea, no se lee. */
  .news-card-summary {
    margin: 0;
    font-size: 0.875rem;
    color: var(--ink-muted);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /*
    The state sits in the footer, at footer weight rather than headline
    weight: it answers "can I use this?", which matters after the reader has
    decided the headline is for them, not before.
  */
  .news-card-foot {
    display: grid;
    gap: 0.35rem;
    margin-block-start: auto;
    padding-block-start: var(--space-2xs);
    border-block-start: 1px solid var(--line-hairline);
  }

  .news-card-state,
  .news-card-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin: 0;
    font-size: 0.75rem;
    color: var(--ink-subtle);
  }

  .news-event {
    font-weight: 600;
    color: var(--ink-muted);
  }

  /*
   * El separador, legible.
   *
   * Iba en el color de las líneas (`--line`) y medía 1,3:1 en claro y en
   * oscuro. Es decorativo y lleva `aria-hidden`, pero un punto que casi no se
   * ve tampoco separa nada: hereda el color del texto que tiene al lado.
   */
  .news-state-sep {
    color: inherit;
  }

  .news-avail {
    font-size: 0.6875rem;
    padding: 0.1rem 0.45rem;
  }

  .news-card-tools {
    min-width: 0;
    overflow-wrap: anywhere;
  }
</style>
