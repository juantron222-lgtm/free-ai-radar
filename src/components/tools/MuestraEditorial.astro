---
import type { Tool } from '@lib/domain/tool';
import { muestrasDe } from '@lib/data/muestras';
import {
  AVISO_MUESTRA,
  AVISO_OBSERVADO,
  OBSERVACION_LABEL,
  ORIGEN_COSTE_LABEL,
  contradicciones,
} from '@lib/domain/muestra';
import { TRI_STATE_LABEL } from '@lib/domain/primitives';
import { MOTIVO_LABEL, motivoDelHueco } from '@lib/domain/evidencia';

interface Props {
  tool: Tool;
}

const { tool } = Astro.props;

/*
 * Una muestra por herramienta en este piloto.
 *
 * La ficha tiene que romper su densidad textual, no convertirse en una
 * galería: seis imágenes no dicen seis veces más que una, dicen que ya nadie
 * lee el texto que hay debajo.
 */
const muestra = muestrasDe(tool.slug)[0];

const choques = muestra
  ? contradicciones(muestra, {
      hasWatermark: tool.freePlan.hasWatermark,
      requiresCreditCard: tool.freePlan.requiresCreditCard,
    })
  : [];

const fecha = muestra
  ? new Date(muestra.generatedAt).toLocaleDateString('es-ES', {
      day: 'numeric',
      month: 'long',
      year: 'numeric',
      timeZone: 'UTC',
    })
  : '';

/**
 * Lo que sólo existe porque hicimos la prueba.
 *
 * Ninguno de estos datos está en la documentación del fabricante: son
 * propiedades de una ejecución concreta. Por eso van juntos y separados de lo
 * que la web publica.
 */
const observado = muestra
  ? [
      { label: 'Modo o modelo', valor: muestra.model },
      { label: 'Proporción', valor: muestra.aspectRatio },
      {
        label: 'Resolución recibida',
        valor: muestra.dimensions ? `${muestra.dimensions.width} × ${muestra.dimensions.height}` : undefined,
      },
      {
        /*
         * El coste, con su procedencia pegada.
         *
         * Krea no enseña el cargo de una generación: publica una tarifa por
         * modelo y deja que restes. La resta la hicimos nosotros y puede estar
         * mal, así que la cifra no puede aparecer con el mismo aspecto que una
         * que el producto mostró. El matiz no es una nota al pie: es la mitad
         * del dato.
         */
        label: 'Créditos gastados',
        valor: muestra.creditsSpent?.texto,
        matiz: muestra.creditsSpent
          ? muestra.creditsSpent.origen === 'inferido'
            ? `${ORIGEN_COSTE_LABEL.inferido}. ${muestra.creditsSpent.base}`
            : ORIGEN_COSTE_LABEL.mostrado
          : undefined,
      },
      { label: 'Cuota que mostraba la cuenta', valor: muestra.creditsLeft },
      { label: 'Tiempo aproximado', valor: muestra.durationSeconds ? `${muestra.durationSeconds} s` : undefined },
    ]
  : [];

/**
 * Las dos preguntas donde una anécdota se disfraza de condición.
 *
 * «No apareció marca de agua» y «no nos pidió tarjeta» son exactamente las dos
 * frases que un lector convierte solo en «no pone marca» y «no pide tarjeta».
 * Ponerlas en la misma fila que lo que publica el fabricante es lo que impide
 * ese salto: se ven las dos columnas y se ve que no dicen lo mismo.
 */
const comoDocumentado = (valor: string, field: 'freePlan.requiresCreditCard' | 'freePlan.hasWatermark') => {
  const motivo = motivoDelHueco(tool, field, valor);
  return motivo ? MOTIVO_LABEL[motivo] : TRI_STATE_LABEL[valor as keyof typeof TRI_STATE_LABEL];
};

const enfrentados = muestra
  ? [
      {
        label: '¿Pide tarjeta?',
        documentado: comoDocumentado(tool.freePlan.requiresCreditCard, 'freePlan.requiresCreditCard'),
        observado: OBSERVACION_LABEL[muestra.cardRequiredObserved],
      },
      {
        label: '¿Marca de agua?',
        documentado: comoDocumentado(tool.freePlan.hasWatermark, 'freePlan.hasWatermark'),
        observado: OBSERVACION_LABEL[muestra.watermarkObserved],
      },
    ]
  : [];
---

{/*
  Probado por Free AI Radar.

  El módulo entero desaparece si no hay muestra: nunca se anuncia una prueba
  que no se ha hecho. Con el fichero de muestras vacío —que es el estado de
  hoy— ninguna ficha enseña esta sección.
*/}
{muestra && (
  <section class="muestra" aria-labelledby="muestra-title">
    <header class="muestra-head">
      <h2 id="muestra-title" class="muestra-title">Probado por Free AI Radar</h2>
      <p class="muestra-cuando">
        Generado con el acceso gratuito el <time datetime={muestra.generatedAt}>{fecha}</time>
      </p>
    </header>

    {/*
      La imagen con su hueco reservado: `width` y `height` en el atributo, así
      que el sitio está antes de que llegue el archivo y no hay salto.
    */}
    <figure class="muestra-figura">
      <a href={muestra.asset.original} class="muestra-enlace">
        <img
          class="muestra-imagen"
          src={muestra.asset.web}
          width={muestra.asset.webDimensiones.width}
          height={muestra.asset.webDimensiones.height}
          loading="lazy"
          decoding="async"
          alt={`Resultado obtenido en ${tool.name} con el prompt de prueba de Free AI Radar`}
        />
        <span class="muestra-ampliar">Ver el original sin retocar ↗</span>
      </a>
      <figcaption class="muestra-pie">{AVISO_MUESTRA}</figcaption>
    </figure>

    <div class="muestra-cuerpo">
      <div class="muestra-prompt">
        <p class="eyebrow">El prompt, literal</p>
        <blockquote class="muestra-cita">{muestra.prompt}</blockquote>
        {muestra.promptDeviation && (
          <p class="muestra-desviacion">
            <strong>Desviación:</strong> {muestra.promptDeviation}
          </p>
        )}
      </div>

      <dl class="muestra-datos">
        {observado
          .filter((d) => d.valor)
          .map((d) => (
            <div class="muestra-dato">
              <dt>{d.label}</dt>
              <dd>
                {d.valor}
                {d.matiz && <span class="muestra-matiz">{d.matiz}</span>}
              </dd>
            </div>
          ))}
      </dl>
    </div>

    <div class="table-scroll">
      <table class="data-table muestra-tabla">
        <caption class="sr-only">
          Lo que publica {tool.name} frente a lo que observamos en nuestra prueba
        </caption>
        <thead>
          <tr>
            <th scope="col">Condición</th>
            <th scope="col">Documentación oficial</th>
            <th scope="col">En nuestra prueba</th>
          </tr>
        </thead>
        <tbody>
          {enfrentados.map((f) => (
            <tr>
              <th scope="row">{f.label}</th>
              <td>{f.documentado}</td>
              <td class="muestra-observado">{f.observado}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    {muestra.auxiliar.length > 0 && (
      <div class="muestra-auxiliar">
        <p class="eyebrow">Lo que mostraba la interfaz durante la prueba</p>
        {muestra.auxiliar.map((a) => (
          <figure class="muestra-aux-figura">
            <img
              class="muestra-aux-imagen"
              src={a.ruta}
              width={a.dimensiones.width}
              height={a.dimensiones.height}
              loading="lazy"
              decoding="async"
              alt={`Captura de la interfaz de ${tool.name}: ${a.textoVisible}`}
            />
            <figcaption class="muestra-aux-pie">
              {/*
                La frase literal primero y su alcance después. Una captura de un
                contador es la lectura de un instante, no la cuota del plan: sin
                esa segunda línea, doce créditos se leerían como la condición
                oficial del producto.
              */}
              <span class="muestra-aux-texto">«{a.textoVisible}»</span>
              <span class="muestra-aux-alcance">{a.respalda}</span>
              {/*
                Y qué se recortó. Una captura de navegador arrastra el correo de
                la cuenta y la barra de marcadores, que no son la prueba y no
                deberían publicarse; pero recortar también sirve para quitar lo
                que estorba, así que se declara qué queda y qué se fue.
              */}
              {a.recorte && <span class="muestra-aux-recorte">{a.recorte}</span>}
            </figcaption>
          </figure>
        ))}
      </div>
    )}

    <p class="muestra-alcance">{AVISO_OBSERVADO}</p>

    {choques.length > 0 && (
      <div class="muestra-choque" role="note">
        <p class="muestra-choque-titulo">Nuestra prueba no coincide con lo que publica su web</p>
        <ul>
          {choques.map((c) => (
            <li>
              {c.documentado}; {c.observado.toLowerCase()}.
            </li>
          ))}
        </ul>
      </div>
    )}

    {muestra.notes && <p class="muestra-notas">{muestra.notes}</p>}
  </section>
)}

<style>
  .muestra {
    display: grid;
    gap: var(--space-xs);
    padding-block-start: var(--space-m);
    border-block-start: 1px solid var(--line);
  }

  .muestra-matiz {
    display: block;
    margin-block-start: 0.2rem;
    font-size: 0.8125rem;
    font-weight: 400;
    line-height: 1.45;
    color: var(--ink-muted);
  }

  .muestra-title {
    font-size: 1.25rem;
    margin: 0;
  }

  .muestra-cuando {
    margin: 0.15rem 0 0;
    font-size: 0.875rem;
    color: var(--ink-muted);
  }

  .muestra-figura {
    margin: 0;
  }

  .muestra-enlace {
    display: block;
    position: relative;
    border-radius: var(--radius-l);
    overflow: hidden;
    border: 1px solid var(--line);
  }

  /*
   * La imagen manda en su caja y no la deforma.
   *
   * `aspect-ratio` sale de los atributos, así que el hueco se reserva con la
   * proporción real del resultado y no con una que hayamos elegido nosotros.
   */
  .muestra-imagen {
    display: block;
    width: 100%;
    height: auto;
    background: var(--surface-sunken);
  }

  .muestra-ampliar {
    position: absolute;
    inset-block-end: 0.5rem;
    inset-inline-end: 0.5rem;
    padding: 0.25rem 0.6rem;
    border-radius: var(--radius-full);
    background: rgb(0 0 0 / 0.72);
    color: #fff;
    font-size: 0.75rem;
    font-weight: 550;
  }

  .muestra-pie {
    margin: var(--space-2xs) 0 0;
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--ink-muted);
  }

  .muestra-cuerpo {
    display: grid;
    gap: var(--space-s);
  }

  @media (min-width: 48rem) {
    .muestra-cuerpo {
      grid-template-columns: 1fr 1fr;
    }
  }

  .muestra-cita {
    margin: 0.2rem 0 0;
    padding: var(--space-2xs) var(--space-xs);
    border-inline-start: 2px solid var(--line-strong);
    background: var(--surface-sunken);
    border-radius: 0 var(--radius-m) var(--radius-m) 0;
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--ink);
  }

  .muestra-desviacion {
    margin: var(--space-2xs) 0 0;
    font-size: 0.8125rem;
    color: var(--warn);
  }

  .muestra-datos {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 10rem), 1fr));
    gap: var(--space-2xs) var(--space-xs);
    margin: 0;
  }

  .muestra-dato dt {
    margin: 0;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--ink-muted);
  }

  .muestra-dato dd {
    margin: 0;
    font-size: 0.875rem;
    font-weight: 550;
    color: var(--ink-strong);
  }

  .muestra-tabla {
    min-width: 32rem;
  }

  /*
   * La columna de lo observado, marcada.
   *
   * No es decorativa: es la que un lector podría llevarse como si fuera la
   * condición del plan. El borde la separa de la de al lado, que es la que sí
   * lo es.
   */
  .muestra-observado {
    border-inline-start: 2px solid var(--info-line);
    background: var(--info-soft);
    font-weight: 550;
  }

  .muestra-auxiliar {
    display: grid;
    gap: var(--space-2xs);
  }

  .muestra-aux-figura {
    margin: 0;
    display: grid;
    gap: var(--space-2xs);
  }

  /*
   * La captura, a su tamaño y sin estirar.
   *
   * Es un recorte pequeño de interfaz: agrandarlo hasta el ancho de la columna
   * lo dejaría borroso y le daría una importancia visual que no tiene. Se
   * enseña como lo que es, un apunte.
   */
  .muestra-aux-imagen {
    display: block;
    max-width: min(100%, 34rem);
    height: auto;
    border: 1px solid var(--line);
    border-radius: var(--radius-m);
  }

  .muestra-aux-pie {
    display: grid;
    gap: 0.2rem;
    font-size: 0.8125rem;
    line-height: 1.55;
  }

  .muestra-aux-texto {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--ink-strong);
  }

  .muestra-aux-alcance {
    color: var(--ink-muted);
  }

  .muestra-aux-recorte {
    color: var(--ink-muted);
    font-size: 0.75rem;
  }

  .muestra-alcance {
    margin: 0;
    font-size: 0.8125rem;
    line-height: 1.55;
    color: var(--ink-subtle);
  }

  .muestra-choque {
    padding: var(--space-2xs) var(--space-xs);
    border: 1px solid var(--warn-line);
    border-radius: var(--radius-m);
    background: var(--warn-soft);
    color: var(--warn);
    font-size: 0.875rem;
  }

  .muestra-choque-titulo {
    margin: 0 0 0.2rem;
    font-weight: 650;
  }

  .muestra-choque ul {
    margin: 0;
    padding-inline-start: 1.1em;
  }

  .muestra-notas {
    margin: 0;
    font-size: 0.875rem;
    color: var(--ink-muted);
  }
</style>
