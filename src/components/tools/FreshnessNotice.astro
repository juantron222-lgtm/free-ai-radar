---
import type { Tool } from '@lib/domain/tool';
import { STALE_AFTER_DAYS } from '@lib/domain/scoring';

interface Props {
  tool: Tool;
}
const { tool } = Astro.props;
---

{/*
  Honesty about our own data. A free tier verified eight months ago is not a
  fact any more, and saying so is worth more than pretending otherwise.
*/}
{tool.freshness !== 'fresh' && (
  <div class={`freshness freshness-${tool.freshness}`} role="note">
    <svg width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true">
      <circle cx="10" cy="10" r="7.5" stroke="currentColor" stroke-width="1.6" />
      <path d="M10 6v4.4l2.6 1.6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
    </svg>
    <p>
      <strong>
        {tool.freshness === 'very_stale'
          ? 'Esta ficha lleva mucho tiempo sin revisarse.'
          : 'Esta ficha necesita una revisión.'}
      </strong>
      {' '}
      Hace {tool.daysSinceVerified} días que no comprobamos el plan gratuito de {tool.name}, y
      nuestro umbral son {STALE_AFTER_DAYS}. Trata los límites de abajo como orientativos y
      confírmalos en la web oficial antes de decidir.
      <a href="#reportar">¿Sabes que algo ha cambiado? Dínoslo.</a>
    </p>
  </div>
)}

<style>
  .freshness {
    display: flex;
    gap: var(--space-2xs);
    align-items: start;
    padding: var(--space-xs) var(--space-s);
    margin-block-start: var(--space-s);
    border-radius: var(--radius-m);
    border: 1px solid var(--warn-line);
    background: var(--warn-soft);
    color: var(--warn);
  }

  .freshness svg {
    flex-shrink: 0;
    margin-block-start: 0.15rem;
  }

  .freshness p {
    margin: 0;
    font-size: 0.875rem;
    color: var(--ink);
  }

  .freshness strong {
    color: var(--warn);
  }

  .freshness a {
    color: var(--warn);
    font-weight: 600;
  }

  .freshness-very_stale {
    border-color: var(--alert-line);
    background: var(--alert-soft);
    color: var(--alert);
  }

  .freshness-very_stale strong,
  .freshness-very_stale a {
    color: var(--alert);
  }
</style>
