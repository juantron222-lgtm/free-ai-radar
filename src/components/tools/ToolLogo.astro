---
import type { Tool } from '@lib/domain/tool';
import registro from '@/data/logos.json';

interface Props {
  tool: Tool;
  size?: 'sm' | 'md' | 'lg';
  /**
   * Para lo que está sobre el pliegue.
   *
   * Las seis de la portada y el de la cabecera de una ficha se ven antes de
   * que nadie desplace nada: pedirlos con `loading="lazy"` los retrasa sin
   * ganar nada. El resto son decenas y sí deben esperar su turno.
   */
  priority?: boolean;
}

const { tool, size = 'md', priority = false } = Astro.props;

/**
 * Identidad visual mínima, y sin hotlinkear nada.
 *
 * El catálogo no tiene una sola imagen: noventa y cuatro tarjetas de texto
 * seguidas se leen como un volcado de base de datos, por bien escritas que
 * estén. Lo que falta antes que capturas o muestras generadas es lo más
 * barato: poder distinguir una marca de otra de un vistazo.
 *
 * Cómo se resuelve, y por qué así:
 *
 *   - Si la ficha declara `logo`, se sirve **desde nuestro propio dominio**
 *     (`/logos/…`). Nunca se enlaza el favicon de un tercero ni un servicio de
 *     iconos: eso rompería a la primera que alguien cambie su web, filtraría a
 *     nuestros lectores a un dominio ajeno y publicaría una imagen cuyos
 *     derechos no hemos comprobado.
 *
 *   - Si no la declara —hoy, ninguna— se dibuja un monograma con las iniciales
 *     y un color derivado del propio slug. No es el logo de nadie, así que no
 *     miente ni pide permiso a nadie, y sin embargo hace lo que hace falta:
 *     que dos tarjetas seguidas no se confundan.
 *
 * El color sale de una función determinista del slug, no de un aleatorio: la
 * misma herramienta tiene siempre el mismo tono, en esta página y en la
 * siguiente, que es lo que convierte el color en algo reconocible.
 */

/** Un tono estable por herramienta. Doce pasos, suficientes para distinguir. */
function tono(slug: string): number {
  let hash = 0;
  for (let i = 0; i < slug.length; i++) hash = (hash * 31 + slug.charCodeAt(i)) % 360;
  return Math.round(hash / 30) * 30;
}

/**
 * Una o dos letras, las que una persona usaría.
 *
 * «Bolt.new» da B, «GitHub Copilot» da GC, «v0 by Vercel» da V0. Se parte por
 * espacios y se ignoran las palabras de relleno, porque «by» no identifica a
 * nadie.
 */
function iniciales(name: string): string {
  const RELLENO = new Set(['by', 'de', 'the', 'ai', 'for']);
  const palabras = name
    .split(/[\s·|]+/)
    .map((p) => p.replace(/[^\p{L}\p{N}]/gu, ''))
    .filter((p) => p.length > 0 && !RELLENO.has(p.toLowerCase()));

  if (palabras.length === 0) return name.slice(0, 2).toUpperCase();
  if (palabras.length === 1) return palabras[0]!.slice(0, 2).toUpperCase();
  return (palabras[0]![0]! + palabras[1]![0]!).toUpperCase();
}

/**
 * De dónde sale el activo.
 *
 * `logos.json` es el registro del canal editorial: lo escribe
 * `scripts/logos.mjs` al descargar y guarda de dónde vino cada imagen, cuándo
 * y qué fondo necesita. La ficha no lo repite —`tool.logo` sigue existiendo
 * para una excepción escrita a mano— y si el registro no tiene entrada, o el
 * fichero se borra, aquí no hay logo y sale el monograma. Ninguna tarjeta se
 * rompe por eso.
 */
interface EntradaDeLogo {
  ruta: string;
  placa?: string;
}

const entrada = (registro as Record<string, EntradaDeLogo>)[tool.slug];
const logo = tool.logo ?? entrada?.ruta;

/*
 * La placa: el fondo sobre el que se apoya la marca, elegido midiéndola.
 *
 *   `ninguna`  trae su propio fondo, o su propia versión clara y oscura.
 *   `clara`    silueta oscura: necesita fondo claro en los dos temas.
 *   `oscura`   silueta clara: necesita fondo oscuro en los dos temas.
 *   `tema`     luminosidad intermedia: que mande la superficie de la página.
 *
 * Nunca se recolorea el activo ni se le inventa una versión que su dueño no
 * publica. Lo único que decidimos es sobre qué se apoya.
 */
const placa = entrada?.placa ?? 'tema';

const letras = iniciales(tool.name);
const h = tono(tool.slug);

/** El lado de la caja, en píxeles, para reservar sitio y no provocar saltos. */
const LADO = { sm: 28, md: 36, lg: 56 } as const;
const lado = LADO[size];
---

{logo ? (
  <img
    class={`tool-logo tool-logo-${size} tool-logo-real`}
    data-placa={placa}
    src={logo}
    alt=""
    width={lado}
    height={lado}
    loading={priority ? 'eager' : 'lazy'}
    fetchpriority={priority ? 'high' : 'auto'}
    decoding="async"
  />
) : (
  <span
    class={`tool-logo tool-logo-${size} tool-logo-mono`}
    style={`--logo-h: ${h}`}
    aria-hidden="true"
  >
    {letras}
  </span>
)}

<style>
  .tool-logo {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-m);
    border: 1px solid var(--line);
    background: var(--surface);
    object-fit: contain;
  }

  .tool-logo-md {
    width: 2.25rem;
    height: 2.25rem;
  }

  .tool-logo-sm {
    width: 1.75rem;
    height: 1.75rem;
  }

  .tool-logo-lg {
    width: 3.5rem;
    height: 3.5rem;
    border-radius: var(--radius-l);
  }

  /*
   * La marca dentro de su caja, sin deformarse.
   *
   * `contain` es lo que garantiza que un logo horizontal siga siendo
   * horizontal y uno cuadrado siga siendo cuadrado: la caja no cambia de
   * tamaño, y `width`/`height` van en el atributo, así que el hueco está
   * reservado antes de que la imagen llegue y no hay salto de maquetación.
   */
  .tool-logo-real {
    object-fit: contain;
    padding: 3px;
    overflow: hidden;
  }

  /* Trae su propio fondo: se recorta al radio y no se le pone nada detrás. */
  .tool-logo-real[data-placa='ninguna'] {
    padding: 0;
    background: transparent;
  }

  /* Silueta oscura: fondo claro en los dos temas, o desaparece en oscuro. */
  .tool-logo-real[data-placa='clara'] {
    background: #fbfbf9;
    border-color: rgb(0 0 0 / 0.12);
  }

  /* Silueta clara: fondo oscuro en los dos temas, o desaparece en claro. */
  .tool-logo-real[data-placa='oscura'] {
    background: #1b1b19;
    border-color: rgb(255 255 255 / 0.14);
  }

  /*
   * El monograma.
   *
   * Fondo muy claro y letra saturada del mismo tono: distingue sin gritar, y
   * el contraste no depende del tono porque la luminosidad está fijada. En
   * oscuro se invierte la relación en vez de bajar la opacidad, que es lo que
   * dejaría las iniciales por debajo del mínimo legible.
   */
  .tool-logo-mono {
    background: hsl(var(--logo-h) 62% 94%);
    border-color: hsl(var(--logo-h) 40% 82%);
    color: hsl(var(--logo-h) 65% 28%);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.01em;
    user-select: none;
  }

  .tool-logo-sm.tool-logo-mono {
    font-size: 0.6875rem;
  }

  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .tool-logo-mono {
      background: hsl(var(--logo-h) 40% 18%);
      border-color: hsl(var(--logo-h) 35% 30%);
      color: hsl(var(--logo-h) 70% 82%);
    }
  }

  :root[data-theme='dark'] .tool-logo-mono {
    background: hsl(var(--logo-h) 40% 18%);
    border-color: hsl(var(--logo-h) 35% 30%);
    color: hsl(var(--logo-h) 70% 82%);
  }
</style>
