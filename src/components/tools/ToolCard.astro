---
import type { Tool } from '@lib/domain/tool';
import AccessBadge from './AccessBadge.astro';
import ToolLogo from './ToolLogo.astro';
import FactChips from './FactChips.astro';
import CompareToggle from './CompareToggle.astro';
import { getCategory } from '@lib/domain/taxonomy';
import { ROUTES } from '@lib/nav';

interface Props {
  tool: Tool;
  /** `compact` drops the description — used in dense rails. */
  variant?: 'default' | 'compact';
  headingLevel?: 'h2' | 'h3';
  /** Sobre el pliegue: el logo se pide de inmediato, no en diferido. */
  priority?: boolean;
}

const { tool, variant = 'default', headingLevel: Heading = 'h3', priority = false } = Astro.props;
const category = getCategory(tool.categorySlug);
const href = ROUTES.tool(tool.slug);
---

<article
  class="card card-interactive tool-card"
  data-tool-card
  data-slug={tool.slug}
>
  <div class="tool-card-head">
    {/*
      La marca antes que el nombre.

      Es lo primero que separa una tarjeta de la siguiente cuando se recorre
      una rejilla de veinte: se reconoce un logo antes de terminar de leer un
      nombre. Va con `alt=""` porque el nombre está justo al lado y un lector
      de pantalla no tiene por qué oírlo dos veces.
    */}
    <ToolLogo tool={tool} priority={priority} />

    <div class="tool-card-titles">
      <Heading class="tool-card-name">
        {/* Stretched link: the whole card is clickable, one tab stop. */}
        <a href={href} class="tool-card-link">{tool.name}</a>
      </Heading>
      <p class="tool-card-meta">
        {category?.name}
        {tool.sponsorship.isSponsored && (
          <>
            <span aria-hidden="true"> · </span>
            <span class="chip chip-info tool-card-sponsored">Patrocinado</span>
          </>
        )}
      </p>
    </div>
    <AccessBadge tool={tool} size="md" />
  </div>

  {variant === 'default' && <p class="tool-card-tagline">{tool.tagline}</p>}

  <FactChips tool={tool} limit={4} />

  <div class="tool-card-foot">
    <span class="tool-card-verified" data-freshness={tool.freshness}>
      {tool.freshness === 'fresh' ? 'Verificada' : 'Sin revisar desde'}
      {' '}
      <time datetime={tool.lastVerifiedAt}>
        {new Date(`${tool.lastVerifiedAt}T00:00:00Z`).toLocaleDateString('es-ES', {
          day: 'numeric',
          month: 'short',
          year: 'numeric',
          timeZone: 'UTC',
        })}
      </time>
    </span>
    <CompareToggle slug={tool.slug} name={tool.name} />
  </div>
</article>

<style>
  .tool-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    padding: var(--space-s);
  }

  .tool-card-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-2xs);
  }

  /*
   * El nombre tiene suelo; la insignia, no.
   *
   * `min-width: 0` dejaba que esta columna se encogiese hasta desaparecer,
   * porque la insignia de acceso —que lleva el modelo, el límite y el
   * esfuerzo— reclama un ancho mínimo grande y no cedía nada. Medido: la
   * columna del nombre se quedaba en 23 px y «Lovable» salía en cuatro líneas
   * de dos letras, a 1280 px de ventana.
   *
   * El suelo son 8rem, que es lo que ocupa la palabra suelta más larga del
   * catálogo («AUTOMATIC1111)»). La que cede ahora es la insignia, que ya sabe
   * envolverse sola.
   */
  .tool-card-titles {
    flex: 1 1 auto;
    min-width: 8rem;
  }

  .tool-card-head > :last-child {
    min-width: 0;
  }

  .tool-card-name {
    font-size: 1.0625rem;
    font-weight: 650;
    margin: 0;
    /*
     * Partir sólo cuando no queda otra.
     *
     * Aquí ponía `anywhere`, que además de permitir el corte hace que la caja
     * pueda encogerse por debajo de su palabra más larga. Con la insignia de
     * acceso al lado, la columna del nombre se estrechaba hasta partir
     * cualquier cosa: «Lov / able», «Bolt. / new», «v0 by Verce / l» —y eso a
     * 1280 px, no en un móvil—.
     *
     * `break-word` conserva la protección que justificaba la regla: una
     * palabra que de verdad no cabe a 320 px se sigue partiendo antes que
     * desbordar. Lo que ya no hace es partir por comodidad del reparto.
     */
    overflow-wrap: break-word;
  }

  .tool-card-link {
    text-decoration: none;
    color: var(--ink-strong);
  }

  /* Card-wide hit area without nesting interactive elements. */
  .tool-card-link::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }

  .tool-card-link:hover {
    text-decoration: underline;
    text-decoration-color: var(--signal);
  }

  .tool-card-meta {
    margin: 0.1rem 0 0;
    font-size: 0.75rem;
    color: var(--ink-subtle);
  }

  .tool-card-sponsored {
    font-size: 0.65rem;
    padding-block: 0.05rem;
  }

  .tool-card-tagline {
    margin: 0;
    font-size: 0.875rem;
    color: var(--ink-muted);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .tool-card-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2xs);
    margin-block-start: auto;
    padding-block-start: var(--space-2xs);
    border-block-start: 1px solid var(--line-hairline);
    font-size: 0.75rem;
    color: var(--ink-subtle);
  }

  .tool-card-verified[data-freshness='stale'],
  .tool-card-verified[data-freshness='very_stale'] {
    color: var(--warn);
  }
</style>
