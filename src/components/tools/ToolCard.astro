---
import type { Tool } from '@lib/domain/tool';
import ToolLogo from './ToolLogo.astro';
import CompareToggle from './CompareToggle.astro';
import { getCategory } from '@lib/domain/taxonomy';
import { ROUTES, ubicacionDe } from '@lib/nav';
import { verificacionDe } from '@lib/domain/verification';
import { esfuerzoDe } from '@lib/domain/esfuerzo';
import { freeAccessLabel } from '@lib/data/category-page';
import { filaDe } from '@lib/data/portada';

interface Props {
  tool: Tool;
  /** `compact` drops the description — used in dense rails. */
  variant?: 'default' | 'compact';
  headingLevel?: 'h2' | 'h3';
  /** Sobre el pliegue: el logo se pide de inmediato, no en diferido. */
  priority?: boolean;
}

const { tool, variant = 'default', headingLevel: Heading = 'h3', priority = false } = Astro.props;
const category = getCategory(tool.categorySlug);
/* El mismo nombre que la ficha y que la navegación: «Audio › Voz». */
const ubicacion = category ? ubicacionDe(category.slug, category.name).texto : '';
const href = ROUTES.tool(tool.slug);
const verificacion = verificacionDe(tool);

/*
 * La misma lectura que la tabla de la portada, en formato tarjeta.
 *
 * La tarjeta llevaba dos sistemas de insignias que decían lo mismo: la de
 * acceso («Gratis real» en grande, con el esfuerzo debajo) y cuatro pastillas
 * que repetían «Gratis real» y añadían tarjeta y alojamiento con otro código de
 * color. En una rejilla de 94 eso es ruido, no información. Ahora hay una línea
 * de acceso y las tres condiciones que deciden, con las mismas palabras y los
 * mismos tonos que en la portada, porque salen de la misma función.
 */
const fila = filaDe(tool);
const tono = freeAccessLabel(tool).tone;
const CONDICIONES = [
  { etiqueta: 'Tarjeta', condicion: fila.tarjeta },
  { etiqueta: 'Registro', condicion: fila.registro },
  { etiqueta: 'Uso comercial', condicion: fila.comercial },
];

/* Instalar algo es lo único que el acceso y las tres condiciones no cuentan. */
const seInstala = tool.startEffort === 'install' || tool.startEffort === 'technical';
---

<article class="card card-interactive tool-card" data-tool-card data-slug={tool.slug}>
  <div class="tool-card-head">
    {/*
      La marca antes que el nombre.

      Es lo primero que separa una tarjeta de la siguiente cuando se recorre
      una rejilla de veinte: se reconoce un logo antes de terminar de leer un
      nombre. Va con `alt=""` porque el nombre está justo al lado y un lector
      de pantalla no tiene por qué oírlo dos veces.
    */}
    <ToolLogo tool={tool} priority={priority} />

    <div class="tool-card-titles">
      <Heading class="tool-card-name">
        {/* Stretched link: the whole card is clickable, one tab stop. */}
        <a href={href} class="tool-card-link">{tool.name}</a>
      </Heading>
      <p class="tool-card-meta">
        {ubicacion}
        {tool.sponsorship.isSponsored && (
          <>
            <span aria-hidden="true"> · </span>
            <span class="chip chip-info tool-card-sponsored">Patrocinado</span>
          </>
        )}
      </p>
    </div>
  </div>

  <p class="tool-card-acceso">
    <span class="tool-card-acceso-tipo" data-tono={tono}>{fila.tipoDeAcceso}</span>
    <span class="tool-card-acceso-cantidad">{fila.cantidad}</span>
  </p>

  {variant === 'default' && <p class="tool-card-tagline">{tool.tagline}</p>}

  <dl class="tool-card-condiciones">
    {CONDICIONES.map(({ etiqueta, condicion }) => (
      <div>
        <dt>{etiqueta}</dt>
        <dd class="cond" data-tono={condicion.tono}>{condicion.etiqueta}</dd>
      </div>
    ))}
  </dl>

  {seInstala && <p class="tool-card-esfuerzo">{esfuerzoDe(tool).label}</p>}

  <div class="tool-card-foot">
    {/*
      El estado y la fecha, cada uno con su nombre.

      Aquí ponía «Verificada» siempre que la ficha fuese reciente: medía cuándo
      se revisó y lo llamaba verificación. El estado sale de `verificacionDe()`,
      el mismo que usa la ficha, y la fecha dice sólo lo que es.
    */}
    <p class="tool-card-status">
      <span class="tool-card-state" data-state={verificacion.state}>{verificacion.label}</span>
      <span aria-hidden="true"> · </span>
      <span class="tool-card-verified" data-freshness={tool.freshness}>
        {tool.freshness === 'fresh' ? 'revisada el' : 'sin revisar desde el'}
        {' '}
        <time datetime={tool.lastVerifiedAt}>
          {new Date(`${tool.lastVerifiedAt}T00:00:00Z`).toLocaleDateString('es-ES', {
            day: 'numeric',
            month: 'short',
            year: 'numeric',
            timeZone: 'UTC',
          })}
        </time>
      </span>
    </p>
    <CompareToggle slug={tool.slug} name={tool.name} />
  </div>
</article>

<style>
  .tool-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    padding: var(--space-s);
  }

  .tool-card-head {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
  }

  /*
   * El nombre ya no comparte fila con la insignia de acceso.
   *
   * Con la insignia al lado, la columna del nombre se estrechaba hasta partir
   * cualquier cosa —«Lov / able» a 1280 px—. Ahora tiene la fila entera, pero
   * se conserva el suelo por si una marca vuelve a ponerse al lado.
   */
  .tool-card-titles {
    flex: 1 1 auto;
    min-width: 8rem;
  }

  .tool-card-name {
    font-size: 1.0625rem;
    font-weight: 650;
    margin: 0;
    overflow-wrap: break-word;
  }

  .tool-card-link {
    text-decoration: none;
    color: var(--ink-strong);
  }

  /* Card-wide hit area without nesting interactive elements. */
  .tool-card-link::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }

  .tool-card-link:hover {
    text-decoration: underline;
    text-decoration-color: var(--signal);
  }

  .tool-card-meta {
    margin: 0.1rem 0 0;
    font-size: 0.75rem;
    color: var(--ink-subtle);
  }

  .tool-card-sponsored {
    font-size: 0.65rem;
    padding-block: 0.05rem;
  }

  .tool-card-acceso {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.1rem 0.5rem;
    margin: 0;
    font-size: 0.875rem;
  }

  .tool-card-acceso-tipo {
    font-weight: 650;
    color: var(--ink-strong);
  }

  .tool-card-acceso-tipo[data-tono='good'] {
    color: var(--signal-strong);
  }

  .tool-card-acceso-tipo[data-tono='warn'] {
    color: var(--warn);
  }

  .tool-card-acceso-cantidad {
    color: var(--ink-muted);
  }

  .tool-card-tagline {
    margin: 0;
    font-size: 0.875rem;
    color: var(--ink-muted);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .tool-card-condiciones {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.5rem;
    margin: 0;
    padding-block: 0.55rem;
    border-block: 1px solid var(--line-hairline);
  }

  .tool-card-condiciones div {
    display: grid;
    gap: 0.1rem;
    min-width: 0;
  }

  .tool-card-condiciones dt {
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .tool-card-condiciones dd {
    margin: 0;
    font-size: 0.8125rem;
  }

  .tool-card-esfuerzo {
    margin: 0;
    font-size: 0.75rem;
    color: var(--ink-muted);
  }

  .tool-card-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2xs);
    margin-block-start: auto;
    font-size: 0.75rem;
    color: var(--ink-subtle);
  }

  .tool-card-status {
    margin: 0;
    min-width: 0;
  }

  .tool-card-state {
    font-weight: 650;
    color: var(--ink-muted);
  }

  .tool-card-state[data-state='verificada'] {
    color: var(--signal-strong);
  }

  .tool-card-state[data-state='retirada'] {
    color: var(--alert);
  }

  .tool-card-verified[data-freshness='stale'],
  .tool-card-verified[data-freshness='very_stale'] {
    color: var(--warn);
  }
</style>
