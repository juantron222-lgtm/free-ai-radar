---
import { SCORE_BAND_LABEL, scoreBand } from '@lib/domain/scoring';

interface Props {
  score: number;
  size?: 'sm' | 'md' | 'lg';
  showLabel?: boolean;
}

const { score, size = 'md', showLabel = false } = Astro.props;
const band = scoreBand(score);
const label = SCORE_BAND_LABEL[band];
---

{/* The band is carried by the label text, not only by colour. */}
<span class={`score score-${size}`} data-band={band}>
  <span class="score-value tnum">{score}</span>
  <span class="score-max" aria-hidden="true">/100</span>
  <span class="sr-only">sobre 100 — {label}</span>
  {showLabel && <span class="score-label" aria-hidden="true">{label}</span>}
</span>

<style>
  .score {
    display: inline-flex;
    align-items: baseline;
    gap: 0.1em;
    font-family: var(--font-display);
    font-variant-numeric: tabular-nums;
    font-weight: 700;
    line-height: 1;
    white-space: nowrap;
  }

  .score-value {
    letter-spacing: -0.03em;
  }

  .score-max {
    font-size: 0.62em;
    font-weight: 550;
    color: var(--ink-subtle);
  }

  .score-label {
    margin-inline-start: 0.5em;
    font-family: var(--font-text);
    font-size: 0.72em;
    font-weight: 600;
    letter-spacing: 0;
    align-self: center;
  }

  .score-sm {
    font-size: 1.0625rem;
  }
  .score-md {
    font-size: 1.5rem;
  }
  .score-lg {
    font-size: 2.75rem;
  }

  .score[data-band='excellent'] .score-value,
  .score[data-band='excellent'] .score-label {
    color: var(--signal);
  }
  .score[data-band='good'] .score-value,
  .score[data-band='good'] .score-label {
    color: var(--ink-strong);
  }
  .score[data-band='fair'] .score-value,
  .score[data-band='fair'] .score-label {
    color: var(--warn);
  }
  .score[data-band='poor'] .score-value,
  .score[data-band='poor'] .score-label {
    color: var(--alert);
  }
</style>
