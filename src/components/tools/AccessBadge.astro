---
import { getFreeModel, CREDIT_RESET_LABEL, START_EFFORT_LABEL } from '@lib/domain/taxonomy';
import type { Tool } from '@lib/domain/tool';

/**
 * What this tool costs you, in the words a reader can act on.
 *
 * Replaces the score badge, and the replacement is the point rather than a
 * redesign. A single number answered "which is better?", and that question has
 * no answer without knowing who is asking: AUTOMATIC1111 scored 89 and
 * Midjourney 65, which told a person who wants an image right now exactly
 * nothing — the 89 is a local Python install that needs a GPU.
 *
 * What survives is the fact underneath: what you get without paying, and how
 * much work it is to start. Two things a reader can compare honestly, instead
 * of one number that pretended to rank them.
 */

interface Props {
  tool: Pick<Tool, 'freeModel' | 'freePlan' | 'startEffort'>;
  size?: 'sm' | 'md' | 'lg';
}

const { tool, size = 'md' } = Astro.props;
const model = getFreeModel(tool.freeModel);

/*
 * The credits line only appears when the vendor published both the amount and
 * the frequency. Half of either is not a fact worth showing: "credits" with no
 * period is what let the old catalogue imply a daily allowance nobody promised.
 */
const reset = tool.freePlan.creditReset;
const amount = tool.freePlan.creditsAmount;

/*
 * Muchas cantidades ya llevan su periodo dentro — "150 Fast Tokens/día",
 * "10 imágenes cada 3 horas", "20/24h por herramienta" — y añadir la etiqueta
 * de renovación producía "100 unidades/día · diaria". Se repite sólo cuando la
 * cantidad no dice ya cada cuánto.
 */
const SAYS_PERIOD = /\/\s*(día|dia|d|semana|mes|h|24h|hora)|cada\s|\bal\s(día|dia|mes)\b|semanal|mensual|diari/i;

const credits =
  amount && reset !== 'none' && reset !== 'unknown'
    ? SAYS_PERIOD.test(amount)
      ? amount
      : `${amount} · ${CREDIT_RESET_LABEL[reset].toLowerCase()}`
    : null;

/*
 * How much stands between opening the page and getting a result.
 *
 * Reads `startEffort`, which describes the tool. It used to read `skillLevel`,
 * which describes the reader — and that is how a Python application needing a
 * GPU and a web page where you type and generate both ended up labelled
 * "beginner", side by side, as if they were the same errand.
 */
const effort = START_EFFORT_LABEL[tool.startEffort];
---

<span class={`access access-${size}`} data-tone={model.tone}>
  <span class="access-model">{model.label}</span>
  {credits && <span class="access-credits tnum">{credits}</span>}
  <span class="access-effort">{effort}</span>
  <span class="sr-only">{model.meaning}</span>
</span>

<style>
  .access {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35rem 0.5rem;
    font-family: var(--font-display);
    line-height: 1.25;
  }

  /*
   * Colores del sistema, no inventados aquí.
   *
   * Esta hoja pedía `--surface-2`, `--surface-3`, `--text-2`, `--text-3` y seis
   * variantes de `--tone-*`. **Ninguna existe** en `global.css`, así que todas
   * caían siempre al valor de reserva escrito al lado — valores fijos, ajenos a
   * la paleta y ciegos al tema.
   *
   * Con el tema oscuro eso dejaba la línea de esfuerzo en `rgb(0 0 0 / 0.6)`
   * sobre una superficie casi negra: **1,11:1**, texto invisible en ciento doce
   * de las vistas medidas. Un `var()` con reserva no avisa de que la variable no
   * existe; simplemente se ve mal y nadie sabe por qué.
   *
   * Los tokens de abajo sí existen y ya se redefinen en el bloque oscuro de
   * `global.css`, así que el bloque `@media` que había aquí sobra.
   */
  .access-model {
    font-weight: 700;
    padding: 0.15em 0.5em;
    border-radius: var(--radius-s);
    background: var(--neutral-soft);
    color: var(--ink);
  }

  /* El tono acompaña; nunca informa solo: la etiqueta ya lo dice con palabras. */
  .access[data-tone='good'] .access-model {
    background: var(--signal-soft);
    color: var(--signal-strong);
  }
  .access[data-tone='warn'] .access-model {
    background: var(--warn-soft);
    color: var(--warn);
  }
  .access[data-tone='bad'] .access-model {
    background: var(--alert-soft);
    color: var(--alert);
  }
  .access[data-tone='neutral'] .access-model {
    background: var(--neutral-soft);
    color: var(--ink);
  }

  .access-credits {
    font-variant-numeric: tabular-nums;
    font-weight: 600;
  }

  .access-effort {
    color: var(--ink-muted);
    font-size: 0.875em;
  }

  .access-sm {
    font-size: 0.8125rem;
  }
  .access-lg {
    font-size: 1.0625rem;
  }
</style>
